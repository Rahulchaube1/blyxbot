fn capital_answer() -> str {
    if !has_word("capital") && !has_word("capitals") { return ""; }
    let mut best = 0;
    let mut pos = 0;
    while pos < word_count() {
        let key = country_at(pos);
        if key > 0 && (best == 0 || key < best) { best = key; }
        pos += 1;
    }
    capital_for_key(best)
}
