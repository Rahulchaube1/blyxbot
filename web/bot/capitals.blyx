fn capital_for_key(key: i64) -> str {
    // afghanistan
    if key == 50 {
        return "Kabul.";
    }
    // alabama
    if key == 183 {
        return "Montgomery.";
    }
    // alaska
    if key == 223 {
        return "Juneau, not Anchorage.";
    }
    // albania
    if key == 146 {
        return "Tirana.";
    }
    // algeria
    if key == 147 {
        return "Algiers.";
    }
    // american samoa
    if key == 23 {
        return "Pago Pago, on Tutuila - a US territory of its own, not Samoa, whose capital is Apia.";
    }
