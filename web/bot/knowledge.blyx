              || has_word("kitten") || has_word("kittens") || has_word("dog")
              || has_word("dogs") || has_word("puppy") || has_word("puppies") || has_word("pet")
              || has_word("pets") || has_word("eat") || has_word("ate") || has_word("eats")
              || has_word("eating") || has_word("eaten") || has_word("poison")
              || has_word("poisoned") || has_word("toxic") || has_word("flower")
              || has_word("flowers")) {
        say_rule("houseplant-yellow-leaves", "Overwatering is the usual cause: yellow, soft leaves on a plant in soggy compost means stop watering and let the top inch of soil dry out, and check the pot has holes. Yellow lower leaves that are dry and crisp are the other story — that is just age, or a plant that needs feeding.");
        return true;
    }

    // garden.py: plant-pothos
    if (has_word("pothos") || has_pair("devils", "ivy"))
        && (has_word("water") || has_word("watering") || has_word("care")
              || has_pair("look", "after") || has_word("light") || has_pair("keep", "alive")
              || has_word("drooping") || has_word("repot"))
        && !(has_word("light") || has_word("sun") || has_word("sunlight")
              || has_word("sunny") || has_word("sunshine") || has_word("shade")
              || has_word("shady") || has_word("bright") || has_word("dark")
              || has_word("window") || has_word("windowsill") || has_pair("south", "facing")
              || has_pair("north", "facing") || has_pair("east", "facing")
              || has_pair("west", "facing") || has_word("cat") || has_word("cats")
              || has_word("kitten") || has_word("kittens") || has_word("dog")
              || has_word("dogs") || has_word("puppy") || has_word("puppies") || has_word("pet")
              || has_word("pets") || has_word("eat") || has_word("ate") || has_word("eats")
              || has_word("eating") || has_word("eaten") || has_word("poison")
              || has_word("poisoned") || has_word("toxic")) {
        say_rule("plant-pothos", "Water a pothos about once a week, when the compost is dry and the leaves are just starting to look limp: it forgives a missed week but rots in a pot that never dries. It grows in almost any light, and a cutting in a glass of water roots in a few weeks.");
        return true;
    }

    // garden.py: plant-snake-plant
    if (has_pair("snake", "plant") || has_pair("snake", "plants")
              || has_word("sansevieria"))
        && (has_word("water") || has_word("watering") || has_word("care")
              || has_pair("look", "after") || has_word("light") || has_pair("keep", "alive")
              || has_word("drooping") || has_word("repot"))
