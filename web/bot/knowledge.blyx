              || has_pair("christmas", "cactus") || has_pair("christmas", "cacti")
              || has_word("outdoors")) {
        say_rule("cactus-care", "Cacti and succulents want a sunny windowsill, gritty compost and far less water than they get: soak the pot, let it dry right through, and that is every two to three weeks in summer and barely at all from November to March. A Christmas cactus is the exception - it is a forest cactus - so give it bright light out of full sun, water when the top half of the pot is dry, and cool nights in autumn, which is what sets the buds.");
        return true;
    }

    // garden.py: houseplant-light
    if (has_word("houseplant") || has_word("houseplants") || has_pair("house", "plant")
              || has_pair("house", "plants") || has_pair("indoor", "plant")
