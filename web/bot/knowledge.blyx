              || has_word("pests") || has_word("bug") || has_word("bugs") || has_word("insect")
              || has_word("insects") || has_pair("eating", "my") || has_pair("eats", "my")
              || has_pair("ate", "my") || has_pair("rid", "of") || has_word("stop")
              || has_word("killed") || has_word("kill") || has_word("dying") || has_word("dead")
              || has_word("droop") || has_word("drooping") || has_word("wilt")
              || has_word("wilted") || has_pair("yellow", "leaves") || has_word("repot")
              || has_word("fertiliser") || has_word("fertilizer") || has_pair("feed", "my")
              || has_word("prune") || has_word("lawn") || has_word("weed") || has_word("weeds")
              || has_pair("look", "after") || has_pair("care", "for") || has_pair("water", "my")
              || has_pair("water", "them") || has_pair("water", "it")
              || has_pair("how", "often") || everyday_phrase3("how", "much", "water")
              || everyday_phrase3("once", "a", "week") || has_word("shade") || has_word("frost")
              || has_pair("tomato", "plant") || has_pair("my", "leaves")
              || has_pair("leaves", "yellow") || everyday_phrase3("leaves", "are", "yellow")
              || has_word("houseplant") || has_word("houseplants") || has_pair("plant", "food")
              || has_word("gardening")) {
        say_rule("plants-make-food", "Plants make their own food by photosynthesis: they take carbon dioxide from the air and water from the soil and use sunlight to turn them into sugar. The green chlorophyll in their leaves captures the light, and oxygen is released as a by-product.");
        return true;
    }

    // science.py: green-plants
    if (has_word("plant") || has_word("plants") || has_word("grass")
              || has_word("leaves"))
        && has_word("green")
        && (has_word("why") || has_pair("how", "come") || has_pair("what", "makes"))
        && (has_word("green") || has_word("colour") || has_word("color"))
        && !(has_word("cat") || has_word("cats") || has_word("dog") || has_word("dogs")
              || has_word("puppy") || has_word("pet") || has_word("pets") || has_word("cow")
              || has_word("cows") || has_word("rabbit") || has_word("rabbits")
