              || has_word("caterpillar") || has_word("caterpillars") || has_word("pest")
              || has_word("pests") || has_word("bug") || has_word("bugs") || has_word("insect")
              || has_word("insects") || has_word("dying") || has_word("dead")
              || has_word("droop") || has_word("drooping") || has_word("wilt")
              || has_word("wilted") || has_word("repot") || has_word("fertiliser")
              || has_word("fertilizer") || has_word("prune") || has_word("lawn")
              || has_word("weed") || has_word("weeds") || has_pair("look", "after")
              || has_pair("care", "for") || has_pair("water", "my") || has_pair("how", "often")
              || has_word("houseplant") || has_word("houseplants") || has_word("autumn")
              || has_word("fall") || has_word("winter") || has_word("drop")
              || has_word("dropping") || has_word("fallen") || has_word("bulb")
              || has_word("bulbs") || has_word("sow") || has_word("sowing")
              || has_pair("plant", "out") || everyday_phrase3("when", "to", "plant")
              || everyday_phrase3("in", "the", "green")
              || everyday_phrase3("plant", "a", "green")
              || everyday_phrase4("when", "do", "i", "plant")
              || everyday_phrase4("when", "should", "i", "plant")
              || everyday_phrase4("how", "do", "i", "plant")
              || everyday_phrase4("where", "do", "i", "plant") || has_pair("green", "manure")
              || has_pair("green", "roof") || has_pair("green", "wall")
              || has_pair("green", "beans") || has_pair("green", "fingers")
              || everyday_phrase3("how", "do", "i") || everyday_phrase3("how", "can", "i")
