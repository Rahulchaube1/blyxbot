// Everyday knowledge ported from Hugging Face PyBot, commit 7d63c7f (Apache-2.0).
// Source cards in bot/knowledge/ are identified at each reply. Subject and intent
// are separate requirements; phrase alternatives match adjacent whole tokens.
// These rules select only the named topics. A failed match passes to the next module.

fn everyday_phrase3(first: str, second: str, third: str) -> bool {
    let mut pos = 0;
    while pos + 3 <= word_count() {
        if word(pos) == first && word(pos + 1) == second && word(pos + 2) == third { return true; }
        pos = pos + 1;
    }
    false
}

fn everyday_phrase4(first: str, second: str, third: str, fourth: str) -> bool {
    let mut pos = 0;
    while pos + 4 <= word_count() {
        if word(pos) == first && word(pos + 1) == second && word(pos + 2) == third
            && word(pos + 3) == fourth { return true; }
        pos = pos + 1;
    }
    false
}

fn everyday_phrase5(first: str, second: str, third: str, fourth: str, fifth: str) -> bool {
    let mut pos = 0;
    while pos + 5 <= word_count() {
        if word(pos) == first && word(pos + 1) == second && word(pos + 2) == third
            && word(pos + 3) == fourth && word(pos + 4) == fifth { return true; }
        pos = pos + 1;
    }
    false
}

// A duration follows the kettle only when these are the complete contents
// of the question. A new subject such as "How long does rice take?" starts
// its own topic even immediately after a descaling question.
fn kettle_followup() -> bool {
    if prior_topic() != "descale-kettle" || word_count() > 13 { return false; }
    let duration = has_pair("how", "long") || has_pair("many", "minutes");
    let interval = has_pair("how", "often");
    if !duration && !interval { return false; }
    let mut pos = 0;
    while pos < word_count() {
        let term = word(pos);
        if term != "and" && term != "so" && term != "then" && term != "for"
            && term != "how" && term != "long" && term != "many" && term != "minutes"
            && term != "often" && term != "does" && term != "do" && term != "did"
            && term != "will" && term != "should" && term != "must" && term != "can"
            && term != "i" && term != "we" && term != "it" && term != "that"
            && term != "this" && term != "the" && term != "take" && term != "wait"
            && term != "leave" && term != "sit" && term != "soak" && term != "repeat"
            && term != "again" && term != "please" {
            return false;
        }
        pos = pos + 1;
    }
    if duration {
        say_rule("descale-kettle", "Half an hour.");
    } else {
        say_rule("descale-kettle", "In a hard-water area, every couple of months.");
    }
    true
}

// An explanation needs a question or a request to explain. Mentions in a
// poem, a piece of fiction, or a request for a translation are other tasks.
fn everyday_explanation() -> bool {
    if has_word("poem") || has_word("song") || has_word("lyrics")
        || has_word("translate") || has_word("fiction") || has_word("riddle")
        || has_word("metaphor") || has_pair("write", "about") {
        return false;
    }
    return has_word("why") || has_word("how") || has_word("what") || has_word("whats")
        || has_word("which") || has_word("where") || has_word("when")
        || has_word("explain") || has_word("define") || has_word("describe")
        || has_pair("tell", "me") || word(0) == "is" || word(0) == "are"
        || word(0) == "does" || word(0) == "do";
}

fn everyday_sky_and_science() -> bool {
    // science.py: sky-blue
    if has_word("sky")
        && (has_word("blue") || has_word("color") || has_word("colour")
              || has_word("rayleigh"))
        && !(has_word("night") || has_word("dark") || has_word("black")
              || has_word("sunset") || has_word("sunrise") || has_word("rainbow")
              || has_word("scarf") || has_word("shirt") || has_word("dress")
              || has_word("paint") || has_word("wall") || has_word("flag") || has_word("logo")
              || has_word("picture") || has_word("storm") || has_word("stormy")
              || has_word("overcast") || has_word("grey") || has_word("gray")
              || has_word("green") || has_word("purple")) {
        say_rule("sky-blue", "Sunlight contains every colour, and air scatters the short blue wavelengths far more than the long red ones, so blue light reaches your eyes from all over the sky. That is also why the sky reddens at sunset: the light crosses more air, the blue is scattered away, and the reds come through.");
        return true;
    }

    // science.py: sky-green
    if has_word("sky")
        && has_word("green")
        && (has_word("why") || has_word("not") || has_word("never") || has_word("isnt")
              || has_word("isn't"))
        && (has_word("why") || has_word("what") || has_word("colour") || has_word("color")
              || has_word("not") || has_word("green") || has_word("isnt") || has_word("isn't"))
        && !(has_word("blue") || has_word("tornado") || has_word("storm")
              || has_word("stormy") || has_word("thunderstorm")
              || has_pair("northern", "lights") || has_word("aurora")) {
        say_rule("sky-green", "Blue is scattered much more strongly than green, so the green that is scattered arrives mixed with far more blue and the sky reads as pale blue. Violet is scattered even more, but there is less of it in sunlight and our eyes are less sensitive to it, so it never dominates.");
        return true;
    }

    // science.py: sky-dark
    if has_word("sky")
        && (has_word("dark") || has_word("black") || has_word("darkness"))
        && (has_word("night") || has_word("nighttime") || has_pair("at", "midnight"))
        && !(has_word("blue") || has_word("storm") || has_word("stormy")
              || has_word("forecast") || has_word("clouds") || has_word("cloudy")
              || has_word("space") || has_word("eclipse") || has_word("tonight")) {
        say_rule("sky-dark", "Night is simply the side of the Earth turned away from the Sun: with no sunlight to scatter, the sky is dark. The stars are there all day too, but the bright blue scattered light drowns them out.");
        return true;
    }

    // science.py: sunset-red
    if (has_word("sunset") || has_word("sunsets") || has_word("sunrise")
              || has_word("sunrises") || has_word("dusk") || has_word("dawn") || has_word("sun"))
        && (has_word("red") || has_word("orange") || has_word("pink") || has_word("colour")
              || has_word("color") || has_word("yellow"))
        && !(has_word("hot") || has_word("heat") || has_word("burn") || has_word("burning")
              || has_word("sunburn") || has_pair("sun", "cream") || has_word("sunscreen")
              || has_word("screen") || has_word("exposure") || has_word("vitamin")
              || has_word("lamp") || has_word("bed") || has_word("photo") || has_word("picture")
              || has_word("paint") || has_word("painting") || has_word("tonight")
              || has_word("today") || has_word("tomorrow") || has_word("flag")) {
        say_rule("sunset-red", "Sunlight is white, but the air scatters the blue end of it away, so the Sun looks yellow and, low down, orange or red. At sunset the light crosses much more air, which takes out the blue and lets the reds through; dust and cloud deepen it.");
        return true;
    }

    // science.py: sunrise-east
    if (has_word("sun") || has_word("sunrise") || has_word("sunset"))
        && (has_word("east") || has_word("west") || has_word("direction"))
        && !(has_word("red") || has_word("orange") || has_word("pink") || has_word("colour")
              || has_word("color") || has_word("glow") || has_word("alarm") || has_word("lamp")
              || has_pair("light", "therapy") || everyday_phrase3("wake", "up", "light")
              || has_pair("wake-up", "light") || has_pair("what", "time")
              || has_pair("when", "does") || has_pair("when", "is") || has_pair("time", "does")) {
        say_rule("sunrise-east", "The Sun does not move round the Earth: the Earth spins from west to east, so the Sun appears to come up in the east, cross the sky and set in the west. The ground is turning under you at about 1,000 mph at the equator.");
        return true;
    }

    // science.py: sun-distance
    if has_word("sun")
        && (has_word("distance") || has_pair("how", "far") || has_pair("far", "away")
              || has_pair("light", "travel") || has_pair("sunlight", "travel")
              || has_pair("sunlight", "reach"))
        && !(has_word("mars") || has_word("jupiter") || has_word("venus")
              || has_word("mercury") || has_word("neptune") || has_word("saturn")
              || has_word("uranus") || has_word("pluto") || has_word("moon")) {
        say_rule("sun-distance", "The Sun is about 150 million km (93 million miles) away, and sunlight takes 8 minutes 20 seconds to reach us. That is why you never see the Sun as it is now, only as it was eight minutes ago.");
        return true;
    }

    // science.py: light-year
    if (has_pair("light", "year") || has_pair("light", "years")
              || has_word("light-year") || has_word("light-years") || has_word("lightyear")
              || has_word("lightyears"))
        && (has_word("what") || has_pair("how", "far") || has_word("distance")
              || has_word("meaning") || has_word("mean") || has_word("measures")
              || has_word("measure") || has_word("explain") || has_pair("how", "long"))
        && (has_word("what") || has_word("distance") || has_word("long") || has_word("far")
              || has_word("mean") || has_word("explain") || has_word("measure")
              || has_word("many"))
        && !(has_pair("how", "fast") || has_word("speed") || has_pair("travel", "at")
              || has_word("wavelength") || has_pair("per", "second") || has_pair("last", "year")
              || has_pair("this", "year") || has_pair("next", "year") || has_pair("new", "year")
              || has_word("buzz") || has_pair("year", "old")) {
        say_rule("light-year", "A light year is a distance, not a time: it is how far light travels in a year, about 9.46 trillion kilometres (5.88 trillion miles). Proxima Centauri, the nearest star after the Sun, is about 4.2 light years away, and the Milky Way is about 100,000 light years across.");
        return true;
    }

    // science.py: moon-horizon
    if has_word("moon")
        && (has_word("horizon") || everyday_phrase4("low", "in", "the", "sky")
              || everyday_phrase5("low", "in", "the", "night", "sky"))
        && (has_word("big") || has_word("bigger") || has_word("large")
              || has_word("larger") || has_word("huge") || has_word("size")
              || has_word("illusion"))
        && (has_word("why") || has_word("look") || has_word("looks") || has_word("seems")
              || has_word("appear") || has_word("appears"))
        && !(has_word("photo") || has_word("camera") || has_word("lens")) {
        say_rule("moon-horizon", "The Moon looks bigger near the horizon because of an illusion in how your brain judges it against the landscape; photograph it and it comes out the same size as when it is high overhead. It also looks dimmer down there, not brighter, because its light is crossing more air.");
        return true;
    }

    // science.py: moon-size
    if has_word("moon")
        && (has_word("size") || has_word("diameter") || has_pair("how", "big")
              || has_pair("how", "large") || has_pair("how", "wide")
              || everyday_phrase3("how", "far", "across"))
        && !(has_word("photo") || has_word("photos") || has_word("photograph")
              || has_word("picture") || has_word("pictures") || has_word("camera")
              || has_word("phone") || has_word("shoot") || has_word("capture")
              || has_word("zoom") || has_word("lens") || has_word("telescope")
              || has_word("horizon") || has_word("biggest") || has_word("jupiter")
              || has_word("saturn") || has_word("mars") || has_word("venus") || has_word("sun")
              || has_word("cheese")) {
        say_rule("moon-size", "The Moon is about 3,475 km across, a little over a quarter of the Earth's width, and you could fit about 50 Moons inside the Earth. It looks small only because it is about 384,000 km away.");
        return true;
    }

    // science.py: space-dark
    if has_word("space")
        && (has_word("black") || has_word("dark"))
        && (has_word("why") || has_pair("how", "come"))
        && !(has_word("storage") || has_word("disk") || has_word("closet")
              || has_word("negative") || has_word("screen") || has_word("background")
              || has_word("parking") || everyday_phrase3("deep", "space", "nine")) {
        say_rule("space-dark", "Space looks black because there is almost nothing there to scatter light into your eyes; light only reaches you if it comes straight from a star or a lit object. The sky is bright blue from Earth because our air scatters sunlight everywhere.");
        return true;
    }

    // science.py: star-twinkle
    if (has_word("star") || has_word("stars"))
        && (has_word("twinkle") || has_word("twinkling") || has_word("twinkles")
              || has_word("shimmer") || has_word("flicker") || has_word("flickering")
              || has_word("steady"))
        && (has_word("twinkle") || has_word("twinkling") || has_word("shimmer")
              || has_word("flicker") || has_word("steady"))
        && !(has_word("song") || has_word("lyrics") || has_word("rhyme")
              || has_word("celebrity") || has_word("starfish")) {
        say_rule("star-twinkle", "Stars twinkle because their light passes through moving layers of air, which bend it slightly this way and that before it reaches your eyes. Planets look steadier because they are close enough to show a tiny disc rather than a single point of light.");
        return true;
    }

    // science.py: stars-night
    if (has_word("star") || has_word("stars"))
        && (has_word("day") || has_word("daytime") || has_word("night"))
        && (has_word("see") || has_word("seen") || has_word("seeing")
              || has_word("visible") || has_word("visibility") || has_word("disappear")
              || has_word("appear") || everyday_phrase3("only", "at", "night"))
        && (has_word("why") || has_word("only") || has_word("see") || has_word("visible")
              || has_word("what"))
        && !(has_word("hotel") || has_word("celebrity") || has_word("song")
              || has_word("shooting") || has_word("meteor") || has_word("tonight")
              || has_word("forecast") || has_word("sports") || has_word("team")
              || has_word("match") || has_word("game") || has_word("won") || has_word("win")
              || has_word("lose") || has_word("lost")) {
        say_rule("stars-night", "The stars are there in the daytime too: the sun lights up the air above you so brightly that their faint light is drowned out. Away from city lights, and out of the sun's glare, thousands more of them come into view.");
        return true;
    }

    // science.py: north-star
    if (has_pair("north", "star") || has_word("polaris") || has_pair("pole", "star"))
        && (has_word("what") || has_word("where") || has_word("which") || has_word("find")
              || has_word("brightest") || has_word("identify"))
        && (has_word("what") || has_word("which") || has_word("find")
              || has_word("brightest") || has_word("where") || has_word("how"))
        && !(has_word("photo") || has_word("photograph") || has_word("picture")
              || has_word("camera") || has_word("shoot") || has_word("capture")
              || has_word("exposure") || has_word("lens") || has_word("telescope")
              || has_word("trail") || has_pair("night", "sky") || has_pair("north", "pole")
              || has_word("hotel") || has_word("brand") || has_word("bus") || has_word("song")) {
        say_rule("north-star", "Polaris sits almost exactly above the Earth's north pole, so the rest of the sky turns around it while it stays put. Find it from the two stars at the end of the Big Dipper's bowl: follow the line through them about five times their gap. It is not the brightest star in the sky, just the one that marks north.");
        return true;
    }

    // science.py: gravity-space
    if (has_word("astronaut") || has_word("astronauts") || has_pair("space", "station")
              || has_word("iss") || has_word("gravity"))
        && (has_word("space") || has_word("orbit") || has_word("orbital")
              || has_word("iss"))
        && (has_word("float") || has_word("floating") || has_word("weightless")
              || has_word("weightlessness") || has_pair("zero", "gravity")
              || has_pair("no", "gravity"))
        && (has_word("why") || has_word("how") || has_word("what") || has_word("float")
              || has_word("floating") || has_word("weightless") || has_word("space"))
        && !(has_pair("black", "hole") || has_pair("the", "moon") || has_word("mars")
              || has_word("planet") || has_word("movie") || has_word("film")) {
        say_rule("gravity-space", "There is gravity in space: astronauts on the space station float because they and the station are falling around the Earth together at the same speed, not because gravity has gone. At that height gravity is still about 90% as strong as it is on the ground.");
        return true;
    }

    // science.py: earth-spin
    if has_word("earth")
        && (has_word("spin") || has_word("spins") || has_word("spinning")
              || has_word("rotate") || has_word("rotates") || has_word("rotation"))
        && (has_word("why") || has_pair("what", "makes") || has_pair("how", "come"))
        && (has_word("why") || has_word("does") || has_word("what") || has_word("how"))
        && !(has_word("speed") || has_word("fast") || has_word("quickly")
              || has_word("long") || has_word("stop") || has_word("stopped")
              || has_word("direction") || has_pair("axis", "tilt")) {
        say_rule("earth-spin", "The Earth spins because the cloud of dust and gas it formed from was already turning, and nothing has braked it much in 4.5 billion years. The Moon's tides are slowly slowing it, so the day grows about a second longer every 50,000 years or so.");
        return true;
    }

    // science.py: summer-hot
    if (has_word("summer") || has_word("summers"))
        && (has_word("hotter") || has_word("hot") || has_word("warmer") || has_word("warm"))
        && (has_word("why") || has_pair("how", "come"))
        && (has_word("why") || has_word("than") || has_word("winter") || has_word("more")
              || has_word("cause"))
        && !(has_word("boiler") || has_word("radiator") || has_word("radiators")
              || has_word("thermostat") || has_word("heating") || has_pair("hot", "water")
              || has_word("plumber") || has_word("kettle") || has_word("flask")
              || has_word("forecast") || has_word("tomorrow") || has_word("today")
              || has_pair("this", "week") || has_pair("this", "year")
              || has_pair("this", "summer")) {
        say_rule("summer-hot", "Summer is hotter because the Sun is higher in the sky and stays up longer, so the same patch of ground gets more direct sunlight and more hours of it. The Earth is actually farthest from the Sun in July, which is why distance is not the explanation.");
        return true;
    }

    // science.py: popcorn-pop
    if (has_word("popcorn") || has_pair("popping", "corn")
              || has_pair("corn", "kernels"))
        && (has_word("pop") || has_word("pops") || has_word("popping")
              || has_word("explode") || has_word("explodes") || has_word("burst")
              || has_word("bursts"))
        && (has_word("why") || has_word("how") || has_pair("what", "makes"))
        && !(has_pair("microwave", "time") || has_pair("how", "long")
              || has_pair("how", "much") || has_pair("how", "many")
              || everyday_phrase3("how", "to", "cook") || everyday_phrase3("how", "to", "make")
              || everyday_phrase4("how", "do", "i", "make") || has_pair("popcorn", "maker")) {
        say_rule("popcorn-pop", "Each kernel holds a little water inside a hard shell. Heat turns that water to steam, the pressure builds until the shell splits, and the starch inside puffs out and sets: the pop is the shell giving way, and a kernel that is too dry or has a cracked shell will not pop.");
        return true;
    }

    // science.py: ice-floats
    if (has_word("ice") || has_word("iceberg") || has_word("icebergs"))
        && (has_word("float") || has_word("floats") || has_word("floating")
              || has_word("density") || has_pair("less", "dense"))
        && (has_word("why") || has_word("how") || has_word("what"))
        && !(has_word("dry") || everyday_phrase3("hot", "water", "bottle")
              || everyday_phrase3("heat", "or", "ice") || everyday_phrase3("ice", "or", "heat")
              || everyday_phrase3("better", "than", "ice") || has_pair("ice", "pack")
              || has_word("compress") || has_word("sprain") || has_word("sprained")
              || has_word("swelling") || has_word("swollen") || has_word("muscle")
              || has_word("sore") || has_word("ache") || has_word("aching")
              || has_pair("ice", "cream") || has_word("skating")) {
        say_rule("ice-floats", "Water is unusual: it expands as it freezes, so ice is about 9% less dense than liquid water and floats. That is also why a full bottle left in the freezer can split.");
        return true;
    }

    // science.py: ocean-blue
    if (has_word("ocean") || has_word("oceans") || has_word("sea") || has_word("seas"))
        && (has_word("blue") || has_word("colour") || has_word("color"))
        && (has_word("why") || has_word("what") || has_word("how"))
        && !(has_word("salty") || has_word("salt") || has_word("saltier")
              || has_word("sunset") || has_word("sunrise") || has_word("green")
              || has_pair("red", "sea") || has_pair("black", "sea") || has_word("paint")
              || has_word("flag") || has_word("shirt")) {
        say_rule("ocean-blue", "Water absorbs red light much more strongly than blue, so the deeper the water the more the reds disappear and the blue is left. The sky's reflection adds to it, but the colour is mostly the water itself.");
        return true;
    }

    // science.py: sea-salty
    if (has_word("sea") || has_word("seas") || has_word("ocean") || has_word("oceans"))
        && (has_word("salty") || has_word("salt") || has_word("saltiness"))
        && (has_word("why") || has_word("how") || has_pair("where", "from")
              || has_pair("where", "does"))
        && !(has_word("blue") || has_word("colour") || has_word("color")
              || everyday_phrase3("salt", "on", "roads") || has_pair("salt", "lamp")
              || has_pair("salt", "mine") || has_pair("how", "much") || has_pair("how", "many")) {
        say_rule("sea-salty", "Rain wears minerals out of rocks and carries them to the sea, and when the water evaporates the salt stays behind. Rivers keep adding a little, so the sea has become salty over hundreds of millions of years.");
        return true;
    }

    // science.py: rain
    if has_word("rain")
        && (has_word("form") || has_word("forms") || has_word("formed")
              || has_word("falls") || everyday_phrase4("how", "is", "rain", "made")
              || everyday_phrase4("how", "is", "rain", "produced")
              || everyday_phrase4("why", "does", "it", "rain")
              || everyday_phrase4("why", "does", "rain", "fall"))
        && !(has_word("bow") || has_word("bows") || has_word("coat") || has_word("jacket")
              || has_word("tomorrow") || has_word("forecast") || has_word("today")
              || has_word("tonight") || has_pair("next", "week") || has_word("umbrella")
              || has_pair("storm", "drain")) {
        say_rule("rain", "Water evaporates, rises and cools, and its vapour condenses into tiny droplets that make clouds. Those droplets collide and grow until they are too heavy to stay up, and then they fall as rain.");
        return true;
    }

    // science.py: thunder
    if has_word("thunder")
        && (has_pair("thunder", "sound") || has_pair("thunder", "sounds")
              || has_pair("after", "lightning") || has_pair("before", "lightning")
              || has_word("cause") || has_word("causes") || has_pair("makes", "thunder")
              || has_pair("produces", "thunder") || everyday_phrase3("what", "is", "thunder")
              || has_pair("come", "from") || has_pair("comes", "from")
              || everyday_phrase4("why", "do", "we", "hear"))
        && !(has_word("song") || has_word("film") || has_word("movie") || has_word("team")
              || has_word("sports")) {
        say_rule("thunder", "Lightning heats the air along its path to about 30,000°C in a split second, and the air expands violently, making a shock wave we hear as thunder. You see the flash first because light travels far faster than sound.");
        return true;
    }

    // science.py: sound-travel
    if has_word("sound")
        && (has_word("travel") || has_word("travels") || has_word("speed")
              || has_word("vacuum") || has_word("vibration") || has_word("faster"))
        && (has_word("how") || has_word("what") || has_word("why") || has_word("speed"))
        && (has_word("how") || has_word("why") || has_word("fast") || has_word("speed")
              || has_word("travel"))
        && !(has_word("bluetooth") || has_word("volume") || has_word("music")
              || has_word("speaker") || has_pair("sound", "card")
              || everyday_phrase3("sound", "travel", "agency")) {
        say_rule("sound-travel", "Sound is a vibration that travels as a wave through air, water or solids; in air it moves at about 343 metres per second. It travels faster in water and fastest in solids, and it cannot travel through a vacuum because there is nothing to vibrate.");
        return true;
    }

    // science.py: birds-migrate
    if (has_word("bird") || has_word("birds"))
        && (has_word("migrate") || has_word("migration") || has_pair("fly", "south")
              || has_pair("flying", "south") || has_pair("head", "south"))
        && (has_word("why") || has_word("winter") || has_pair("how", "come"))
        && (has_word("why") || has_word("south") || has_word("winter") || has_word("when")
              || has_word("do"))
        && !(has_word("home") || has_word("job") || has_word("city") || has_word("nest")
              || has_pair("leaving", "me") || has_word("app") || has_word("game")) {
        say_rule("birds-migrate", "Birds head off in autumn because the insects, worms and berries they live on run out as the days shorten; the trip costs a lot of energy but beats starving. They find their way by the sun, the stars, landmarks and the Earth's magnetic field, and many come back to the same nest site.");
        return true;
    }

    // science.py: photosynthesis
    if has_word("photosynthesis")
        && (has_word("what") || has_word("why") || has_word("how") || has_word("explain")
              || has_word("means") || has_word("define"))
        && !(has_word("equation") || has_pair("chemical", "formula")
              || has_word("experiment") || has_word("laboratory")
              || has_pair("reaction", "rate")) {
        say_rule("photosynthesis", "Plants use sunlight to turn carbon dioxide from the air and water from the soil into sugar, which is their food, and they release oxygen as a by-product. The green chlorophyll in their leaves captures the light that powers it.");
        return true;
    }

    // science.py: plants-make-food
    if (has_word("plants") || has_word("plant") || has_word("trees")
              || has_word("tree"))
        && (has_word("food") || has_word("energy"))
        && (has_word("make") || has_word("makes") || has_word("made") || has_word("get")
              || has_pair("own", "food"))
        && !(has_word("cat") || has_word("cats") || has_word("dog") || has_word("dogs")
              || has_word("puppy") || has_word("pet") || has_word("pets") || has_word("cow")
              || has_word("cows") || has_word("rabbit") || has_word("rabbits")
              || has_word("horse") || has_word("horses") || has_word("sheep")
              || has_word("deer") || has_word("slug") || has_word("slugs") || has_word("snail")
              || has_word("snails") || has_word("aphid") || has_word("aphids")
