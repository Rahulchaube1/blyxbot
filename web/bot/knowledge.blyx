              || has_word("sunny") || has_word("sunshine") || has_word("shade")
              || has_word("shady") || has_word("bright") || has_word("dark")
              || has_word("window") || has_word("windowsill") || has_pair("south", "facing")
              || has_pair("north", "facing") || has_pair("east", "facing")
              || has_pair("west", "facing") || has_word("cat") || has_word("cats")
              || has_word("kitten") || has_word("kittens") || has_word("dog")
              || has_word("dogs") || has_word("puppy") || has_word("puppies") || has_word("pet")
              || has_word("pets") || has_word("eat") || has_word("ate") || has_word("eats")
              || has_word("eating") || has_word("eaten") || has_word("poison")
              || has_word("poisoned") || has_word("toxic")) {
        say_rule("plant-snake-plant", "Water a snake plant every two to three weeks in summer and once a month or less in winter, and only when the compost is dry all the way down. It stores water in its leaves and rots in wet soil, so the surest way to kill one is to water it on a schedule.");
        return true;
    }

    // garden.py: cactus-care
    if (has_word("cactus") || has_word("cacti") || has_word("succulent")
              || has_word("succulents"))
        && (has_word("water") || has_word("watering") || has_word("care")
