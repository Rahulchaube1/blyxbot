              || has_word("hydrangea") || has_word("orchid")) {
        say_rule("repot-a-plant", "Move it up one pot size, no bigger: roots circling the bottom of the old pot, or water running straight through, mean it is ready, and a pot that is far too big holds water round the roots and rots them. Use fresh compost, tease the roots out a little, and keep it out of direct sun for a week after.");
        return true;
    }

    // garden.py: houseplant-yellow-leaves
    if (has_word("houseplant") || has_word("houseplants") || has_pair("house", "plant")
              || has_pair("house", "plants") || has_pair("indoor", "plant")
              || has_pair("indoor", "plants") || has_pair("pot", "plant")
              || has_pair("pot", "plants") || has_word("monstera") || has_word("pothos")
              || has_pair("peace", "lily") || has_pair("spider", "plant")
              || has_pair("snake", "plant") || has_word("fern") || has_word("orchid")
