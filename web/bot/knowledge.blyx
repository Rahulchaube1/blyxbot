              || everyday_phrase3("how", "should", "i") || has_word("paint")
              || has_word("drawing") || everyday_phrase3("light", "green", "shirt")) {
        say_rule("green-plants", "Leaves look green because chlorophyll, the pigment that captures sunlight for photosynthesis, reflects green light and absorbs the reds and blues. In autumn the chlorophyll breaks down and the yellow and orange pigments underneath show through.");
        return true;
    }

    // nature.py: rainbow
    if (has_word("rainbow") || has_word("rainbows"))
        && (has_word("form") || has_word("forms") || has_word("formed")
              || has_word("appear") || has_word("appears") || has_word("made")
              || has_pair("come", "from") || has_pair("comes", "from") || has_word("colours")
              || has_word("colors") || everyday_phrase3("where", "do", "rainbows")
              || everyday_phrase4("why", "are", "there", "rainbows")
              || everyday_phrase5("why", "is", "there", "a", "rainbow")
              || everyday_phrase4("what", "makes", "a", "rainbow")
              || everyday_phrase3("what", "makes", "rainbows"))
        && !(has_word("fish") || has_word("trout") || has_word("flag") || has_word("paint")
              || has_word("pride") || has_word("cake")
              || everyday_phrase4("rainbow", "colours", "in", "order")
              || everyday_phrase4("rainbow", "colors", "in", "order") || has_pair("how", "many")
              || has_pair("colour", "order") || has_pair("color", "order")) {
        say_rule("rainbow", "Sunlight bends as it enters raindrops, reflects off the back and bends again on the way out, which splits it into colours. You only see one with the sun behind you and rain in front, and the red band is always on the outside of the arc.");
        return true;
    }
    false
}

fn everyday_kitchen() -> bool {
    // cooking_entries.py: onion-cry
    if (has_word("onion") || has_word("onions"))
        && (has_word("cry") || has_word("crying") || has_word("tears")
              || has_pair("tear", "up") || has_pair("eyes", "water")
              || has_pair("eyes", "watering") || has_pair("watering", "eyes")
              || has_pair("eyes", "sting") || has_pair("stinging", "eyes")
              || has_pair("eyes", "burn") || everyday_phrase3("makes", "my", "eyes")
              || everyday_phrase3("make", "my", "eyes"))
        && !(has_word("dog") || has_word("dogs") || has_word("puppy") || has_word("puppies")
              || has_word("cat") || has_word("cats") || has_word("kitten")
              || has_word("kittens") || has_word("pet") || has_word("pets") || has_word("ate")
              || has_word("eaten") || has_word("eat") || has_word("eats") || has_word("eating")
              || has_word("poison") || has_word("poisoned") || has_word("poisonous")
              || has_word("toxic")) {
        say_rule("onion-cry", "Cutting an onion breaks its cells and releases a gas that irritates your eyes, so they make tears to wash it away. A sharp knife and a chilled onion release less of it, and the root end holds most of it, so cut that last.");
        return true;
    }

    // cleaning.py: descale-kettle
    if (has_word("kettle") || has_word("kettles"))
        && (has_word("descale") || has_word("descaled") || has_word("descaler")
              || has_word("descaling") || has_word("limescale") || has_word("scale")
              || has_word("scaled") || has_word("furred") || has_word("furring")
              || has_word("chalky") || has_pair("white", "bits") || has_pair("white", "marks")
              || has_pair("white", "stuff") || has_pair("white", "flakes") || has_word("clean")
              || has_word("cleaning") || has_word("rinse") || has_word("rinsed")
              || everyday_phrase3("hard", "water", "ruining")
              || everyday_phrase4("ruined", "by", "hard", "water"))
        && !(has_word("toilet") || has_word("shower") || has_word("bath") || has_word("tap")
              || has_word("taps") || has_word("iron") || has_pair("washing", "machine")
              || has_word("coffee") || has_word("dishwasher") || has_word("bleach")
              || has_word("ammonia") || has_word("electrical") || has_word("cord")
              || has_word("plug") || has_word("base") || has_word("outside")
              || has_word("exterior") || has_word("fire") || has_word("leaking")
              || has_word("leak") || has_word("rust") || has_word("rusty") || has_word("toxic")
              || has_word("poisoned") || has_pair("with", "soap")) {
        say_rule("descale-kettle", "Half fill the kettle with equal parts water and white vinegar, or a sachet of citric acid, boil it and leave it half an hour, then tip it out and boil fresh water twice before you use it again. In a hard-water area do it every couple of months: the scale forms because hard water leaves calcium behind as it boils, and a thick layer makes the kettle slow and puts a scum on the tea.");
        return true;
    }

    // cooking_entries.py: rice-rinse
    if (has_word("rice") || has_word("basmati") || has_word("jasmine"))
        && (has_word("rinse") || has_word("rinsing") || has_word("wash")
              || has_word("washing") || has_word("washed"))
        && !(has_word("cooker") || has_word("pot") || has_word("pan") || has_word("machine")
              || has_word("appliance") || has_pair("the", "washing")
              || has_pair("washing", "up") || has_word("laundry") || has_word("clothes")
              || has_word("dishes") || has_pair("is", "done") || has_pair("done", "yet")
              || has_word("line") || has_word("basket") || has_word("darks")
              || has_word("lights") || has_word("phone") || has_word("mobile")
              || has_word("leftover") || has_word("yesterday") || has_word("reheat")
              || has_word("baby")) {
        say_rule("rice-rinse", "For a risotto or a rice pudding, don't rinse it: that surface starch is what makes it creamy. For separate, fluffy grains, rinse in a sieve until the water runs clear, which washes the starch off. It was never about hygiene.");
        return true;
    }

    // cooking_entries.py: rice-portion
    if (has_word("rice") || has_word("basmati") || has_word("jasmine"))
        && (has_word("portion") || has_word("portions") || has_word("serving")
              || has_word("servings") || has_pair("per", "person") || has_pair("per", "adult")
              || everyday_phrase3("for", "one", "person")
              || everyday_phrase3("for", "two", "people"))
        && !(has_word("leftover") || has_word("leftovers") || has_word("yesterday")
              || has_pair("left", "out") || has_word("overnight") || has_word("reheat")
              || has_word("reheating") || has_word("sushi") || has_word("risotto")
              || has_word("pudding") || has_word("paella") || has_word("wild")
              || has_word("cauliflower") || has_word("noodle") || has_word("noodles")
              || has_word("phone") || has_word("mobile") || has_word("battery")
              || has_word("microwave") || has_word("cooker") || has_pair("instant", "pot")
              || has_word("steamer") || has_word("water")) {
        say_rule("rice-portion", "Allow about 75g of dry rice per person, or a mugful for two: it swells to two or three times its size, and leftover rice is better under- than over-estimated.");
        return true;
    }

    // cooking_entries.py: rice-sticky
    if has_word("rice")
        && (has_word("sticky") || has_word("sticking") || has_word("sticks")
              || has_word("mushy") || has_word("gluey") || has_word("clumpy")
              || has_word("clumps"))
        && (has_word("why") || has_word("stop") || has_word("stops") || has_word("prevent")
              || has_word("avoid") || has_word("keeps") || has_word("gone")
              || has_word("always") || has_word("too") || has_pair("came", "out")
              || has_pair("comes", "out"))
        && !(has_word("leftover") || has_word("leftovers") || has_word("yesterday")
              || has_pair("left", "out") || has_word("overnight") || has_word("reheat")
              || has_word("reheating") || has_word("sushi") || has_word("risotto")
