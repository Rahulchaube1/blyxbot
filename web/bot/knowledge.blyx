              || has_word("microwave") || has_word("cooker") || has_pair("instant", "pot")
              || has_word("steamer")) {
        say_rule("rice-sticky", "Rinse the rice until the water runs clear, cook it 1 part rice to 1.5 parts water with the lid on, and leave it alone: 12 minutes on a low simmer, then 10 minutes off the heat. Stirring while it cooks is what makes rice gluey.");
        return true;
    }

    // cooking_entries.py: rice-fluffy
    if (has_word("rice") || has_word("basmati") || has_word("jasmine"))
        && (has_word("fluffy") || has_word("separate") || has_word("perfect"))
        && !(has_word("sticky") || has_word("sushi") || has_word("pudding")
              || has_word("risotto") || has_word("paella") || has_word("mushy")
              || has_word("stuck") || has_word("burnt") || has_word("microwave")
              || has_word("leftover") || has_word("reheat") || has_pair("how", "long")
              || has_pair("per", "person") || has_word("freeze") || has_word("yesterday")
              || has_word("yesterdays") || has_pair("last", "night")
              || has_pair("this", "morning") || everyday_phrase3("the", "day", "before")
              || has_pair("day", "before") || everyday_phrase3("the", "day", "after")
              || has_pair("day", "after") || has_pair("day", "later")
              || everyday_phrase3("a", "day", "later") || has_pair("days", "ago")
              || everyday_phrase5("a", "couple", "of", "days", "ago")
              || everyday_phrase3("2", "days", "ago") || everyday_phrase3("two", "days", "ago")
              || has_pair("good", "for") || has_word("leftovers") || has_pair("left", "out")
              || has_word("overnight") || has_word("reheating") || has_word("wild")
              || has_word("cauliflower") || has_word("noodle") || has_word("noodles")
              || has_word("phone") || has_word("mobile") || has_word("battery")
              || has_word("cooker") || has_pair("instant", "pot") || has_word("steamer")) {
        say_rule("rice-fluffy", "Rinse it until the water runs clear, use 1 part rice to 1.5 parts water, bring it to a boil, then turn it right down, put the lid on and leave it 10 minutes without stirring. Take it off the heat and let it sit 5 minutes with the lid on, then fork it through from the bottom - that steam is what makes the grains separate.");
        return true;
    }

    // cooking_entries.py: rice-water
    if (has_word("rice") || has_word("basmati") || has_word("jasmine"))
        && (has_word("water") || has_word("ratio") || has_pair("how", "long")
              || has_word("cook") || has_word("cooking") || has_word("boil")
              || has_word("boiling") || has_word("prepare") || has_word("make")
              || has_word("minutes") || has_word("time"))
        && !(has_word("fridge") || has_word("keep") || has_word("keeps")
              || has_word("leftover") || has_pair("left", "out") || has_word("freeze")
              || has_word("freezer") || has_pair("leave", "it")
              || everyday_phrase3("leave", "it", "in") || everyday_phrase3("left", "it", "in")
              || has_word("phone") || has_word("mobile") || has_word("iphone")
              || has_word("device") || has_word("battery") || has_word("bath")
              || has_pair("water", "damage") || everyday_phrase3("wont", "turn", "on")
              || has_word("drained") || has_word("pudding") || has_word("paella")
              || has_word("risotto") || has_word("pilau") || has_word("sushi")
              || has_word("milk") || has_word("sugar") || has_word("cooker")
              || has_word("microwave") || has_word("pressure") || has_word("steamer")
              || has_word("instant") || has_word("uncooked") || has_word("store")
              || has_word("storing") || has_word("stored") || has_word("last")
              || has_word("lasts") || has_word("jar") || has_word("airtight")
              || has_word("wild") || has_word("cauliflower") || has_word("noodles")
              || has_word("leftovers") || has_word("yesterday") || has_word("overnight")
              || has_word("reheat") || has_word("reheating") || has_word("noodle")
              || has_word("cost") || has_word("price") || has_word("grow") || has_word("grew")
              || has_word("grown") || has_word("growing") || has_word("cultivate")
              || has_word("paddy") || has_word("paddies") || has_word("farm")
              || has_word("salad") || has_word("flour") || has_pair("rice", "paper")
              || has_word("pasta") || has_word("bake") || has_word("baked") || has_word("fried")
              || has_word("fry")) {
        if has_word("brown") || has_word("wholegrain") || has_pair("whole", "grain") {
            say_rule("brown-rice", "Brown rice takes 25 to 30 minutes, with a little more water: 1 part rice to 2 parts water, lid on, low simmer. Let it sit 5 minutes off the heat, still covered, before you fork it through. White long grain is 1 part rice to 1.5 parts water for 12 minutes, then 10 minutes off the heat. Too much water is what turns rice to porridge.");
        } else if has_pair("how", "long") || has_word("minutes") || has_word("time") {
            say_rule("rice-water", "White long grain takes 10 to 12 minutes on a low simmer with the lid on, then 10 more off the heat. Use 1 part rice to about 1.5 parts water by volume, or the fingertip test: water one knuckle above the rice. Brown and wholegrain are the ones that take longer. Too much water is what turns rice to porridge.");
        } else {
            say_rule("rice-water", "Use 1 part rice to about 1.5 parts water by volume for long grain, or the fingertip test: water one knuckle above the rice, and give it 12 minutes on a low simmer with the lid on, then 10 more off the heat. Brown and wholegrain rice are the ones that take longer. Too much water is what turns rice to porridge.");
        }
        return true;
    }

    // cooking_entries.py: quinoa
    if has_word("quinoa")
        && (has_word("cook") || has_word("cooking") || has_word("water")
              || has_word("bitter") || has_pair("how", "long") || has_word("simmer"))
        && !(has_pair("salad", "dressing") || has_word("grow") || has_word("grown")
              || has_word("farm") || has_word("price") || has_word("cost") || has_word("cooker")
              || has_word("microwave") || has_word("leftover") || has_word("leftovers")) {
        say_rule("quinoa", "Rinse quinoa well, simmer it in twice its volume of salted water for 15 minutes, then drain and let it steam with the lid on for 5. Rinsing takes off the bitter coating; the grains are done when the little tails pop out.");
        return true;
    }

    // cooking_entries.py: couscous
    if has_word("couscous")
        && (has_word("cook") || has_word("cooking") || has_word("fluffy")
              || has_word("lumpy") || everyday_phrase3("how", "much", "water")
              || everyday_phrase3("how", "to", "prepare"))
        && !(has_word("pearl") || has_word("giant") || has_word("israeli")
              || has_word("leftover") || has_word("leftovers") || has_word("microwave")
              || has_word("cooker")) {
        say_rule("couscous", "Pour boiling water or stock over the couscous to just cover it, cover the bowl and leave it 5 minutes, then fork it through with a little olive oil. Never stir it with a spoon: that's what makes it clumpy.");
        return true;
    }

    // cooking_entries.py: simmer-or-boil
    if (has_word("simmer") || has_word("simmering") || has_word("simmered"))
        && (has_word("boil") || has_word("boiling") || has_word("boils")
              || has_word("difference") || has_word("rolling") || has_word("gentle")
              || has_word("mean") || has_word("means"))
        && !(has_pair("soup", "maker") || has_pair("slow", "cooker")
              || has_pair("air", "fryer") || has_word("metaphor") || has_word("figuratively")) {
        say_rule("simmer-or-boil", "A boil is a churn of big bubbles you cannot stir down; a simmer is a lazy tremble of small bubbles, about 90C against 100C. Stews, sauces and rice want the simmer, because a hard boil toughens meat and breaks the grains, while pasta and potatoes want the boil. When in doubt turn it down until the bubbles just keep coming.");
        return true;
    }

    // cooking_entries.py: pasta-rinse
    if (has_word("pasta") || has_word("spaghetti") || has_word("penne")
              || has_word("macaroni") || has_word("linguine") || has_word("fusilli")
              || has_word("tagliatelle"))
        && (has_word("rinse") || has_word("rinsing") || has_word("wash")
              || has_word("washing"))
        && (has_word("rinse") || has_word("rinsing") || has_word("rinsed")
              || has_word("wash") || has_word("washing") || has_word("washed")
              || has_pair("cold", "water") || everyday_phrase3("with", "cold", "water")
              || everyday_phrase3("under", "cold", "water") || has_word("tap")
              || has_word("salad") || has_pair("can", "i") || has_pair("can", "we")
              || has_pair("could", "i") || everyday_phrase3("is", "it", "ok")
              || everyday_phrase3("is", "it", "okay") || has_pair("ok", "to")
              || has_pair("okay", "to"))
        && !(has_pair("left", "out") || has_word("leftover") || has_pair("left", "over")
              || has_word("reheat") || has_word("fridge") || has_word("freezer")
              || has_word("freeze") || has_pair("how", "long") || has_word("tomorrow")
              || has_word("sauce") || has_word("bake") || has_word("oven") || has_word("cheese")
              || has_word("jar") || has_word("jars") || has_word("tinned") || has_word("tin")
              || has_word("pan") || has_word("dishwasher") || has_word("stain")
              || has_word("shirt")) {
        say_rule("pasta-rinse", "No, pasta does not need rinsing: it comes out of the pot already wet, and rinsing cools it and washes off the surface starch that makes a sauce cling. Drain it and toss it straight into the sauce, keeping a mugful of the cooking water to loosen things if it looks dry. The one exception is pasta for a cold salad, where a quick rinse under cold water stops it clumping - then drain it well and dress it while it is still slightly warm so it takes up the dressing.");
        return true;
    }

    // cooking_entries.py: pasta-portion
    if (has_word("pasta") || has_word("spaghetti") || has_word("penne"))
        && (has_pair("per", "person") || has_word("portion") || has_word("portions")
              || has_word("serving") || has_word("servings") || has_pair("per", "adult"))
        && !(has_word("sauce") || has_word("dressing") || has_word("salad")
              || has_word("water") || has_word("pan") || has_word("salted") || has_word("salt")
              || has_word("boiling") || has_word("protein") || has_word("calories")) {
        say_rule("pasta-portion", "Allow 75 to 100g of dry pasta per person as a main, or 50g as a starter: a bunch of spaghetti as thick as a 10p coin is about 80g. Pasta roughly doubles in weight when cooked, so a 500g packet feeds four or five.");
        return true;
    }

    // cooking_entries.py: pasta-water
    if (has_word("pasta") || has_word("spaghetti") || has_word("penne")
              || has_word("macaroni") || has_word("fusilli"))
        && (everyday_phrase3("how", "much", "water")
              || everyday_phrase3("litres", "of", "water")
              || everyday_phrase3("liters", "of", "water")
              || everyday_phrase3("how", "much", "salt")
              || everyday_phrase3("salt", "the", "water"))
        && !(has_pair("per", "person") || has_word("portion") || has_word("sauce")
              || has_word("dressing") || has_word("salad") || has_word("bake")
              || has_word("lasagne") || has_word("lasagna") || has_word("soup")
              || has_word("pudding") || has_pair("how", "long") || has_word("gluten")
              || everyday_phrase4("pasta", "water", "for", "plants")
              || everyday_phrase3("water", "my", "plants") || has_word("washing")
              || has_word("wash") || has_word("leftover") || has_word("leftovers")) {
        say_rule("pasta-water", "About a litre of water for every 100g of pasta: a big pan filled about two thirds, at a rolling boil before the pasta goes in, and a teaspoon of salt per four litres. Keep it boiling and stir for the first minute so the pieces do not stick together - there is no need for oil in the water, which only makes the sauce slide off.");
        return true;
    }

    // cooking_entries.py: avocado-ripen
    if (has_word("avocado") || has_word("avocados"))
        && (has_word("ripen") || has_word("ripening") || has_word("ripe")
              || has_word("hard") || has_word("unripe")
              || everyday_phrase3("choose", "a", "good")
              || everyday_phrase3("pick", "a", "good"))
        && !(has_word("tree") || has_word("pit") || has_word("seed") || has_word("grow")
              || has_word("grown") || has_word("growing") || has_word("plant")
              || has_pair("brown", "inside") || has_word("storage")) {
        say_rule("avocado-ripen", "Put a hard avocado in a paper bag with a banana and leave it on the counter for a day or two; the banana's gas speeds it up. Once it gives slightly at the stem end it's ready, and lemon juice stops a cut one going brown.");
        return true;
    }

    // cooking_entries.py: banana-ripe
    if (has_word("banana") || has_word("bananas"))
        && (has_word("ripen") || has_word("ripening") || has_word("ripe")
              || has_word("unripe") || has_pair("too", "green") || has_pair("still", "green")
              || has_word("soften"))
        && !(has_word("plant") || has_word("plants") || has_word("tree")
              || has_word("bread") || has_word("cake") || has_word("peel") || has_word("flies")
              || has_word("garden")) {
        say_rule("banana-ripe", "Bananas ripen fastest in a paper bag on the counter, especially with an apple; the fridge slows them right down but turns the skin black. Black-spotted skin is a sweet banana, and overripe ones are perfect for banana bread.");
        return true;
    }

    // cooking_entries.py: butter-soften
    if has_word("butter")
        && (has_word("soften") || has_word("softening")
              || everyday_phrase3("hard", "to", "spread") || has_pair("too", "hard")
              || has_pair("room", "temperature"))
        && !(has_pair("how", "long") || has_word("keep") || has_word("keeps")
              || has_word("keeping") || has_word("last") || has_word("lasts")
              || has_pair("still", "good") || has_pair("gone", "off") || has_pair("go", "off")
              || has_pair("shelf", "life") || has_word("fridge") || has_word("freeze")
              || has_word("frozen") || everyday_phrase4("safe", "to", "leave", "out")
              || has_pair("leave", "out") || has_word("peanut") || has_word("almond")
              || has_word("shea") || has_word("cocoa") || has_pair("body", "butter")) {
        say_rule("butter-soften", "Cut cold butter into small cubes and leave it 15 minutes, or grate it; both soften it fast without melting it. Don't microwave it, because butter that's too warm splits a cake mix.");
        return true;
    }
    false
}

fn everyday_plants() -> bool {
    // garden.py: repot-a-plant
    if (has_word("repot") || has_word("repotting") || has_pair("pot", "bound")
              || has_pair("root", "bound") || has_pair("bigger", "pot"))
        && (has_word("plant") || has_word("plants") || has_word("houseplant")
              || has_word("monstera") || has_word("pothos") || has_word("roots")
              || has_word("soil") || has_word("compost") || has_word("aloe") || has_word("fern"))
        && !(has_word("cat") || has_word("cats") || has_word("kitten")
              || has_word("kittens") || has_word("dog") || has_word("dogs") || has_word("puppy")
              || has_word("puppies") || has_word("pet") || has_word("pets") || has_word("eat")
              || has_word("ate") || has_word("eats") || has_word("eating") || has_word("eaten")
