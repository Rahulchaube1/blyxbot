              || has_word("calathea") || has_pair("zz", "plant") || has_word("dracaena")
              || has_pair("fiddle", "leaf") || has_pair("rubber", "plant") || has_word("yucca")
              || has_word("poinsettia") || has_word("cyclamen") || has_word("aloe")
              || has_pair("jade", "plant"))
        && (has_word("light") || has_word("sunlight") || has_word("bright")
              || has_word("brighter") || has_word("window") || has_word("windowsill")
              || has_pair("direct", "sun") || has_word("shade") || has_pair("dark", "corner")
              || has_word("sunny") || everyday_phrase4("where", "should", "i", "put"))
        && !(has_word("tomato") || has_word("tomatoes") || has_word("basil")
              || has_word("lawn") || has_word("grass") || has_word("tree") || has_word("trees")
              || has_word("rose") || has_word("roses") || has_word("cucumber")
              || has_word("courgette") || has_word("pepper") || has_word("chilli")
              || has_word("outside") || has_word("lamp") || has_word("ceiling")
              || has_word("fairy") || has_pair("light", "fitting") || has_pair("light", "bulb")
              || has_word("headlight") || has_pair("sun", "cream") || has_word("sunscreen")
              || has_word("sunburn") || has_word("garden") || has_word("gardens")
              || has_word("gardener") || has_word("border") || has_word("flowerbed")
              || has_word("allotment") || has_word("outdoors") || has_word("outdoor")
              || has_word("shrub") || has_word("shrubs") || has_word("hedge")
              || has_word("perennial") || has_word("perennials")
              || has_pair("planting", "flowers") || has_pair("plant", "flowers")
              || everyday_phrase3("plant", "some", "flowers") || has_pair("planting", "out")
              || has_pair("plant", "out") || has_word("seedlings") || has_word("bed")
              || has_word("beds") || has_word("borders") || has_word("soil")
              || has_word("ground") || has_word("veg") || has_word("vegetable")
              || has_word("vegetables") || has_pair("plant", "shade")
              || has_pair("plants", "shade") || has_word("fell") || has_word("fallen")
              || has_word("falls") || has_word("dropped") || has_word("dropping")
              || has_word("knocked") || has_word("tipped") || has_word("broke")
              || has_word("broken") || has_word("cracked") || has_word("smashed")
              || has_word("shattered") || has_word("spilled") || has_word("spilt")
              || has_pair("upside", "down") || everyday_phrase3("on", "its", "side")
              || has_word("cat") || has_word("cats") || has_word("kitten")
              || has_word("kittens") || has_word("dog") || has_word("dogs") || has_word("puppy")
              || has_word("puppies") || has_word("pet") || has_word("pets") || has_word("eat")
              || has_word("ate") || has_word("eats") || has_word("eating") || has_word("eaten")
              || has_word("poison") || has_word("poisoned") || has_word("toxic")) {
        say_rule("houseplant-light", "Bright but out of direct midday sun is what most houseplants want: an east window, or a metre or two back from a south or west one. Move it closer to the glass if the stems are pale and stretched with gaps between the leaves, and further back if the leaves have brown scorched patches on the side facing the window. Turn the pot a quarter turn each time you water so it grows evenly, and give it a few weeks to settle - a plant moved into suddenly stronger light can scorch before it adjusts.");
        return true;
    }

    // garden.py: houseplants-watering
    if (has_word("houseplant") || has_word("houseplants") || has_pair("house", "plant")
              || has_pair("house", "plants") || has_pair("indoor", "plant")
              || has_pair("indoor", "plants") || has_pair("pot", "plant")
              || has_pair("pot", "plants") || has_word("monstera") || has_word("pothos")
              || has_pair("peace", "lily") || has_pair("spider", "plant")
              || has_pair("snake", "plant") || has_word("fern") || has_word("orchid")
              || has_word("calathea") || has_pair("zz", "plant") || has_word("dracaena")
              || has_pair("fiddle", "leaf") || has_pair("rubber", "plant") || has_word("yucca")
              || has_word("poinsettia") || has_word("cyclamen") || has_word("aloe")
              || has_pair("jade", "plant"))
        && (has_word("water") || has_word("watering") || has_pair("how", "often")
              || has_pair("how", "much") || has_pair("look", "after") || has_word("care")
              || has_word("dying") || has_word("drooping") || has_word("droopy")
              || has_pair("keep", "alive") || has_pair("keeping", "alive")
              || has_word("healthy") || has_word("thriving") || has_word("unhappy"))
        && !(has_word("lawn") || has_word("lawns") || has_word("grass") || has_word("mow")
              || has_word("mowing") || has_pair("hanging", "basket")
              || has_pair("hanging", "baskets") || has_pair("window", "box")
              || has_pair("window", "boxes") || has_word("border") || has_word("borders")
              || has_word("allotment") || has_word("plot") || has_word("beds")
              || has_word("roses") || has_word("rose") || has_word("hydrangea")
              || has_word("lavender") || has_word("tomato") || has_word("tomatoes")
              || has_word("potato") || has_word("potatoes") || has_word("tree")
              || has_word("trees") || has_word("shrub") || has_word("shrubs")
              || has_word("hedge") || has_word("hedges") || has_word("seeds")
              || has_word("seedlings") || has_word("sow") || has_word("sowing")
              || has_word("greenhouse") || has_pair("compost", "heap") || has_word("weeds")
              || has_word("slug") || has_word("slugs") || has_word("snails") || has_word("cats")
              || has_word("cat") || has_word("dog") || has_word("dogs") || has_word("puppy")
              || has_word("puppies") || has_word("pup") || has_word("kitten")
              || has_word("kittens") || has_word("rabbit") || has_word("hamster")
              || has_pair("guinea", "pig") || has_word("budgie") || has_word("tattoo")
              || has_word("tattoos") || has_word("pet") || has_word("pets") || has_word("eat")
              || has_word("ate") || has_word("eats") || has_word("eating") || has_word("eaten")
              || has_word("poison") || has_word("poisoned") || has_word("toxic")
              || has_word("feed") || has_word("feeding") || has_word("fertiliser")
              || has_word("fertilizer")) {
        say_rule("houseplants-watering", "Water when the top couple of centimetres of compost is dry, not on a fixed day, and let it drain away rather than sitting in water. Most houseplants die of too much water rather than too little: a pot with no drainage hole, or a saucer left full, rots the roots and the leaves go yellow and drop. If the compost smells sour, repot in fresh compost and water less; if it is bone dry and light, soak the pot in a bowl for ten minutes. Beyond that it is light - most want a bright spot out of direct sun - and a feed every few weeks in spring and summer only.");
        return true;
    }

    // garden.py: watering-plants
    if (has_word("plant") || has_word("plants"))
        && (has_word("water") || has_word("watering"))
        && (has_pair("how", "often") || has_pair("how", "much") || has_word("when")
              || everyday_phrase4("how", "do", "i", "know")
              || everyday_phrase4("how", "can", "i", "tell"))
        && !(has_word("yellow") || has_word("yellowing") || has_word("brown")
              || has_word("drooping") || has_word("droopy") || has_word("dying")
              || has_word("turning") || has_word("photosynthesis") || has_word("basil")
              || has_word("hydrangea") || has_word("tomato") || has_word("tomatoes")
              || has_word("drink") || has_word("drinks") || has_word("drinking")
              || has_word("absorb") || has_word("stems") || has_word("stem") || has_word("feed")
              || has_word("feeds") || has_word("feeding") || has_word("fertiliser")
              || has_word("fertilizer") || has_pair("plant", "food") || has_word("nutrients")
              || has_word("cat") || has_word("cats") || has_word("kitten")
              || has_word("kittens") || has_word("dog") || has_word("dogs") || has_word("puppy")
              || has_word("puppies") || has_word("pet") || has_word("pets") || has_word("eat")
              || has_word("ate") || has_word("eats") || has_word("eating") || has_word("eaten")
              || has_word("poison") || has_word("poisoned") || has_word("toxic")
              || has_word("factory") || has_pair("power", "plant")
              || has_pair("chemical", "plant") || has_word("industrial")) {
        say_rule("watering-plants", "Check the soil before you water, not the calendar: push a finger in and water only when the top few centimetres are dry, then water until it runs out of the bottom. Plants in pots need it far more often than plants in a border, and in hot weather a big soak twice a week beats a sprinkle every day, because it gets water down to the roots.");
        return true;
    }
    false
}

fn everyday_answer() -> bool {
    if kettle_followup() { return true; }
    if everyday_kitchen() { return true; }
    if everyday_plants() { return true; }
    if everyday_explanation() { return everyday_sky_and_science(); }
    false
}
