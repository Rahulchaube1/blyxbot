// Gregorian calendar rules from bot/knowledge/maths.py in Hugging Face PyBot.
// Apache-2.0. The chat accepts calendar years 1 through 9999.
fn is_leap_year(year: i64) -> bool {
    year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn days_in_month(year: i64, month: i64) -> i64 {
    if month < 1 || month > 12 { return 0; }
    if month == 2 {
        if is_leap_year(year) { return 29; }
        return 28;
    }
    if month == 4 || month == 6 || month == 9 || month == 11 { return 30; }
    31
}

// Gregorian Easter, returned as [month, day] in the same order as upstream.
fn easter_day(year: i64) -> vector {
    let golden = year % 19;
    let century = year / 100;
    let within_century = year % 100;
    let correction = (century - (century + 8) / 25 + 1) / 3;
    let epact = (19 * golden + century - century / 4 - correction + 15) % 30;
    let weekday = (32 + 2 * (century % 4) + 2 * (within_century / 4)
                   - epact - within_century % 4) % 7;
    let exception = (golden + 11 * epact + 22 * weekday) / 451;
    let offset = epact + weekday - 7 * exception + 114;
    [offset / 31, offset % 31 + 1]
}

fn named_month() -> i64 {
    if has_word("january") { return 1; }
    if has_word("february") { return 2; }
    if has_word("march") { return 3; }
    if has_word("april") { return 4; }
    if has_word("may") { return 5; }
    if has_word("june") { return 6; }
    if has_word("july") { return 7; }
    if has_word("august") { return 8; }
    if has_word("september") { return 9; }
    if has_word("october") { return 10; }
    if has_word("november") { return 11; }
    if has_word("december") { return 12; }
    0
}

fn answer_calendar() -> bool {
    if !has_word("easter") && !has_word("leap") && !has_word("days") { return false; }
    let mut year = 0;
    let mut i = 0;
    while i < word_count() {
        let candidate = integer_at(i);
        if candidate >= 1 && candidate <= 9999 { year = candidate; }
        i += 1;
    }
    if has_word("easter") && year > 0 && (has_word("when") || has_word("date") || word(0) == "easter") {
        let date = easter_day(year);
        println!("calendar"); print!("Easter Sunday is ");
        if at(date, 0) == 3 { print!("March "); } else { print!("April "); }
        print!(at(date, 1)); print!(", "); print!(year); println!(".");
        return true;
    }
    if has_word("days") && has_word("many") && !has_word("left") && !has_word("until") {
        let month = named_month();
        if month == 2 && year == 0 { say_rule("calendar", "February has 28 days in an ordinary year and 29 in a leap year."); return true; }
        if month != 0 {
            println!("calendar"); print!(days_in_month(year, month)); println!(" days.");
            return true;
        }
        if has_pair("leap", "year") && year == 0 { say_rule("calendar", "A leap year has 366 days."); return true; }
    }
    if year > 0 && has_pair("leap", "year") {
        println!("calendar"); print!(year);
        if is_leap_year(year) { println!(" is a leap year."); } else { println!(" is not a leap year."); }
        return true;
    }
    false
}
