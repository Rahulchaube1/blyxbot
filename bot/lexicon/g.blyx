fn through_w_get_up(term: str, sense: i64) -> str {
    if term == "gain" { return w_gain(sense); }
    if term == "game" { return w_game(sense); }
    if term == "garden" { return w_garden(sense); }
    if term == "gas" { return w_gas(sense); }
    if term == "gather" { return w_gather(sense); }
