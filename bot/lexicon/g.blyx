pub fn lookup_g(term: str, sense: i64) -> str {
    if term <= "get up" { return through_w_get_up(term, sense); }
    if term <= "god" { return through_w_god(term, sense); }
    if term <= "greek" { return through_w_greek(term, sense); }
    through_w_guy(term, sense)
}

