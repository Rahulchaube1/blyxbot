    if term == "german" { return w_german(sense); }
    if term == "gesture" { return w_gesture(sense); }
    if term == "get" { return w_get(sense); }
    if term == "get into" { return w_get_into(sense); }
    if term == "get out" { return w_get_out(sense); }
    if term == "get up" { return w_get_up(sense); }
    ""
}

