pub fn lookup_f(term: str, sense: i64) -> str {
    if term <= "fashion" { return through_w_fashion(term, sense); }
    if term <= "fifty" { return through_w_fifty(term, sense); }
    if term <= "finger" { return through_w_finger(term, sense); }
    if term <= "float" { return through_w_float(term, sense); }
    if term <= "for example" { return through_w_for_example(term, sense); }
    if term <= "freedom" { return through_w_freedom(term, sense); }
    through_w_future(term, sense)
}

