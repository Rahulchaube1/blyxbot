fn through_w_fashion(term: str, sense: i64) -> str {
    if term == "face" { return w_face(sense); }
    if term == "facility" { return w_facility(sense); }
    if term == "fact" { return w_fact(sense); }
    if term == "factor" { return w_factor(sense); }
    if term == "fail" { return w_fail(sense); }
    if term == "failure" { return w_failure(sense); }
    if term == "fairly" { return w_fairly(sense); }
    if term == "faith" { return w_faith(sense); }
    if term == "fall" { return w_fall(sense); }
    if term == "familiar" { return w_familiar(sense); }
    if term == "family" { return w_family(sense); }
    if term == "famous" { return w_famous(sense); }
    if term == "far" { return w_far(sense); }
    if term == "farm" { return w_farm(sense); }
    if term == "farmer" { return w_farmer(sense); }
    if term == "fashion" { return w_fashion(sense); }
    ""
}

