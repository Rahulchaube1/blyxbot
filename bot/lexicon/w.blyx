fn through_w_wave(term: str, sense: i64) -> str {
    if term == "wage" { return w_wage(sense); }
    if term == "wagon" { return w_wagon(sense); }
    if term == "wait" { return w_wait(sense); }
    if term == "walk" { return w_walk(sense); }
    if term == "wall" { return w_wall(sense); }
    if term == "want" { return w_want(sense); }
    if term == "war" { return w_war(sense); }
    if term == "warm" { return w_warm(sense); }
    if term == "warn" { return w_warn(sense); }
    if term == "warning" { return w_warning(sense); }
    if term == "wash" { return w_wash(sense); }
    if term == "washington" { return w_washington(sense); }
    if term == "waste" { return w_waste(sense); }
    if term == "watch" { return w_watch(sense); }
    if term == "water" { return w_water(sense); }
    if term == "wave" { return w_wave(sense); }
    ""
}

