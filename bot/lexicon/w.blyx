    if term == "wrong" { return w_wrong(sense); }
    ""
}

pub fn lookup_w(term: str, sense: i64) -> str {
    if term <= "wave" { return through_w_wave(term, sense); }
    if term <= "wheel" { return through_w_wheel(term, sense); }
    if term <= "winter" { return through_w_winter(term, sense); }
    if term <= "worry" { return through_w_worry(term, sense); }
    through_w_wrong(term, sense)
}

pub fn words_w() -> str {
    "wage|wagon|wait|walk|wall|want|war|warm|warn|warning|wash|washington|waste|watch|water|wave|wavelength|way|weakness|weapon|wear|weather|week|weep|weigh|weight|welcome|well|west|western|wet|wheel|while|whip|whisper|white|whole|wide|widely|wife|wild|will|willing|win|wind|window|wing|winter|wire|wish|withdraw|witness|woman|wonder|wood|woods|word|words|work|work on|work out|worker|world|worry|worse|worship|worth|wound|wounded|write|writer|writing|wrong"
}
