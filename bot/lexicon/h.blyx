}

pub fn lookup_h(term: str, sense: i64) -> str {
    if term <= "health" { return through_w_health(term, sense); }
    if term <= "hire" { return through_w_hire(term, sense); }
    if term <= "hour" { return through_w_hour(term, sense); }
    through_w_hypothalamic(term, sense)
}

