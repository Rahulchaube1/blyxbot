fn through_w_health(term: str, sense: i64) -> str {
    if term == "hair" { return w_hair(sense); }
    if term == "half" { return w_half(sense); }
    if term == "hall" { return w_hall(sense); }
    if term == "halt" { return w_halt(sense); }
    if term == "hand" { return w_hand(sense); }
    if term == "handle" { return w_handle(sense); }
    if term == "hang" { return w_hang(sense); }
    if term == "happen" { return w_happen(sense); }
    if term == "happy" { return w_happy(sense); }
    if term == "hard" { return w_hard(sense); }
    if term == "hardly" { return w_hardly(sense); }
    if term == "hat" { return w_hat(sense); }
    if term == "hate" { return w_hate(sense); }
    if term == "have" { return w_have(sense); }
    if term == "head" { return w_head(sense); }
    if term == "health" { return w_health(sense); }
    ""
}

