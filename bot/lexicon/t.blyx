fn through_w_tattered(term: str, sense: i64) -> str {
    if term == "table" { return w_table(sense); }
    if term == "take" { return w_take(sense); }
    if term == "take care" { return w_take_care(sense); }
    if term == "take off" { return w_take_off(sense); }
    if term == "take on" { return w_take_on(sense); }
    if term == "take out" { return w_take_out(sense); }
    if term == "take over" { return w_take_over(sense); }
    if term == "take place" { return w_take_place(sense); }
    if term == "take up" { return w_take_up(sense); }
    if term == "tale" { return w_tale(sense); }
    if term == "talk" { return w_talk(sense); }
    if term == "talk about" { return w_talk_about(sense); }
    if term == "tall" { return w_tall(sense); }
    if term == "task" { return w_task(sense); }
    if term == "taste" { return w_taste(sense); }
    if term == "tattered" { return w_tattered(sense); }
    ""
}

