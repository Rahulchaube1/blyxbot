pub fn lookup_t(term: str, sense: i64) -> str {
    if term <= "tattered" { return through_w_tattered(term, sense); }
    if term <= "text" { return through_w_text(term, sense); }
    if term <= "threaten" { return through_w_threaten(term, sense); }
    if term <= "tone" { return through_w_tone(term, sense); }
    if term <= "traditional" { return through_w_traditional(term, sense); }
    if term <= "trouble" { return through_w_trouble(term, sense); }
    if term <= "two" { return through_w_two(term, sense); }
    through_w_typical(term, sense)
}

