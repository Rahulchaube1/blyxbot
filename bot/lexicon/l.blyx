fn through_w_launch(term: str, sense: i64) -> str {
    if term == "l" { return w_l(sense); }
    if term == "label" { return w_label(sense); }
    if term == "labor" { return w_labor(sense); }
    if term == "lack" { return w_lack(sense); }
    if term == "lady" { return w_lady(sense); }
    if term == "land" { return w_land(sense); }
    if term == "language" { return w_language(sense); }
    if term == "large" { return w_large(sense); }
    if term == "largely" { return w_largely(sense); }
    if term == "larger" { return w_larger(sense); }
    if term == "last" { return w_last(sense); }
    if term == "late" { return w_late(sense); }
    if term == "later" { return w_later(sense); }
    if term == "latter" { return w_latter(sense); }
    if term == "laugh" { return w_laugh(sense); }
    if term == "launch" { return w_launch(sense); }
    ""
}

fn through_w_let(term: str, sense: i64) -> str {
    if term == "law" { return w_law(sense); }
    if term == "lay" { return w_lay(sense); }
    if term == "lead" { return w_lead(sense); }
    if term == "leader" { return w_leader(sense); }
    if term == "leadership" { return w_leadership(sense); }
    if term == "leaf" { return w_leaf(sense); }
