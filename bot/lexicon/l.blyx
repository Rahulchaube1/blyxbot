    if term == "left" { return w_left(sense); }
    if term == "leg" { return w_leg(sense); }
    if term == "legal" { return w_legal(sense); }
    if term == "length" { return w_length(sense); }
    if term == "less" { return w_less(sense); }
    if term == "let" { return w_let(sense); }
    ""
}

fn through_w_link(term: str, sense: i64) -> str {
    if term == "letter" { return w_letter(sense); }
    if term == "level" { return w_level(sense); }
    if term == "liberal" { return w_liberal(sense); }
    if term == "lick" { return w_lick(sense); }
