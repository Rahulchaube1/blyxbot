fn through_w_lung(term: str, sense: i64) -> str {
    if term == "look" { return w_look(sense); }
    if term == "look at" { return w_look_at(sense); }
    if term == "look for" { return w_look_for(sense); }
    if term == "look like" { return w_look_like(sense); }
    if term == "lose" { return w_lose(sense); }
    if term == "loss" { return w_loss(sense); }
    if term == "lot" { return w_lot(sense); }
    if term == "loud" { return w_loud(sense); }
    if term == "love" { return w_love(sense); }
    if term == "low" { return w_low(sense); }
    if term == "lower" { return w_lower(sense); }
    if term == "lung" { return w_lung(sense); }
    ""
}

pub fn lookup_l(term: str, sense: i64) -> str {
    if term <= "launch" { return through_w_launch(term, sense); }
    if term <= "let" { return through_w_let(term, sense); }
    if term <= "link" { return through_w_link(term, sense); }
    if term <= "long" { return through_w_long(term, sense); }
    through_w_lung(term, sense)
}

pub fn words_l() -> str {
    "l|label|labor|lack|lady|land|language|large|largely|larger|last|late|later|latter|laugh|launch|law|lay|lead|leader|leadership|leaf|lean|leap|learn|leave|left|leg|legal|length|less|let|letter|level|liberal|lick|lie|lie in|lieutenant|life|lift|light|like|likely|limit|limited|line|link|lip|liquid|list|listen|literary|literature|little|live|load|loan|local|locate|located|location|lock|long|look|look at|look for|look like|lose|loss|lot|loud|love|low|lower|lung"
}
