}

fn through_w_long(term: str, sense: i64) -> str {
    if term == "lip" { return w_lip(sense); }
    if term == "liquid" { return w_liquid(sense); }
    if term == "list" { return w_list(sense); }
    if term == "listen" { return w_listen(sense); }
    if term == "literary" { return w_literary(sense); }
    if term == "literature" { return w_literature(sense); }
    if term == "little" { return w_little(sense); }
    if term == "live" { return w_live(sense); }
    if term == "load" { return w_load(sense); }
