    if term == "lie in" { return w_lie_in(sense); }
    if term == "lieutenant" { return w_lieutenant(sense); }
    if term == "life" { return w_life(sense); }
    if term == "lift" { return w_lift(sense); }
    if term == "light" { return w_light(sense); }
    if term == "like" { return w_like(sense); }
    if term == "likely" { return w_likely(sense); }
    if term == "limit" { return w_limit(sense); }
    if term == "limited" { return w_limited(sense); }
    if term == "line" { return w_line(sense); }
    if term == "link" { return w_link(sense); }
