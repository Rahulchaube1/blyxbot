    if term == "earlier" { return w_earlier(sense); }
    if term == "early" { return w_early(sense); }
    if term == "earn" { return w_earn(sense); }
    if term == "earth" { return w_earth(sense); }
    if term == "easily" { return w_easily(sense); }
    if term == "east" { return w_east(sense); }
    if term == "easy" { return w_easy(sense); }
    if term == "eat" { return w_eat(sense); }
    if term == "economic" { return w_economic(sense); }
    if term == "economy" { return w_economy(sense); }
    if term == "edge" { return w_edge(sense); }
    if term == "education" { return w_education(sense); }
    if term == "effect" { return w_effect(sense); }
