pub fn lookup_e(term: str, sense: i64) -> str {
    if term <= "effect" { return through_w_effect(term, sense); }
    if term <= "employ" { return through_w_employ(term, sense); }
    if term <= "enter" { return through_w_enter(term, sense); }
    if term <= "estimate" { return through_w_estimate(term, sense); }
    if term <= "excitement" { return through_w_excitement(term, sense); }
    if term <= "explanation" { return through_w_explanation(term, sense); }
    through_w_eye(term, sense)
}

