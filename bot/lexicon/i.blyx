pub fn lookup_i(term: str, sense: i64) -> str {
    if term <= "importance" { return through_w_importance(term, sense); }
    if term <= "increased" { return through_w_increased(term, sense); }
    if term <= "insist" { return through_w_insist(term, sense); }
    if term <= "international" { return through_w_international(term, sense); }
    through_w_item(term, sense)
}

pub fn words_i() -> str {
    "ice|idea|identical|identify|identity|ignore|illusion|illustrate|image|imagination|imagine|imitation|immediate|immediately|imply|importance|important|impose|impossible|impress|impression|improve|in|in fact|in front|in general|inch|incident|include|income|increase|increased|indeed|independence|independent|indicate|individual|induce|industrial|industry|influence|inform|information|initial|injury|inner|inside|insist|inspire|install|instance|instant|instead|institution|instrument|insure|integration|intend|intense|intensity|interest|interested|interesting|international|interpret|interrupt|interview|introduce|investigate|investigation|invite|involve|involved|iron|issue|item"
}
