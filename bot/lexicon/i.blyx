fn through_w_importance(term: str, sense: i64) -> str {
    if term == "ice" { return w_ice(sense); }
    if term == "idea" { return w_idea(sense); }
    if term == "identical" { return w_identical(sense); }
    if term == "identify" { return w_identify(sense); }
    if term == "identity" { return w_identity(sense); }
    if term == "ignore" { return w_ignore(sense); }
    if term == "illusion" { return w_illusion(sense); }
    if term == "illustrate" { return w_illustrate(sense); }
    if term == "image" { return w_image(sense); }
    if term == "imagination" { return w_imagination(sense); }
    if term == "imagine" { return w_imagine(sense); }
    if term == "imitation" { return w_imitation(sense); }
    if term == "immediate" { return w_immediate(sense); }
    if term == "immediately" { return w_immediately(sense); }
    if term == "imply" { return w_imply(sense); }
    if term == "importance" { return w_importance(sense); }
    ""
}

