pub fn lookup_p(term: str, sense: i64) -> str {
    if term <= "part" { return through_w_part(term, sense); }
    if term <= "payment" { return through_w_payment(term, sense); }
    if term <= "personnel" { return through_w_personnel(term, sense); }
    if term <= "plan" { return through_w_plan(term, sense); }
    if term <= "policy" { return through_w_policy(term, sense); }
    if term <= "possibly" { return through_w_possibly(term, sense); }
    if term <= "prepare" { return through_w_prepare(term, sense); }
    if term <= "prime minister" { return through_w_prime_minister(term, sense); }
    if term <= "profound" { return through_w_profound(term, sense); }
    if term <= "prove" { return through_w_prove(term, sense); }
    through_w_put_on(term, sense)
}

