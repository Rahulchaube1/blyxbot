fn through_w_part(term: str, sense: i64) -> str {
    if term == "pa" { return w_pa(sense); }
    if term == "pace" { return w_pace(sense); }
    if term == "pack" { return w_pack(sense); }
    if term == "page" { return w_page(sense); }
    if term == "pain" { return w_pain(sense); }
    if term == "paint" { return w_paint(sense); }
    if term == "painting" { return w_painting(sense); }
    if term == "pair" { return w_pair(sense); }
    if term == "pale" { return w_pale(sense); }
    if term == "papa" { return w_papa(sense); }
    if term == "paper" { return w_paper(sense); }
    if term == "parallel" { return w_parallel(sense); }
    if term == "parent" { return w_parent(sense); }
    if term == "paris" { return w_paris(sense); }
    if term == "park" { return w_park(sense); }
    if term == "part" { return w_part(sense); }
    ""
}

