pub fn lookup_r(term: str, sense: i64) -> str {
    if term <= "reaction" { return through_w_reaction(term, sense); }
    if term <= "recently" { return through_w_recently(term, sense); }
    if term <= "regard as" { return through_w_regard_as(term, sense); }
    if term <= "religion" { return through_w_religion(term, sense); }
    if term <= "requirement" { return through_w_requirement(term, sense); }
    if term <= "return" { return through_w_return(term, sense); }
    if term <= "roof" { return through_w_roof(term, sense); }
    through_w_russian(term, sense)
}

