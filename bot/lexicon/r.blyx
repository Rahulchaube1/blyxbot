fn through_w_reaction(term: str, sense: i64) -> str {
    if term == "race" { return w_race(sense); }
    if term == "radiation" { return w_radiation(sense); }
    if term == "radio" { return w_radio(sense); }
    if term == "rage" { return w_rage(sense); }
    if term == "rain" { return w_rain(sense); }
    if term == "raise" { return w_raise(sense); }
    if term == "range" { return w_range(sense); }
    if term == "rank" { return w_rank(sense); }
    if term == "rapid" { return w_rapid(sense); }
    if term == "rapidly" { return w_rapidly(sense); }
    if term == "rate" { return w_rate(sense); }
    if term == "rather" { return w_rather(sense); }
    if term == "ratio" { return w_ratio(sense); }
    if term == "reach" { return w_reach(sense); }
    if term == "react" { return w_react(sense); }
    if term == "reaction" { return w_reaction(sense); }
    ""
}

