pub fn lookup_b(term: str, sense: i64) -> str {
    if term <= "battle" { return through_w_battle(term, sense); }
    if term <= "behavior" { return through_w_behavior(term, sense); }
    if term <= "bit" { return through_w_bit(term, sense); }
    if term <= "bottle" { return through_w_bottle(term, sense); }
    if term <= "broad" { return through_w_broad(term, sense); }
    through_w_buy(term, sense)
}

pub fn words_b() -> str {
    "back|background|bad|balance|ball|band|bank|bar|barn|base|baseball|basic|basis|bastard|battery|battle|be|be born|be due|beam|bear|beat|beautiful|become|bed|bedroom|bee|before|begin|beginning|behave|behavior|belief|believe|believe in|belong to|below|bend|benefit|best|bet|better|big|bill|bind|binomial|bird|bit|bitter|black|blame|blanket|blind|block|blood|blow|blue|board|body|bond|book|borrow|bother|bottle|bounce|bound|bow|box|boy|brain|branch|break|breath|breathe|brief|bright|brilliant|bring|bring in|broad|bronchial artery|brother|brown|brush|build|building|bullet|burn|burst|business|busy|buy"
}
