fn through_w_battle(term: str, sense: i64) -> str {
    if term == "back" { return w_back(sense); }
    if term == "background" { return w_background(sense); }
    if term == "bad" { return w_bad(sense); }
    if term == "balance" { return w_balance(sense); }
    if term == "ball" { return w_ball(sense); }
    if term == "band" { return w_band(sense); }
    if term == "bank" { return w_bank(sense); }
    if term == "bar" { return w_bar(sense); }
    if term == "barn" { return w_barn(sense); }
    if term == "base" { return w_base(sense); }
    if term == "baseball" { return w_baseball(sense); }
    if term == "basic" { return w_basic(sense); }
    if term == "basis" { return w_basis(sense); }
    if term == "bastard" { return w_bastard(sense); }
    if term == "battery" { return w_battery(sense); }
    if term == "battle" { return w_battle(sense); }
    ""
}

