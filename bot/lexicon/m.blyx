pub fn lookup_m(term: str, sense: i64) -> str {
    if term <= "march" { return through_w_march(term, sense); }
    if term <= "mean" { return through_w_mean(term, sense); }
    if term <= "mexican" { return through_w_mexican(term, sense); }
    if term <= "model" { return through_w_model(term, sense); }
    if term <= "move" { return through_w_move(term, sense); }
    through_w_mutter(term, sense)
}

