fn through_w_march(term: str, sense: i64) -> str {
    if term == "machine" { return w_machine(sense); }
    if term == "mad" { return w_mad(sense); }
    if term == "main" { return w_main(sense); }
    if term == "maintain" { return w_maintain(sense); }
    if term == "major" { return w_major(sense); }
    if term == "majority" { return w_majority(sense); }
    if term == "make" { return w_make(sense); }
    if term == "make up" { return w_make_up(sense); }
    if term == "man" { return w_man(sense); }
    if term == "manage" { return w_manage(sense); }
    if term == "management" { return w_management(sense); }
    if term == "manager" { return w_manager(sense); }
    if term == "manner" { return w_manner(sense); }
    if term == "manufacturer" { return w_manufacturer(sense); }
    if term == "many" { return w_many(sense); }
    if term == "march" { return w_march(sense); }
    ""
}

