fn through_w_death(term: str, sense: i64) -> str {
    if term == "daily" { return w_daily(sense); }
    if term == "damage" { return w_damage(sense); }
    if term == "damn" { return w_damn(sense); }
    if term == "dance" { return w_dance(sense); }
    if term == "danger" { return w_danger(sense); }
    if term == "dangerous" { return w_dangerous(sense); }
    if term == "dare" { return w_dare(sense); }
    if term == "dark" { return w_dark(sense); }
    if term == "darkness" { return w_darkness(sense); }
    if term == "data" { return w_data(sense); }
    if term == "date" { return w_date(sense); }
    if term == "daughter" { return w_daughter(sense); }
    if term == "day" { return w_day(sense); }
    if term == "dead" { return w_dead(sense); }
    if term == "deal" { return w_deal(sense); }
    if term == "death" { return w_death(sense); }
    ""
}

