    ""
}

pub fn lookup_d(term: str, sense: i64) -> str {
    if term <= "death" { return through_w_death(term, sense); }
    if term <= "deliver" { return through_w_deliver(term, sense); }
    if term <= "despair" { return through_w_despair(term, sense); }
    if term <= "differ" { return through_w_differ(term, sense); }
    if term <= "discuss" { return through_w_discuss(term, sense); }
    if term <= "doctrine" { return through_w_doctrine(term, sense); }
    if term <= "drill" { return through_w_drill(term, sense); }
    through_w_duty(term, sense)
}

pub fn words_d() -> str {
    "daily|damage|damn|dance|danger|dangerous|dare|dark|darkness|data|date|daughter|day|dead|deal|death|debate|decade|decide|decision|declare|decline|decrease|deep|defeat|defend|defense|define|definition|degree|delay|deliver|demand|democratic|demonstrate|deny|depart|department|depend on|depth|derive|describe|description|deserve|design|desire|desk|despair|destroy|detail|detailed|detect|detective|detergent|determine|develop|development|device|devil|devote|diameter|dictionary|die|differ|difference|different|difficult|difficulty|dinner|direct|direction|directly|director|dirt|disappear|discharge|disclose|discover|discovery|discuss|discussion|disease|display|distance|distant|distinct|distinction|distinguish|distribute|distribution|district|divide|division|do|doctor|doctrine|dog|dollar|domestic|dominant|dominate|door|double|doubt|down|downtown|drag|drama|draw|dream|dress|drill|drink|drive|drop|drug|dry|dull|dust|duty"
}
