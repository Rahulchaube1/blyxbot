pub fn lookup_s(term: str, sense: i64) -> str {
    if term <= "scientific" { return through_w_scientific(term, sense); }
    if term <= "seize" { return through_w_seize(term, sense); }
    if term <= "services" { return through_w_services(term, sense); }
    if term <= "shell" { return through_w_shell(term, sense); }
    if term <= "sigh" { return through_w_sigh(term, sense); }
    if term <= "sink" { return through_w_sink(term, sense); }
    if term <= "slowly" { return through_w_slowly(term, sense); }
    if term <= "soldier" { return through_w_soldier(term, sense); }
    if term <= "south" { return through_w_south(term, sense); }
    if term <= "spot" { return through_w_spot(term, sense); }
    if term <= "station" { return through_w_station(term, sense); }
    if term <= "store" { return through_w_store(term, sense); }
    if term <= "student" { return through_w_student(term, sense); }
    if term <= "suddenly" { return through_w_suddenly(term, sense); }
    if term <= "sure" { return through_w_sure(term, sense); }
    through_w_system(term, sense)
}

