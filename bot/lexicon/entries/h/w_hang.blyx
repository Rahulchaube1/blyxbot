// hang — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_hang(sense: i64) -> str {
    if sense == 0 { return "9"; }
    // verb 01482075
    if sense == 1 {
        return "verb\tbe suspended or hanging\t\t";
    }
    // verb 01481360
    if sense == 2 {
        return "verb\tcause to be hanging or suspended\thang up\tHang that picture on the wall";
    }
    // verb 02485451
    if sense == 3 {
        return "verb\tkill by hanging\tstring up\tThe murderer was hanged on Friday";
    }
    // verb 01977962
    if sense == 4 {
        return "verb\tlet drop or droop\t\tHang one's head in shame";
    }
    // verb 01542668
    if sense == 5 {
        return "verb\tfall or flow in a certain way\tfall, flow\tThis dress hangs well";
    }
    // verb 02734952
    if sense == 6 {
        return "verb\tbe menacing, burdensome, or oppressive\t\tThis worry hangs on my mind";
    }
    // verb 02170427
    if sense == 7 {
        return "verb\tgive heed (to)\tattend, advert, pay heed, give ear\t";
    }
    // verb 01481957
    if sense == 8 {
        return "verb\tbe suspended or poised\t\t";
    }
    // verb 01216331
    if sense == 9 {
        return "verb\thold on tightly or tenaciously\tcling\thang on to your father's hands";
    }
    ""
}
