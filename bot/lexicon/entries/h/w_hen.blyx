// hen — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_hen(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 01792640
    if sense == 1 {
        return "noun\tadult female chicken\tbiddy\t";
    }
    // noun 01514859
    if sense == 2 {
        return "noun\tadult female bird\t\t";
    }
    ""
}
