// historian — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_historian(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 10177150
    if sense == 1 {
        return "noun\ta person who is an authority on history and who studies it and writes about it\thistoriographer\t";
    }
    ""
}
