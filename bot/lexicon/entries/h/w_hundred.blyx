// hundred — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_hundred(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 02196107
    if sense == 1 {
        return "adjective\tbeing ten more than ninety\tone hundred, 100, c\t";
    }
    // noun 13750415
    if sense == 2 {
        return "noun\tten 10s\t100, C, century, one C\t";
    }
    ""
}
