// happy — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_happy(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 01148283
    if sense == 1 {
        return "adjective\tenjoying or showing or marked by joy or pleasure\t\ta happy smile";
    }
    // adj 01048406
    if sense == 2 {
        return "adjective\tmarked by good fortune\tfelicitous\ta happy outcome";
    }
    ""
}
