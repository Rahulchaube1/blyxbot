// hire — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_hire(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02409412
    if sense == 1 {
        return "verb\tengage or hire for work\tengage, employ\tThey hired two new secretaries in the department";
    }
    // verb 02460619
    if sense == 2 {
        return "verb\thold under a lease or rental agreement; of goods and services\trent, charter, lease\t";
    }
    ""
}
