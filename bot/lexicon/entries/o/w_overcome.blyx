// overcome — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_overcome(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // verb 01108148
    if sense == 1 {
        return "verb\twin a victory over\tget the better of, defeat\tYou must overcome all difficulties";
    }
    // verb 01108627
    if sense == 2 {
        return "verb\tget on top of; deal with successfully\tget over, subdue, surmount, master\t";
    }
    // verb 01809321
    if sense == 3 {
        return "verb\tovercome, as with emotions or perceptual stimuli\toverwhelm, overpower, sweep over, whelm, overtake\t";
    }
    ""
}
