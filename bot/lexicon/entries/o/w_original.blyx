// original — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_original(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // adj 01012503
    if sense == 1 {
        return "adjective\tpreceding all others in time or being as first made or performed\t\tthe original inhabitants of the Americas";
    }
    // adj 01853039
    if sense == 2 {
        return "adjective\t(of e.g. information) not secondhand or by way of something intermediary\t\this work is based on only original, not secondary, sources";
    }
    // adj 01686439
    if sense == 3 {
        return "adjective\tbeing or productive of something fresh and unusual; or being as first made or thought of\t\ta truly original approach";
    }
    // noun 03727274
    if sense == 4 {
        return "noun\tan original creation (i.e., an audio recording) from which copies can be made\tmaster, master copy\t";
    }
    // noun 05938400
    if sense == 5 {
        return "noun\tsomething that serves as a model or a basis for making copies\tarchetype, pilot\tthis painting is a copy of the original";
    }
    ""
}
