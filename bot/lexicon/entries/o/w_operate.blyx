// operate — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_operate(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // verb 02443849
    if sense == 1 {
        return "verb\tdirect or control; projects, businesses, etc.\trun\t";
    }
    // verb 01525666
    if sense == 2 {
        return "verb\tperform as expected when applied\tfunction, work, go, run\t";
    }
    // verb 01224744
    if sense == 3 {
        return "verb\thandle and cause to function\tcontrol\tdo not operate machinery after imbibing alcohol";
    }
    // verb 01109863
    if sense == 4 {
        return "verb\tperform a movement in military or naval tactics in order to secure an advantage in attack or defense\tmanoeuver, maneuver, manoeuvre\t";
    }
    // verb 00341285
    if sense == 5 {
        return "verb\thappen\t\t";
    }
    ""
}
