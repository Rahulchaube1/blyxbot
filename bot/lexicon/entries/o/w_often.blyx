// often — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_often(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00035058
    if sense == 1 {
        return "adverb\tmany times at short intervals\tfrequently, oftentimes, oft, ofttimes\twe often met over a cup of coffee";
    }
    // adv 00059413
    if sense == 2 {
        return "adverb\tfrequently or in great quantities\tmuch, a great deal\t";
    }
    ""
}
