// obviously — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_obviously(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00039318
    if sense == 1 {
        return "adverb\tunmistakably (`plain' is often used informally for `plainly')\tevidently, manifestly, patently, apparently, plainly, plain\tthe answer is obviously wrong";
    }
    ""
}
