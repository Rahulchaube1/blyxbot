// owner — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_owner(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10388924
    if sense == 1 {
        return "noun\t(law) someone who owns (is legal possessor of) a business\tproprietor\the is the owner of a chain of restaurants";
    }
    // noun 10389398
    if sense == 2 {
        return "noun\ta person who owns something\tpossessor\tthey are searching for the owner of the car";
    }
    ""
}
