// tonight — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_tonight(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00079499
    if sense == 1 {
        return "adverb\tduring the night of the present day\tthis evening, this night\tdrop by tonight";
    }
    // noun 15263045
    if sense == 2 {
        return "noun\tthe present or immediately coming night\t\t";
    }
    ""
}
