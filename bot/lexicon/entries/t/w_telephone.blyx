// telephone — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_telephone(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 04401088
    if sense == 1 {
        return "noun\telectronic equipment that converts sound into electrical signals that can be transmitted over distances and then converts received signals back into sounds\tphone, telephone set\tI talked to him on the telephone";
    }
    // verb 00789448
    if sense == 2 {
        return "verb\tget or try to get into communication (with someone) by telephone\tcall, call up, phone, ring\t";
    }
    // noun 06272290
    if sense == 3 {
        return "noun\ttransmitting speech at a distance\ttelephony\t";
    }
    ""
}
