// teacher — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_teacher(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10694258
    if sense == 1 {
        return "noun\ta person whose occupation is teaching\tinstructor\t";
    }
    // noun 05854812
    if sense == 2 {
        return "noun\ta personified abstraction that teaches\t\tbooks were his teachers";
    }
    ""
}
