// therefore — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_therefore(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00043003
    if sense == 1 {
        return "adverb\t(used to introduce a logical conclusion) from that fact or reason or as a result\thence, thence, thus, so\ttherefore X must be true";
    }
    ""
}
