// tsunami — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_tsunami(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 07349299
    if sense == 1 {
        return "noun\ta cataclysm resulting from a destructive sea wave caused by an earthquake or volcanic eruption\t\ta colossal tsunami destroyed the Minoan civilization in minutes";
    }
    ""
}
