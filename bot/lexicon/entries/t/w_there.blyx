// there — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_there(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // adv 00109151
    if sense == 1 {
        return "adverb\tin or at that place\tat that place, in that location\tthey have lived there for years";
    }
    // adv 00109461
    if sense == 2 {
        return "adverb\tin that matter\tin that respect, on that point\tI agree with you there";
    }
    // adv 00109328
    if sense == 3 {
        return "adverb\tto or toward that place; away from the speaker\tthither\tgo there around noon!";
    }
    ""
}
