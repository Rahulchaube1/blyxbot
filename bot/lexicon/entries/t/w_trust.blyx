// trust — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_trust(sense: i64) -> str {
    if sense == 0 { return "10"; }
    // verb 00688377
    if sense == 1 {
        return "verb\thave confidence or faith in\tswear, rely, bank\tWe can trust in God";
    }
    // verb 02481819
    if sense == 2 {
        return "verb\tallow without fear\t\t";
    }
    // noun 13360498
    if sense == 3 {
        return "noun\tsomething (as property) held by one party (the trustee) for the benefit of another (the beneficiary)\t\the is the beneficiary of a generous trust set up by his father";
    }
    // verb 00721098
    if sense == 4 {
        return "verb\tbe confident about something\tbelieve\t";
    }
    // noun 05697976
    if sense == 5 {
        return "noun\tcertainty based on past experience\treliance\the put more trust in his own two legs than in the gun";
    }
    // noun 04895246
    if sense == 6 {
        return "noun\tthe trait of believing in the honesty and reliability of others\ttrustingness, trustfulness\tthe experience destroyed his trust and personal dignity";
    }
    // verb 01826723
    if sense == 7 {
        return "verb\texpect and wish\thope, desire\tI trust you will behave better from now on";
    }
    // noun 08236621
    if sense == 8 {
        return "noun\ta consortium of independent organizations formed to limit competition by controlling the production and distribution of a product or service\tcorporate trust, combine, cartel\tthey set up the trust in the hope of gaining a monopoly";
    }
    // noun 05943066
    if sense == 9 {
        return "noun\tcomplete confidence in a person or plan etc\tfaith\tthe doctor-patient relationship is based on trust";
    }
    // verb 02349212
    if sense == 10 {
        return "verb\tconfer a trust upon\tentrust, intrust, confide, commit\t";
    }
    ""
}
