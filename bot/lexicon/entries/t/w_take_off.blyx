// take off — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_take_off(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // verb 02014165
    if sense == 1 {
        return "verb\tleave\tdepart, part, start, start out, set forth, set off, set out\t";
    }
    // verb 00179060
    if sense == 2 {
        return "verb\ttake away or remove\t\t";
    }
    // verb 02014553
    if sense == 3 {
        return "verb\tdepart from the ground\tlift off\t";
    }
    // verb 02411950
    if sense == 4 {
        return "verb\ttake time off from work; stop working temporarily\ttake time off\t";
    }
    // verb 01743313
    if sense == 5 {
        return "verb\tmimic or imitate in an amusing or satirical manner\t\t";
    }
    // verb 00050454
    if sense == 6 {
        return "verb\tremove clothes\t\ttake off your shirt--it's very hot in here";
    }
    ""
}
