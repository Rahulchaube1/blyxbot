// translate — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_translate(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // verb 00959827
    if sense == 1 {
        return "verb\trestate (words) from one language into another language\tinterpret, render\tI have to translate when my in-laws from Austria visit the U.S.";
    }
    // verb 00383542
    if sense == 2 {
        return "verb\tchange from one form or medium into another\ttransform\tBraque translated collage into oil";
    }
    // verb 00593852
    if sense == 3 {
        return "verb\tmake sense of a language\tunderstand, read, interpret\t";
    }
    // verb 01436290
    if sense == 4 {
        return "verb\tbring to a certain spiritual state\t\t";
    }
    // verb 00522441
    if sense == 5 {
        return "verb\tchange the position of (figures or bodies) in space without rotation\t\t";
    }
    ""
}
