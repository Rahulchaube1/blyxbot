// trip — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_trip(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 00308370
    if sense == 1 {
        return "noun\ta journey for some purpose (usually including the return)\t\the took a trip to the shopping center";
    }
    // verb 01900408
    if sense == 2 {
        return "verb\tmiss a step and fall or nearly fall\tstumble\t";
    }
    ""
}
