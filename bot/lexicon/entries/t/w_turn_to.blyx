// turn to — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_turn_to(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00897564
    if sense == 1 {
        return "verb\tspeak to\taddress\t";
    }
    // verb 00549771
    if sense == 2 {
        return "verb\tdirect one's interest or attention towards; go into\t\tPeople turn to mysticism at the turn of a millennium";
    }
    ""
}
