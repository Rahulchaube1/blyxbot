// tree — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_tree(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 13104059
    if sense == 1 {
        return "noun\ta tall perennial woody plant having a main trunk and branches forming a distinct elevated crown; includes both gymnosperms and angiosperms\t\t";
    }
    ""
}
