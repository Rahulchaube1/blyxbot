// thus — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_thus(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00043003
    if sense == 1 {
        return "adverb\t(used to introduce a logical conclusion) from that fact or reason or as a result\ttherefore, hence, thence, so\tit is late and thus we must go";
    }
    // adv 00121135
    if sense == 2 {
        return "adverb\tin the way indicated\tthusly, so\tset up the pieces thus";
    }
    ""
}
