// together — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_together(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // adv 00116791
    if sense == 1 {
        return "adverb\tin contact with each other or in proximity\t\tthe leaves stuck together";
    }
    // adv 00116994
    if sense == 2 {
        return "adverb\tassembled in one place\t\twe were gathered together";
    }
    // adv 00507927
    if sense == 3 {
        return "adverb\tin each other's company\t\twe went to the movies together";
    }
    // adv 00116510
    if sense == 4 {
        return "adverb\tat the same time\t\twe graduated together";
    }
    // adv 00116588
    if sense == 5 {
        return "adverb\twith cooperation and interchange\tunitedly\twe worked together on the project";
    }
    // adj 01586194
    if sense == 6 {
        return "adjective\tmentally and emotionally stable\t\tshe's really together";
    }
    // adv 00116705
    if sense == 7 {
        return "adverb\twith a common plan\tin concert\t";
    }
    ""
}
