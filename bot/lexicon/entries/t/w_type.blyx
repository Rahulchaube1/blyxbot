// type — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_type(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 05840188
    if sense == 1 {
        return "noun\ta subdivision of a particular kind of thing\t\twhat type of sculpture do you prefer?";
    }
    // noun 09909060
    if sense == 2 {
        return "noun\ta person of a specified kind (usually with many eccentricities)\tcharacter, eccentric, case\tthe capable type";
    }
    // verb 01004692
    if sense == 3 {
        return "verb\twrite by means of a keyboard with types\ttypewrite\ttype the acceptance letter, please";
    }
    // verb 00618682
    if sense == 4 {
        return "verb\tidentify as belonging to a certain type\ttypecast\tSuch people can practically be typed";
    }
    ""
}
