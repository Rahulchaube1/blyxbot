// joy — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_joy(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07527352
    if sense == 1 {
        return "noun\tthe emotion of great happiness\tjoyousness, joyfulness\t";
    }
    // noun 05829782
    if sense == 2 {
        return "noun\tsomething or someone that provides a source of happiness\tdelight, pleasure\ta joy to behold";
    }
    ""
}
