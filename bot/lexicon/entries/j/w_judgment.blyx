// judgment — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_judgment(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 05837957
    if sense == 1 {
        return "noun\tan opinion formed by judging something\tjudgement, mind\the was reluctant to make his judgment known";
    }
    // noun 00874067
    if sense == 2 {
        return "noun\tthe act of judging or assessing a person or situation or event\tjudgement, assessment\tthey criticized my judgment of the contestants";
    }
    // noun 01187810
    if sense == 3 {
        return "noun\t(law) the determination by a court of competent jurisdiction on matters submitted to it\tjudgement, judicial decision\t";
    }
    // noun 05789432
    if sense == 4 {
        return "noun\tthe cognitive process of reaching a decision or drawing conclusions\tjudgement, judging\t";
    }
    // noun 06551784
    if sense == 5 {
        return "noun\tthe legal document stating the reasons for a judicial decision\topinion, legal opinion, judgement\t";
    }
    // noun 04892084
    if sense == 6 {
        return "noun\tthe capacity to assess situations or circumstances shrewdly and to draw sound conclusions\tjudgement, sound judgment, sound judgement, perspicacity\t";
    }
    ""
}
