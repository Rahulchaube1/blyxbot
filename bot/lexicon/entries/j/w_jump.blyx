// jump — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_jump(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 01963942
    if sense == 1 {
        return "verb\tmove forward by leaps and bounds\tleap, bound, spring\tCan you jump over the fence?";
    }
    // verb 01910373
    if sense == 2 {
        return "verb\tmove or jump suddenly, as if in surprise or alarm\tstartle, start\t";
    }
    // verb 01121178
    if sense == 3 {
        return "verb\tmake a sudden physical attack on\t\tThe muggers jumped the woman in the fur coat";
    }
    // verb 00155727
    if sense == 4 {
        return "verb\tincrease suddenly and significantly\t\tPrices jumped overnight";
    }
    // verb 02674564
    if sense == 5 {
        return "verb\tbe highly noticeable\tleap out, jump out, stand out, stick out\t";
    }
    // verb 01082937
    if sense == 6 {
        return "verb\tenter eagerly into\t\tHe jumped into the game";
    }
    // verb 00155547
    if sense == 7 {
        return "verb\trise in rank or status\trise, climb up\tHer new novel jumped high on the bestseller list";
    }
    ""
}
