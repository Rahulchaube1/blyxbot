// jew — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_jew(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 09681351
    if sense == 1 {
        return "noun\ta person belonging to the worldwide group claiming descent from Jacob (or converted to it) and connected by cultural or religious ties\tHebrew, Israelite\t";
    }
    ""
}
