// admire — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_admire(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 01827858
    if sense == 1 {
        return "verb\tfeel admiration for\tlook up to\t";
    }
    // verb 02164694
    if sense == 2 {
        return "verb\tlook at with admiration\t\t";
    }
    ""
}
