// arrive — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_arrive(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // verb 02005948
    if sense == 1 {
        return "verb\treach a destination; arrive by movement or progress\tget, come\tShe arrived home at 7 o'clock";
    }
    ""
}
