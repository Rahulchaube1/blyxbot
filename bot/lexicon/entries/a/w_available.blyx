// available — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_available(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 00183053
    if sense == 1 {
        return "adjective\tobtainable or accessible and ready for use or service\t\tkept a fire extinguisher available";
    }
    ""
}
