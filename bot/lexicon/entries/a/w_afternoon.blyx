// afternoon — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_afternoon(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 15166191
    if sense == 1 {
        return "noun\tthe part of the day between noon and evening\t\the spent a quiet afternoon in the park";
    }
    // noun 06632807
    if sense == 2 {
        return "noun\ta conventional expression of greeting or farewell\tgood afternoon\t";
    }
    ""
}
