// at all — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_at_all(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00056729
    if sense == 1 {
        return "adverb\tin the slightest degree or in any respect\tin the least, the least bit\tAre you at all interested? No, not at all";
    }
    ""
}
