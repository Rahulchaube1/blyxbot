// always — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_always(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00019339
    if sense == 1 {
        return "adverb\tat all times; all the time and on every occasion\tever, e'er\tI will always be there to help you";
    }
    ""
}
