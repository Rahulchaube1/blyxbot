// about — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_about(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // adv 00007015
    if sense == 1 {
        return "adverb\t(of quantities) imprecise but fairly close to correct\tapproximately, close to, just about, some, roughly, more or less, around, or so\tin just about a minute";
    }
    // adv 00071840
    if sense == 2 {
        return "adverb\tall around or on all sides\taround\tdirty clothes lying around (or about)";
    }
    // adv 00071165
    if sense == 3 {
        return "adverb\tin the area or vicinity\taround\ta few spectators standing about";
    }
    // adv 00072329
    if sense == 4 {
        return "adverb\tused of movement to or among many different places or in no particular direction\taround\twandering about with no place to go";
    }
    // adv 00072201
    if sense == 5 {
        return "adverb\tin or to a reversed position or direction\taround\tabout face";
    }
    // adv 00358114
    if sense == 6 {
        return "adverb\tin rotation or succession\t\tturn about is fair play";
    }
    // adv 00073033
    if sense == 7 {
        return "adverb\t(of actions or states) slightly short of or not quite accomplished; all but\talmost, most, nearly, near, nigh, virtually, well-nigh\tthe job is (just) about done";
    }
    ""
}
