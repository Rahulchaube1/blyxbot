// anti-semitism — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_anti_hyphen_semitism(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 06203956
    if sense == 1 {
        return "noun\tthe intense dislike for and prejudice against Jewish people\tantisemitism\t";
    }
    ""
}
