// allow — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_allow(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // verb 02423183
    if sense == 1 {
        return "verb\tmake it possible through a specific action or lack of action for something to happen\tlet, permit\tThis sealed door won't allow the water come into the basement";
    }
    // verb 00802318
    if sense == 2 {
        return "verb\tconsent to, give permission\tpermit, let, countenance\tI cannot allow you to see your exam";
    }
    // verb 02255462
    if sense == 3 {
        return "verb\tlet have\tgrant\tMandela was allowed few visitors in prison";
    }
    // verb 00724150
    if sense == 4 {
        return "verb\tgive or assign a resource to a particular person or cause\tappropriate, earmark, set aside, reserve\t";
    }
    // verb 02721438
    if sense == 5 {
        return "verb\tmake a possibility or provide opportunity for; permit to be attainable or cause to remain\tleave, allow for, provide\tThe evidence allows only one conclusion";
    }
    // verb 00723545
    if sense == 6 {
        return "verb\tallow or plan for a certain possibility; concede the truth or validity of something\ttake into account\tI allow for this possibility";
    }
    ""
}
