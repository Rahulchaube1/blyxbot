// amount — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_amount(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 13331198
    if sense == 1 {
        return "noun\ta quantity of money\tsum, sum of money, amount of money\tthe amount he had in cash was insufficient";
    }
    // noun 05107765
    if sense == 2 {
        return "noun\tthe relative magnitude of something with reference to a criterion\t\tan adequate amount of food for four people";
    }
    // noun 00033615
    if sense == 3 {
        return "noun\thow much there is or how many there are of something that you can quantify\tmeasure, quantity\t";
    }
    // verb 02664992
    if sense == 4 {
        return "verb\tbe tantamount or equivalent to\t\tHer action amounted to a rebellion";
    }
    // noun 05861067
    if sense == 5 {
        return "noun\ta quantity obtained by the addition of a group of numbers\tsum, total\t";
    }
    // verb 02645007
    if sense == 6 {
        return "verb\tadd up in number or quantity\ttotal, number, add up, come\tThe bills amounted to $2,000";
    }
    // verb 02627363
    if sense == 7 {
        return "verb\tdevelop into\tcome, add up\tThis idea will never amount to anything";
    }
    ""
}
