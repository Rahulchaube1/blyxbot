// afford — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_afford(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 01192628
    if sense == 1 {
        return "verb\tbe able to spare or give up\t\tI can't afford to spend two hours with this person";
    }
    // verb 02339171
    if sense == 2 {
        return "verb\tbe the cause or source of\tyield, give\tOur meeting afforded much interesting information";
    }
    ""
}
