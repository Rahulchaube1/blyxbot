// attain — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_attain(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02526085
    if sense == 1 {
        return "verb\tto gain with effort\tachieve, accomplish, reach\t";
    }
    // verb 02006834
    if sense == 2 {
        return "verb\treach a point in time, or a certain state or level\treach, hit\t";
    }
    ""
}
