// at least — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_at_least(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00104661
    if sense == 1 {
        return "adverb\tif nothing else (`leastwise' is informal and `leastways' is colloquial)\tleastways, leastwise, at any rate\tat least he survived";
    }
    // adv 00104345
    if sense == 2 {
        return "adverb\tnot less than\tat the least\tat least two hours studying the manual";
    }
    ""
}
