// attract — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_attract(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 01505254
    if sense == 1 {
        return "verb\tdirect toward itself or oneself by means of some psychological power or physical attributes\tpull, pull in, draw, draw in\tHer good looks attract the stares of many men";
    }
    // verb 01807882
    if sense == 2 {
        return "verb\tbe attractive to\tappeal\tThe beautiful garden attracted many people";
    }
    ""
}
