// at once — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_at_once(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00048739
    if sense == 1 {
        return "adverb\twithout delay or hesitation; with no time intervening\timmediately, instantly, straightaway, straight off, directly, now, right away, forthwith, like a shot\t";
    }
    // adv 00153261
    if sense == 2 {
        return "adverb\tsimultaneously\tat a time, at one time\t";
    }
    ""
}
