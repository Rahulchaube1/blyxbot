// appeal — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_appeal(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 07186828
    if sense == 1 {
        return "noun\tearnest or urgent request\tentreaty, prayer\tan appeal for help";
    }
    // noun 04687333
    if sense == 2 {
        return "noun\tattractiveness that interests or pleases or stimulates\tappealingness, charm\this smile was part of his appeal to her";
    }
    // noun 01185611
    if sense == 3 {
        return "noun\t(law) a legal proceeding in which the appellant resorts to a higher court for the purpose of obtaining a review of a lower court decision and a reversal of the lower court's judgment or the granting of a new trial\t\ttheir appeal was denied in the superior court";
    }
    // verb 02497586
    if sense == 4 {
        return "verb\ttake a court case to a higher court for review\t\tHe was found guilty but appealed immediately";
    }
    // verb 00755447
    if sense == 5 {
        return "verb\trequest earnestly (something from somebody); ask for aid or protection\tinvoke\tappeal to somebody for help";
    }
    // verb 01807882
    if sense == 6 {
        return "verb\tbe attractive to\tattract\tThe idea of a vacation appeals to me";
    }
    ""
}
