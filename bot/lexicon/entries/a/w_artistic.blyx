// artistic — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_artistic(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 02991122
    if sense == 1 {
        return "adjective\trelating to or characteristic of art or artists\t\this artistic background";
    }
    // adj 00069948
    if sense == 2 {
        return "adjective\tsatisfying aesthetic standards and sensibilities\t\tartistic workmanship";
    }
    ""
}
