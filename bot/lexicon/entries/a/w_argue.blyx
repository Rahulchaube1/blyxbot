// argue — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_argue(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00772189
    if sense == 1 {
        return "verb\tpresent reasons and arguments\treason\t";
    }
    // verb 00773432
    if sense == 2 {
        return "verb\thave an argument about something\tcontend, debate, fence\t";
    }
    ""
}
