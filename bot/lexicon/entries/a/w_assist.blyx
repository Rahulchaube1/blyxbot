// assist — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_assist(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // verb 02547586
    if sense == 1 {
        return "verb\tgive help or assistance; be of service\thelp, aid\t";
    }
    // verb 02414710
    if sense == 2 {
        return "verb\tact as an assistant in a subordinate or supportive function\t\t";
    }
    // noun 01207609
    if sense == 3 {
        return "noun\tthe activity of contributing to the fulfillment of a need or furtherance of an effort or purpose\taid, assistance, help\the gave me an assist with the housework";
    }
    // noun 00558008
    if sense == 4 {
        return "noun\t(sports) the act of enabling another player to make a good play\t\t";
    }
    ""
}
