// at the same time — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_at_the_same_time(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00120095
    if sense == 1 {
        return "adverb\tat the same instant\tsimultaneously\t";
    }
    // adv 00120223
    if sense == 2 {
        return "adverb\toverlapping in duration\tconcurrently\tgoing to school and holding a job at the same time";
    }
    ""
}
