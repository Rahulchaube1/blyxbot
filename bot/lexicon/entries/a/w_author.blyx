// author — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_author(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10794014
    if sense == 1 {
        return "noun\twrites (books or stories or articles or the like) professionally (for pay)\twriter\t";
    }
    // noun 10126177
    if sense == 2 {
        return "noun\tsomeone who originates or causes or initiates something\tgenerator, source\t";
    }
    ""
}
