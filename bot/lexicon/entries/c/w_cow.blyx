// cow — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_cow(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 02403454
    if sense == 1 {
        return "noun\tfemale of domestic cattle: \"`moo-cow' is a child's term\"\tmoo-cow\t";
    }
    // noun 01887787
    if sense == 2 {
        return "noun\tmature female of mammals of which the male is called `bull'\t\t";
    }
    ""
}
