// constitute — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_constitute(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02620587
    if sense == 1 {
        return "verb\tform or compose\trepresent, make up, comprise, be\tThese constitute my entire belonging";
    }
    // verb 02396205
    if sense == 2 {
        return "verb\tcreate and charge with a task or function\tappoint, name, nominate\t";
    }
    ""
}
