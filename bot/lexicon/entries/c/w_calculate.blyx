// calculate — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_calculate(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00637259
    if sense == 1 {
        return "verb\tmake a mathematical calculation or computation\tcipher, cypher, compute, work out, reckon, figure\t";
    }
    // verb 00712135
    if sense == 2 {
        return "verb\tjudge to be probable\testimate, reckon, count on, figure, forecast\t";
    }
    ""
}
