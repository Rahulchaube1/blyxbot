// certainly — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_certainly(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00144722
    if sense == 1 {
        return "adverb\tdefinitely or positively (`sure' is sometimes used informally for `surely')\tsurely, sure, for sure, for certain, sure enough, sure as shooting\tshe certainly is a hard worker";
    }
    ""
}
