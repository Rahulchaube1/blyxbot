// complain — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_complain(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // verb 00907147
    if sense == 1 {
        return "verb\texpress complaints, discontent, displeasure, or unhappiness\tkick, plain, sound off, quetch, kvetch\tMy mother complains all day";
    }
    ""
}
