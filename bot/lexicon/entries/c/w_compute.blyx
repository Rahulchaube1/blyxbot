// compute — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_compute(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // verb 00637259
    if sense == 1 {
        return "verb\tmake a mathematical calculation or computation\tcalculate, cipher, cypher, work out, reckon, figure\t";
    }
    ""
}
