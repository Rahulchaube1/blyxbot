// charge — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_charge(sense: i64) -> str {
    if sense == 0 { return "16"; }
    // noun 00974762
    if sense == 1 {
        return "noun\tan impetuous rush toward someone or something\t\tthe wrestler's charge carried him past his adversary";
    }
    // verb 01121719
    if sense == 2 {
        return "verb\tto make a rush at or sudden attack upon, as in battle\tbear down\the saw Jess charging at him with a pitchfork";
    }
    // noun 06561942
    if sense == 3 {
        return "noun\t(criminal law) a pleading describing some wrong or offense\tcomplaint\the was arrested on a charge of larceny";
    }
    // verb 00843468
    if sense == 4 {
        return "verb\tblame for, make a claim of wrongdoing or misbehavior against\taccuse\the charged the director with indifference";
    }
    // verb 02320374
    if sense == 5 {
        return "verb\tdemand payment\tbill\tWill I get charged for this service?";
    }
    // verb 02055267
    if sense == 6 {
        return "verb\tmove quickly and violently\ttear, shoot, shoot down, buck\tHe came charging into my office";
    }
    // noun 13306870
    if sense == 7 {
        return "noun\tthe price charged for some article or service\t\tthe admission charge";
    }
    // verb 02475922
    if sense == 8 {
        return "verb\tassign a duty, responsibility or obligation to\tappoint\tShe was charged with supervising the creation of a concordance";
    }
    // noun 11435028
    if sense == 9 {
        return "noun\tthe quantity of unbalanced electricity in a body (either positive or negative) and construed as an excess or deficiency of electrons\telectric charge\tthe battery needed a fresh charge";
    }
    // verb 00869931
    if sense == 10 {
        return "verb\tfile a formal charge against\tlodge, file\tThe suspect was charged with murdering his wife";
    }
    // verb 00843959
    if sense == 11 {
        return "verb\tmake an accusatory claim\t\tThe defense attorney charged that the jurors were biased";
    }
    // noun 00829378
    if sense == 12 {
        return "noun\tattention and management implying responsibility for safety\tcare, tutelage, guardianship\t";
    }
    // noun 00731222
    if sense == 13 {
        return "noun\ta special assignment that is given to a person or group\tmission, commission\this charge was deliver a message";
    }
    // verb 01488956
    if sense == 14 {
        return "verb\tfill or load to capacity\t\tcharge the wagon with hay";
    }
    // noun 09909760
    if sense == 15 {
        return "noun\ta person committed to your care\t\tthe teacher led her charges across the street";
    }
    // verb 02321046
    if sense == 16 {
        return "verb\tenter a certain amount as a charge\t\the charged me $15";
    }
    ""
}
