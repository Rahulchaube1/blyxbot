// conversation — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_conversation(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 07133701
    if sense == 1 {
        return "noun\tthe use of speech for informal exchange of views or ideas or information etc.\t\t";
    }
    ""
}
