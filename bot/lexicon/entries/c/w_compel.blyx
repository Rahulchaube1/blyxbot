// compel — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_compel(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // verb 02506546
    if sense == 1 {
        return "verb\tforce somebody to do something\toblige, obligate\tWe compel all students to fill out this form";
    }
    ""
}
