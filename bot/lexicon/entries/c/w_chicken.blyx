// chicken — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_chicken(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07644967
    if sense == 1 {
        return "noun\tthe flesh of a chicken used for food\tpoulet, volaille\t";
    }
    // noun 01791625
    if sense == 2 {
        return "noun\ta domestic fowl bred for flesh or eggs; believed to have been developed from the red jungle fowl\tGallus gallus\t";
    }
    ""
}
