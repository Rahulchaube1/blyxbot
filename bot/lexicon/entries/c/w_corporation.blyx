// corporation — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_corporation(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 08059412
    if sense == 1 {
        return "noun\ta business firm whose articles of incorporation have been approved in some state\tcorp\t";
    }
    ""
}
