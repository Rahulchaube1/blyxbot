// comedy — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_comedy(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07015510
    if sense == 1 {
        return "noun\tlight and humorous drama with a happy ending\t\t";
    }
    // noun 06781383
    if sense == 2 {
        return "noun\ta comic incident or series of incidents\tdrollery, clowning, funniness\t";
    }
    ""
}
