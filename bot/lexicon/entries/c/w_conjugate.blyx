// conjugate — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_conjugate(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 14820425
    if sense == 1 {
        return "noun\ta mixture of two partially miscible liquids A and B produces two conjugate solutions: one of A in B and another of B in A\tconjugate solution\t";
    }
    // verb 00396513
    if sense == 2 {
        return "verb\tunite chemically so that the product is easily broken down into the original compounds\t\t";
    }
    ""
}
