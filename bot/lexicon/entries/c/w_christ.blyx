// christ — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_christ(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 11083656
    if sense == 1 {
        return "noun\ta teacher and prophet born in Bethlehem and active in Nazareth; his life and sermons form the basis for Christianity (circa 4 BC - AD 29)\tJesus, Jesus of Nazareth, the Nazarene, Jesus Christ, Savior, Saviour, Good Shepherd, Redeemer, Deliverer\t";
    }
    ""
}
