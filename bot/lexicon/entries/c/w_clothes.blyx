// clothes — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_clothes(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 02728440
    if sense == 1 {
        return "noun\tclothing in general\tapparel, wearing apparel, dress\the always bought his clothes at the same store";
    }
    ""
}
