// credit — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_credit(sense: i64) -> str {
    if sense == 0 { return "10"; }
    // noun 06688274
    if sense == 1 {
        return "noun\tapproval\trecognition\the was given credit for his work";
    }
    // noun 13378518
    if sense == 2 {
        return "noun\tmoney available for a client to borrow\t\t";
    }
    // noun 13405646
    if sense == 3 {
        return "noun\tan accounting entry acknowledging income or capital items\tcredit entry\t";
    }
    // verb 00727143
    if sense == 4 {
        return "verb\tgive someone credit for something\t\tWe credited her for saving our jobs";
    }
    // noun 00037200
    if sense == 5 {
        return "noun\tused in the phrase `to your credit' in order to indicate an achievement deserving praise\t\tshe already had several performances to her credit";
    }
    // verb 00727791
    if sense == 6 {
        return "verb\tascribe an achievement to\taccredit\tShe was not properly credited in the program";
    }
    // noun 13374281
    if sense == 7 {
        return "noun\tarrangement for deferred payment for goods and services\tdeferred payment\t";
    }
    // verb 02264752
    if sense == 8 {
        return "verb\taccounting: enter as credit\t\tWe credit your account with $100";
    }
    // noun 00065855
    if sense == 9 {
        return "noun\trecognition by a college or university that a course of studies has been successfully completed; typically measured in semester hours\tcourse credit\t";
    }
    // verb 00683930
    if sense == 10 {
        return "verb\thave trust in; trust in the truth or veracity of\t\t";
    }
    ""
}
