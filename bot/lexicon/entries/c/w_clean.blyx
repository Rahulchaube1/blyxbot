// clean — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_clean(sense: i64) -> str {
    if sense == 0 { return "11"; }
    // adj 00417413
    if sense == 1 {
        return "adjective\tfree from dirt or impurities; or having clean habits\t\tchildren with clean shining faces";
    }
    // verb 01532589
    if sense == 2 {
        return "verb\tmake clean by removing dirt, filth, or unwanted substances from\tmake clean\tClean the stove!";
    }
    // verb 00177714
    if sense == 3 {
        return "verb\tremove unwanted substances from, such as feathers or pits\tpick\tClean the turkey";
    }
    // verb 01533442
    if sense == 4 {
        return "verb\tclean and tidy up the house\thouseclean, clean house\t";
    }
    // adj 01914108
    if sense == 5 {
        return "adjective\tfree of restrictions or qualifications\tclear\ta clean bill of health";
    }
    // noun 00626838
    if sense == 6 {
        return "noun\ta weightlift in which the barbell is lifted to shoulder height and then jerked overhead\tclean and jerk\t";
    }
    // verb 00035758
    if sense == 7 {
        return "verb\tclean one's body or parts thereof, as by washing\tcleanse\tclean up before you see your grandparents";
    }
    // adj 01906464
    if sense == 8 {
        return "adjective\t(of sound or color) free from anything that dulls or dims\tclear, light, unclouded\tefforts to obtain a clean bass in orchestral recordings";
    }
    // adj 01906320
    if sense == 9 {
        return "adjective\tfree from impurities\tfresh\tclean water";
    }
    // adj 01749915
    if sense == 10 {
        return "adjective\t(of a record) having no marks of discredit or offense\t\ta clean voting record";
    }
    // adv 00009373
    if sense == 11 {
        return "adverb\tcompletely; used as intensifiers\tplumb, plum\tclean forgot the appointment";
    }
    ""
}
