// close — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_close(sense: i64) -> str {
    if sense == 0 { return "16"; }
    // adj 00446921
    if sense == 1 {
        return "adjective\tat or within a short distance in space or time or having elements near each other\t\tclose to noon";
    }
    // verb 01345109
    if sense == 2 {
        return "verb\tmove so that an opening or passage is obstructed; make shut\tshut\tClose the door";
    }
    // adj 00451510
    if sense == 3 {
        return "adjective\tclose in relevance or relationship\t\ta close family";
    }
    // verb 01346978
    if sense == 4 {
        return "verb\tbecome closed\tshut\tThe windows closed with a loud bang";
    }
    // verb 02426395
    if sense == 5 {
        return "verb\tcease to operate or cause to cease operating\tclose up, fold, shut down, close down\tThe owners decided to move and to close the factory";
    }
    // adv 00409709
    if sense == 6 {
        return "adverb\tnear in time or place or relationship\tnear, nigh\tthe bullet didn't come close";
    }
    // verb 02425913
    if sense == 7 {
        return "verb\tfinish or terminate (meetings, speeches, etc.)\t\tThe meeting was closed with a charge by the chairman of the board";
    }
    // noun 15267536
    if sense == 8 {
        return "noun\tthe temporal end; the concluding time\tstopping point, finale, finis, finish, last, conclusion\tthey were playing better at the close of the season";
    }
    // adj 00444519
    if sense == 9 {
        return "adjective\tnot far distant in time or space or degree or circumstances\tnear, nigh\tshe was close to tears";
    }
    // adj 00309945
    if sense == 10 {
        return "adjective\trigorously attentive; strict and thorough\t\tclose supervision";
    }
    // adv 00505226
    if sense == 11 {
        return "adverb\tin an attentive manner\tclosely, tight\the remained close on his guard";
    }
    // adj 00022219
    if sense == 12 {
        return "adjective\tmarked by fidelity to an original\tfaithful\ta close translation";
    }
    // verb 02610628
    if sense == 13 {
        return "verb\tcome to a close\tconclude\tThe concert closed with a nocturne by Chopin";
    }
    // adj 00890622
    if sense == 14 {
        return "adjective\t(of a contest or contestants) evenly matched\ttight\ta close contest";
    }
    // verb 00763831
    if sense == 15 {
        return "verb\tcomplete a business deal, negotiation, or an agreement\t\tWe closed on the house on Friday";
    }
    // adj 00558738
    if sense == 16 {
        return "adjective\tcrowded\tconfining\tclose quarters";
    }
    ""
}
