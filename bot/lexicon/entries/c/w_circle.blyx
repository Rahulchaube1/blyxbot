// circle — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_circle(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 13873502
    if sense == 1 {
        return "noun\tellipse in which the two axes are of equal length; a plane curve generated by one point moving at a constant distance from a fixed point\t\the calculated the circumference of the circle";
    }
    // noun 08240169
    if sense == 2 {
        return "noun\tan unofficial association of people or groups\tset, band, lot\t";
    }
    // verb 01911339
    if sense == 3 {
        return "verb\ttravel around something\t\tcircle the globe";
    }
    // noun 13873917
    if sense == 4 {
        return "noun\tsomething approximating the shape of a circle\t\tthe chairs were arranged in a circle";
    }
    // verb 02044278
    if sense == 5 {
        return "verb\tmove in circles\tcirculate\t";
    }
    // noun 00295172
    if sense == 6 {
        return "noun\tmovement once around a course\tlap, circuit\t";
    }
    ""
}
