// concrete — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_concrete(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 14820180
    if sense == 1 {
        return "noun\ta strong hard building material composed of sand and gravel and cement and water\t\t";
    }
    // adj 00013160
    if sense == 2 {
        return "adjective\tcapable of being perceived by the senses; not abstract or imaginary\t\tconcrete objects such as trees";
    }
    ""
}
