// cause — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_cause(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 01645601
    if sense == 1 {
        return "verb\tgive rise to; cause to happen or occur, not always intentionally\tdo, make\tcause a commotion";
    }
    // verb 00770437
    if sense == 2 {
        return "verb\tcause to do; cause to act in a specified manner\tinduce, stimulate, have, get, make\t";
    }
    // noun 07326557
    if sense == 3 {
        return "noun\tevents that provide the generative force that is the origin of something\t\tthey are trying to determine the cause of the crash";
    }
    // noun 06740402
    if sense == 4 {
        return "noun\ta justification for something existing or happening\treason, grounds\the had no cause to complain";
    }
    // noun 00798245
    if sense == 5 {
        return "noun\ta series of actions advancing a principle or tending toward a particular end\tcampaign, crusade, drive, movement, effort\tthey worked in the cause of world peace";
    }
    // noun 00007347
    if sense == 6 {
        return "noun\tany entity that produces an effect or is responsible for events or results\tcausal agent, causal agency\t";
    }
    // noun 01182654
    if sense == 7 {
        return "noun\ta comprehensive term for any proceeding in a court of law whereby an individual seeks a legal remedy\tlawsuit, suit, case, causa\t";
    }
    ""
}
