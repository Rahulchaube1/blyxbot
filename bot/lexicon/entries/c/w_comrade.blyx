// comrade — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_comrade(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 09945905
    if sense == 1 {
        return "noun\ta friend who is frequently in the company of another\tcompanion, fellow, familiar, associate\tcomrades in arms";
    }
    ""
}
