// car — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_car(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 02958343
    if sense == 1 {
        return "noun\ta motor vehicle with four wheels; usually propelled by an internal combustion engine\tauto, automobile, machine, motorcar\the needs a car to get to work";
    }
    // noun 02959942
    if sense == 2 {
        return "noun\ta wheeled vehicle adapted to the rails of railroad\trailcar, railway car, railroad car\tthree cars had jumped the rails";
    }
    ""
}
