// chief — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_chief(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // adj 01277426
    if sense == 1 {
        return "adjective\tmost important element\tmain, primary, principal, master\tthe chief aim of living";
    }
    // noun 10162991
    if sense == 2 {
        return "noun\ta person who is in charge\thead, top dog\t";
    }
    // noun 10104209
    if sense == 3 {
        return "noun\ta person who exercises control over workers\tforeman, gaffer, honcho, boss\t";
    }
    ""
}
