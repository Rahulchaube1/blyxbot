// colonel — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_colonel(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 09937250
    if sense == 1 {
        return "noun\ta commissioned military officer in the United States Army or Air Force or Marines who ranks above a lieutenant colonel and below a brigadier general\t\t";
    }
    ""
}
