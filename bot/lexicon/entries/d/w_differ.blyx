// differ — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_differ(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02666239
    if sense == 1 {
        return "verb\tbe different\t\tThese two tests differ in only one respect";
    }
    // verb 00804802
    if sense == 2 {
        return "verb\tbe of different opinions\tdisagree, dissent, take issue\tI beg to differ!";
    }
    ""
}
