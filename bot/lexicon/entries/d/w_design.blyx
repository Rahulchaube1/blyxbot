// design — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_design(sense: i64) -> str {
    if sense == 0 { return "10"; }
    // verb 01638368
    if sense == 1 {
        return "verb\tmake or work out a plan for; devise\tplan, project, contrive\tdesign a new sales strategy";
    }
    // verb 00709625
    if sense == 2 {
        return "verb\tplan something for a specific role or purpose or effect\t\tThis room is not designed for work";
    }
    // verb 01640550
    if sense == 3 {
        return "verb\tcreate the design for; create or execute in an artistic or highly skilled manner\t\tChanel designed the famous suit";
    }
    // noun 00928077
    if sense == 4 {
        return "noun\tthe act of working out the form of something (as by making a sketch or outline or plan)\tdesigning\the contributed to the design of a new instrument";
    }
    // noun 05728678
    if sense == 5 {
        return "noun\tan arrangement scheme\tplan\tthe awkward design of the keyboard made operation difficult";
    }
    // verb 01639714
    if sense == 6 {
        return "verb\tmake a design of; plan out in systematic, often graphic form\tplan\tdesign a better mousetrap";
    }
    // noun 05902327
    if sense == 7 {
        return "noun\tsomething intended as a guide for making something else\tblueprint, pattern\t";
    }
    // noun 03178782
    if sense == 8 {
        return "noun\ta decorative or artistic work\tpattern, figure\tthe coach had a design on the doors";
    }
    // noun 05982152
    if sense == 9 {
        return "noun\tan anticipated outcome that is intended or that guides your planned actions\tpurpose, intent, intention, aim\the made no secret of his designs";
    }
    // noun 03179318
    if sense == 10 {
        return "noun\ta preliminary sketch indicating the plan for something\t\tthe design of a building";
    }
    ""
}
