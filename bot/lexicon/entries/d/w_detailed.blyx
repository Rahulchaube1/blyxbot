// detailed — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_detailed(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 00310433
    if sense == 1 {
        return "adjective\tdeveloped or executed with care and in minute detail\telaborate, elaborated\ta detailed plan";
    }
    ""
}
