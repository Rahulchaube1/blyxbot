// delay — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_delay(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // verb 00459776
    if sense == 1 {
        return "verb\tcause to be slowed down or delayed\tdetain, hold up\tTraffic was delayed by the bad weather";
    }
    // verb 02641957
    if sense == 2 {
        return "verb\tact later than planned, scheduled, or required\t\tDon't delay your application to graduate school or else it won't be considered";
    }
    // verb 00460900
    if sense == 3 {
        return "verb\tstop or halt\tstay, detain\t";
    }
    // noun 15272029
    if sense == 4 {
        return "noun\ttime during which some action is awaited\thold, time lag, postponement, wait\tinstant replay caused too long a delay";
    }
    // noun 01066163
    if sense == 5 {
        return "noun\tthe act of delaying; inactivity resulting in something being put off until a later time\tholdup\t";
    }
    ""
}
