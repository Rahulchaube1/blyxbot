// dollar — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_dollar(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 13661273
    if sense == 1 {
        return "noun\tthe basic monetary unit in many countries; equal to 100 cents\t\t";
    }
    // noun 13395897
    if sense == 2 {
        return "noun\ta piece of paper money worth one dollar\tdollar bill, one dollar bill, buck, clam\t";
    }
    ""
}
