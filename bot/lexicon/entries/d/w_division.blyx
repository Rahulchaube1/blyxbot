// division — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_division(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // noun 08213205
    if sense == 1 {
        return "noun\tan army unit large enough to sustain combat\t\ttwo infantry divisions were held in reserve";
    }
    // noun 05867413
    if sense == 2 {
        return "noun\tone of the portions into which something is regarded as divided and which together constitute a whole\tpart, section\tthe BBC's engineering division";
    }
    // noun 00385791
    if sense == 3 {
        return "noun\tthe act or process of dividing\t\t";
    }
    // noun 08220714
    if sense == 4 {
        return "noun\tan administrative unit in government or business\t\t";
    }
    // noun 07181842
    if sense == 5 {
        return "noun\tdiscord that splits a group\tvariance\t";
    }
    ""
}
