// department — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_department(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 08114861
    if sense == 1 {
        return "noun\ta specialized division of a large organization\tsection\tyou'll find it in the hardware department";
    }
    ""
}
