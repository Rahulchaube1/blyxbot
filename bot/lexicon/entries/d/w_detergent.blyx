// detergent — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_detergent(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 15097017
    if sense == 1 {
        return "noun\ta surface-active chemical widely used in industry and laundering\t\t";
    }
    // noun 03181899
    if sense == 2 {
        return "noun\ta cleansing agent that differs from soap but can also emulsify oils and hold dirt in suspension\t\t";
    }
    ""
}
