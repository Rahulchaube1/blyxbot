// dictionary — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_dictionary(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 06418901
    if sense == 1 {
        return "noun\ta reference book containing an alphabetical list of words with information about them\tlexicon\t";
    }
    ""
}
