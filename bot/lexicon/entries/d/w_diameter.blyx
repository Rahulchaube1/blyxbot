// diameter — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_diameter(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 05101815
    if sense == 1 {
        return "noun\tthe length of a straight line passing through the center of a circle and connecting two points on the circumference\tdiam\t";
    }
    // noun 13871717
    if sense == 2 {
        return "noun\ta straight line connecting the center of a circle with two points on its perimeter (or the center of a sphere with two points on its surface)\t\t";
    }
    ""
}
