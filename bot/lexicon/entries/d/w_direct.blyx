// direct — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_direct(sense: i64) -> str {
    if sense == 0 { return "13"; }
    // adj 00760916
    if sense == 1 {
        return "adjective\tdirect in spatial dimensions; proceeding without deviation or interruption; straight and short\t\ta direct route";
    }
    // verb 00749205
    if sense == 2 {
        return "verb\tcommand with authority\t\tHe directed the children to do their homework";
    }
    // verb 01150559
    if sense == 3 {
        return "verb\tintend (something) to move towards a certain goal\ttarget, aim, place, point\tcriticism directed at her superior";
    }
    // adj 00770480
    if sense == 4 {
        return "adjective\thaving no intervening persons, agents, conditions\tunmediated\tin direct sunlight";
    }
    // verb 01710317
    if sense == 5 {
        return "verb\tguide the actors in (plays and films)\t\t";
    }
    // verb 02439501
    if sense == 6 {
        return "verb\tbe in charge of\t\t";
    }
    // verb 01999798
    if sense == 7 {
        return "verb\ttake somebody somewhere\tlead, take, conduct, guide\t";
    }
    // verb 01951480
    if sense == 8 {
        return "verb\tcause to go somewhere\tsend\tHe directed all his energies into his dissertation";
    }
    // verb 01151110
    if sense == 9 {
        return "verb\tpoint or cause to go (blows, weapons, or objects such as photographic equipment) towards\taim, take, train, take aim\t";
    }
    // adj 00763901
    if sense == 10 {
        return "adjective\tstraightforward in means or manner or behavior or language or action\t\ta direct question";
    }
    // verb 01732921
    if sense == 11 {
        return "verb\tlead, as in the performance of a composition\tconduct, lead\t";
    }
    // verb 00749376
    if sense == 12 {
        return "verb\tgive directions to; point somebody into a certain direction\t\tI directed them towards the town hall";
    }
    // verb 00713015
    if sense == 13 {
        return "verb\tspecifically design a product, event, or activity for a certain public\tcalculate, aim\t";
    }
    ""
}
