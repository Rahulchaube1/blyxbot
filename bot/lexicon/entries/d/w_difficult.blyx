// difficult — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_difficult(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 00744916
    if sense == 1 {
        return "adjective\tnot easy; requiring great physical or mental effort to accomplish or comprehend or endure\thard\ta difficult task";
    }
    ""
}
