// devote — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_devote(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00887463
    if sense == 1 {
        return "verb\tgive entirely to a specific person, activity, or cause\tgive, dedicate, consecrate, commit\t";
    }
    // verb 00732224
    if sense == 2 {
        return "verb\tdedicate\tgive, pay\t";
    }
    ""
}
