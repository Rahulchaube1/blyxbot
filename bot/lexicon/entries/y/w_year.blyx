// year — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_year(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 15203791
    if sense == 1 {
        return "noun\ta period of time containing 365 (or 366) days\ttwelvemonth, yr\tshe is 4 years old";
    }
    // noun 15204297
    if sense == 2 {
        return "noun\ta period of time occupying a regular part of a calendar year that is used for some particular activity\t\ta school year";
    }
    // noun 15201505
    if sense == 3 {
        return "noun\tthe period of time that it takes for a planet (as, e.g., Earth or Mars) to make a complete revolution around the sun\t\ta Martian year takes 687 of our days";
    }
    // noun 08238660
    if sense == 4 {
        return "noun\ta body of students who graduate together\tclass\tshe was in my year at Hoehandle High";
    }
    ""
}
