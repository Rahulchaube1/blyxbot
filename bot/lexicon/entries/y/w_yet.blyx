// yet — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_yet(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // adv 00027795
    if sense == 1 {
        return "adverb\tup to the present time\t\tI have yet to see the results";
    }
    // adv 00027918
    if sense == 2 {
        return "adverb\tused in negative statement to describe a situation that has existed up to this point or up to the present time\tso far, thus far, up to now, hitherto, heretofore, as yet, til now, until now\tthe sun isn't up yet";
    }
    // adv 00017639
    if sense == 3 {
        return "adverb\tto a greater degree or extent; used with comparisons\teven, still\ta yet sadder tale";
    }
    ""
}
