// ultimate — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_ultimate(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 01578312
    if sense == 1 {
        return "adjective\tfurthest or highest in degree or order; utmost or extreme\t\tthe ultimate achievement";
    }
    // adj 01013961
    if sense == 2 {
        return "adjective\tbeing the last or concluding element of a series\t\tthe ultimate sonata of that opus";
    }
    ""
}
