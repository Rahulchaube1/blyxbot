// universal — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_universal(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 00527188
    if sense == 1 {
        return "adjective\tof worldwide scope or applicability\tcosmopolitan, ecumenical, oecumenical, general, worldwide, world-wide\tuniversal experience";
    }
    ""
}
