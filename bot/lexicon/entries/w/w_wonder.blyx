// wonder — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_wonder(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // verb 00729378
    if sense == 1 {
        return "verb\thave a wish or desire to know something\tinquire, enquire\tHe wondered who had built this beautiful church";
    }
    // verb 00925110
    if sense == 2 {
        return "verb\tplace in doubt or express doubtful speculation\tquestion\tI wonder whether this was the right thing to do";
    }
    // noun 07509996
    if sense == 3 {
        return "noun\tthe feeling aroused by something strange and surprising\twonderment, admiration\t";
    }
    // noun 07289588
    if sense == 4 {
        return "noun\tsomething that causes feelings of wonder\tmarvel\tthe wonders of modern science";
    }
    // noun 05682570
    if sense == 5 {
        return "noun\ta state in which you want to learn more about something\tcuriosity\t";
    }
    // verb 00925490
    if sense == 6 {
        return "verb\tbe amazed at\tmarvel\t";
    }
    ""
}
