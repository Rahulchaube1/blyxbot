// wavelength — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_wavelength(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 05086269
    if sense == 1 {
        return "noun\tthe distance (measured in the direction of propagation) between two points in the same phase in consecutive cycles of a wave\t\t";
    }
    // noun 06208265
    if sense == 2 {
        return "noun\ta shared orientation leading to mutual understanding\t\tthey are on the same wavelength";
    }
    ""
}
