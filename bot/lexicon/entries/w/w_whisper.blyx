// whisper — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_whisper(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00915830
    if sense == 1 {
        return "verb\tspeak softly; in a low voice\t\t";
    }
    // noun 07130341
    if sense == 2 {
        return "noun\tspeaking softly without vibration of the vocal cords\twhispering, susurration, voicelessness\t";
    }
    ""
}
