// wood — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_wood(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 15098161
    if sense == 1 {
        return "noun\tthe hard fibrous lignified substance under the bark of trees\t\t";
    }
    // noun 08438533
    if sense == 2 {
        return "noun\tthe trees and other plants in a large densely wooded area\tforest, woods\t";
    }
    ""
}
