// relatively — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_relatively(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00160834
    if sense == 1 {
        return "adverb\tin a relative manner; by comparison to something else\tcomparatively\tthe situation is relatively calm now";
    }
    ""
}
