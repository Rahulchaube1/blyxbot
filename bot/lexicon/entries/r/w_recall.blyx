// recall — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_recall(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // verb 00607780
    if sense == 1 {
        return "verb\trecall knowledge from memory; have a recollection\tremember, retrieve, call back, call up, recollect, think\t";
    }
    // verb 00959524
    if sense == 2 {
        return "verb\tgo back to something earlier\thark back, return, come back\t";
    }
    // verb 02675458
    if sense == 3 {
        return "verb\tcall to mind\techo\t";
    }
    // verb 00791506
    if sense == 4 {
        return "verb\tsummon to return\tcall back\tThe ambassador was recalled to his country";
    }
    // verb 00722848
    if sense == 5 {
        return "verb\tcause one's (or someone else's) thoughts or attention to return from a reverie or digression\t\tShe was recalled by a loud laugh";
    }
    ""
}
