// remark — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_remark(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 01020005
    if sense == 1 {
        return "verb\tmake mention of\tnote, observe, mention\t";
    }
    // noun 06765044
    if sense == 2 {
        return "noun\ta statement that expresses a personal opinion or belief or adds information\tcomment, input\t";
    }
    ""
}
