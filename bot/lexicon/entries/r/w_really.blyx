// really — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_really(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00037226
    if sense == 1 {
        return "adverb\tin accordance with truth or fact or reality\ttruly, genuinely\tthey don't really listen to us";
    }
    // adv 00149510
    if sense == 2 {
        return "adverb\tin actual fact\tactually\t";
    }
    ""
}
