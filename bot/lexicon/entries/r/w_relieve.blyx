// relieve — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_relieve(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 00064095
    if sense == 1 {
        return "verb\tprovide physical relief, as from pain\talleviate, palliate, assuage\tThis pill will relieve your headaches";
    }
    // verb 02412175
    if sense == 2 {
        return "verb\tfree someone temporarily from his or her obligations\ttake over\t";
    }
    // verb 02564146
    if sense == 3 {
        return "verb\tgrant relief or an exemption from a rule or requirement to\texempt, free\t";
    }
    // verb 01815185
    if sense == 4 {
        return "verb\tlessen the intensity of or calm\tstill, allay, ease\t";
    }
    // verb 02550868
    if sense == 5 {
        return "verb\tsave from ruin, destruction, or harm\tsalvage, salve, save\t";
    }
    // verb 00936648
    if sense == 6 {
        return "verb\trelieve oneself of troubling information\tunbosom\t";
    }
    // verb 00082563
    if sense == 7 {
        return "verb\tprovide relief for\tremedy\t";
    }
    ""
}
