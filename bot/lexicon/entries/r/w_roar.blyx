// roar — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_roar(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 01046059
    if sense == 1 {
        return "verb\tmake a loud noise, as of wind, water, or vehicles\thowl\tThe water roared down the chute";
    }
    // noun 07377682
    if sense == 2 {
        return "noun\ta deep prolonged loud noise\tboom, roaring, thunder\t";
    }
    // verb 00915605
    if sense == 3 {
        return "verb\tutter words loudly and forcefully\tthunder\t`Get out of here,' he roared";
    }
    // verb 01046932
    if sense == 4 {
        return "verb\temit long loud cries\thowl, ululate, wail, yawl, yaup\t";
    }
    // noun 07121361
    if sense == 5 {
        return "noun\ta very loud utterance (like the sound of an animal)\tbellow, bellowing, holla, holler, hollering, hollo, holloa, roaring, yowl\t";
    }
    // verb 01996188
    if sense == 6 {
        return "verb\tact or proceed in a riotous, turbulent, or disorderly way\t\tdesperadoes from the hills regularly roared in to take over the town";
    }
    // verb 01048718
    if sense == 7 {
        return "verb\tmake a loud noise, as of animal\tbellow\t";
    }
    ""
}
