// recommendation — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_recommendation(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 06671637
    if sense == 1 {
        return "noun\tsomething (as a course of action) that is recommended as advisable\t\t";
    }
    // noun 06694540
    if sense == 2 {
        return "noun\tsomething that recommends (or expresses commendation of) a person or thing as worthy or desirable\ttestimonial, good word\t";
    }
    ""
}
