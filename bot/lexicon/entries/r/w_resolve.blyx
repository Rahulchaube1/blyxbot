// resolve — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_resolve(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 00698855
    if sense == 1 {
        return "verb\tbring to an end; settle conclusively\tdecide, settle, adjudicate\t";
    }
    // verb 01021420
    if sense == 2 {
        return "verb\treach a conclusion after a discussion or deliberation\tconclude\t";
    }
    // verb 00699626
    if sense == 3 {
        return "verb\treach a decision\tpurpose\the resolved never to drink again";
    }
    // verb 00635523
    if sense == 4 {
        return "verb\tunderstand the meaning of\tanswer\t";
    }
    // noun 04861486
    if sense == 5 {
        return "noun\tthe trait of being resolute\tresoluteness, firmness, firmness of purpose, resolution\t";
    }
    // verb 02193612
    if sense == 6 {
        return "verb\tmake clearly visible\t\tcan this image be resolved?";
    }
    // verb 00733044
    if sense == 7 {
        return "verb\tfind the solution\tsolve\t";
    }
    ""
}
