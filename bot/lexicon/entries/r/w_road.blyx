// road — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_road(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 04096066
    if sense == 1 {
        return "noun\tan open way (generally public) for travel or transportation\troute\t";
    }
    // noun 00174003
    if sense == 2 {
        return "noun\ta way or means to achieve something\t\tthe road to fame";
    }
    ""
}
