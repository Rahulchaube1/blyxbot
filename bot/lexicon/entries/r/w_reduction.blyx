// reduction — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_reduction(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 00351638
    if sense == 1 {
        return "noun\tthe act of decreasing or reducing something\tdecrease, diminution, step-down\t";
    }
    // noun 13547677
    if sense == 2 {
        return "noun\tany process in which electrons are added to an atom or ion (as by removing oxygen or adding hydrogen); always occurs accompanied by oxidation of the reducing agent\treducing\t";
    }
    // noun 00192300
    if sense == 3 {
        return "noun\tthe act of reducing complexity\tsimplification\t";
    }
    ""
}
