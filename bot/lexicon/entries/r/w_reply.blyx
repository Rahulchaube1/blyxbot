// reply — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_reply(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // verb 00815686
    if sense == 1 {
        return "verb\treact verbally\tanswer, respond\t";
    }
    // noun 06746005
    if sense == 2 {
        return "noun\ta statement (either spoken or written) that is made to reply to a question or request or criticism or accusation\tanswer, response\the wrote replies to several of his critics";
    }
    // noun 07199565
    if sense == 3 {
        return "noun\tthe speech act of continuing a conversational exchange\tresponse\the growled his reply";
    }
    ""
}
