// ready — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_ready(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // adj 01930512
    if sense == 1 {
        return "adjective\tcompletely prepared or in condition for immediate action or use or progress\t\tget ready";
    }
    // adj 00185759
    if sense == 2 {
        return "adjective\t(of especially money) immediately available\t\the seems to have ample ready money";
    }
    // noun 14031523
    if sense == 3 {
        return "noun\tpoised for action\t\ttheir guns were at the ready";
    }
    // adj 02565701
    if sense == 4 {
        return "adjective\tmentally disposed\t\the was ready to believe her";
    }
    // verb 01664172
    if sense == 5 {
        return "verb\tprepare for eating by applying heat\tcook, fix, make, prepare\t";
    }
    // verb 00406243
    if sense == 6 {
        return "verb\tmake ready or suitable or equip in advance for a particular purpose or for some use, event, etc\tfix, prepare, set up, gear up, set\tGet the children ready for school!";
    }
    // adj 01844742
    if sense == 7 {
        return "adjective\tmade suitable and available for immediate use\t\tdinner is ready";
    }
    ""
}
