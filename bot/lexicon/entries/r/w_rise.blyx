    }
    // verb 00155547
    if sense == 13 {
        return "verb\trise in rank or status\tjump, climb up\t";
    }
    // verb 01818116
    if sense == 14 {
        return "verb\tbecome heartened or elated\t\t";
    }
    // verb 01155545
    if sense == 15 {
        return "verb\texert oneself to meet a challenge\t\trise to a challenge";
    }
    // noun 09206985
    if sense == 16 {
        return "noun\tan upward slope or grade (as in a road)\tascent, acclivity, raise, climb, upgrade\tthe car couldn't make it up the rise";
