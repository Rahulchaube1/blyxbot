        return "noun\ta growth in strength or number or importance\t\t";
    }
    // verb 02696801
    if sense == 5 {
        return "verb\trise up\tlift, rear\t";
    }
    // verb 01990281
    if sense == 6 {
        return "verb\tcome to the surface\tsurface, come up, rise up\t";
    }
    // verb 02624263
