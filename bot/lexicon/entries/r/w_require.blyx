// require — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_require(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // verb 02627934
    if sense == 1 {
        return "verb\trequire as useful, just, or proper\tnecessitate, ask, postulate, need, take, involve, call for, demand\tsuccess usually requires hard work";
    }
    // verb 00755745
    if sense == 2 {
        return "verb\tconsider obligatory; request and expect\task, expect\tWe require our secretary to be on time";
    }
    // verb 00751567
    if sense == 3 {
        return "verb\tmake someone do something\tcommand\t";
    }
    // verb 01188725
    if sense == 4 {
        return "verb\thave need of\twant, need\t";
    }
    ""
}
