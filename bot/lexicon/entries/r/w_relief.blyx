// relief — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_relief(sense: i64) -> str {
    if sense == 0 { return "9"; }
    // noun 07493280
    if sense == 1 {
        return "noun\tthe feeling that comes when something burdensome is removed or reduced\talleviation, assuagement\tas he heard the news he was suddenly flooded with relief";
    }
    // noun 14445749
    if sense == 2 {
        return "noun\tthe condition of being comfortable or relieved (especially after being relieved of distress)\tease\the enjoyed his relief from responsibility";
    }
    // noun 13290991
    if sense == 3 {
        return "noun\t(law) redress awarded by a court\t\twas the relief supposed to be protection from future harm or compensation for past injury?";
    }
    // noun 10648237
    if sense == 4 {
        return "noun\tsomeone who takes the place of another (as when things get dangerous or difficult)\tstand-in, substitute, reliever, backup, backup man, fill-in\t";
    }
    // noun 01209220
    if sense == 5 {
        return "noun\tassistance in time of difficulty\tsuccor, succour, ministration\tthe contributions provided some relief for the victims";
    }
    // noun 15274074
    if sense == 6 {
        return "noun\ta pause for relaxation\trespite, rest, rest period\t";
    }
    // noun 07357101
    if sense == 7 {
        return "noun\ta change for the better\teasing, moderation\t";
    }
    // noun 01088168
    if sense == 8 {
        return "noun\taid for the aged or indigent or handicapped\t\the has been on relief for many years";
    }
    // noun 00354884
    if sense == 9 {
        return "noun\tthe act of reducing something unpleasant (as pain or annoyance)\teasing, easement, alleviation\the asked the nurse for relief from the constant pain";
    }
    ""
}
