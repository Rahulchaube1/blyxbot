// improve — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_improve(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00205885
    if sense == 1 {
        return "verb\tto make better\tbetter, amend, ameliorate, meliorate\tThe editor improved the manuscript with his changes";
    }
    // verb 00205046
    if sense == 2 {
        return "verb\tget better\tbetter, ameliorate, meliorate\tThe weather improved toward evening";
    }
    ""
}
