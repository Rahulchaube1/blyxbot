// incident — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_incident(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07307477
    if sense == 1 {
        return "noun\ta single distinct event\t\t";
    }
    // adj 02987623
    if sense == 2 {
        return "adjective\tfalling or striking of light rays on something\t\tincident light";
    }
    ""
}
