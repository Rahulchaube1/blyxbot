// independence — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_independence(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 13994148
    if sense == 1 {
        return "noun\tfreedom from control or influence of another or others\tindependency\t";
    }
    // noun 07474006
    if sense == 2 {
        return "noun\tthe successful ending of the American Revolution\t\tthey maintained close relations with England even after independence";
    }
    ""
}
