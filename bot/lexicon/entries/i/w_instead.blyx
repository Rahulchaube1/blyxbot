// instead — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_instead(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00063172
    if sense == 1 {
        return "adverb\tin place of, or as an alternative to\talternatively, or else\tFelix became a herpetologist instead";
    }
    // adv 00098714
    if sense == 2 {
        return "adverb\ton the contrary\trather\the didn't call; rather (or instead), he wrote her a letter";
    }
    ""
}
