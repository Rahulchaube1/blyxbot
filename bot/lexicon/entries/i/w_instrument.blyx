// instrument — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_instrument(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 03574816
    if sense == 1 {
        return "noun\ta device that requires skill for proper use\t\t";
    }
    // noun 00173761
    if sense == 2 {
        return "noun\tthe means whereby some act is accomplished\ttool\tmy greed was the instrument of my destruction";
    }
    // noun 10209616
    if sense == 3 {
        return "noun\ta person used by another to gain an end\tpawn, cat's-paw\t";
    }
    ""
}
