// investigate — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_investigate(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00789138
    if sense == 1 {
        return "verb\tinvestigate scientifically\tlook into\tLet's investigate the syntax of Chinese";
    }
    // verb 00785962
    if sense == 2 {
        return "verb\tconduct an inquiry or investigation of\tinquire, enquire\tThe district attorney's office investigated reports of possible irregularities";
    }
    ""
}
