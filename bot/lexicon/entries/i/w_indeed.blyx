// indeed — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_indeed(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00037641
    if sense == 1 {
        return "adverb\tin truth (often tends to intensify)\tso\tthey said the car would break down and indeed it did";
    }
    ""
}
