// in general — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_in_general(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00041954
    if sense == 1 {
        return "adverb\twithout distinction of one from others\tgenerally, in the main\the is interested in snakes in general";
    }
    ""
}
