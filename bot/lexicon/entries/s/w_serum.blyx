// serum — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_serum(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 05403149
    if sense == 1 {
        return "noun\tan amber, watery fluid, rich in proteins, that separates out when blood coagulates\tblood serum\t";
    }
    ""
}
