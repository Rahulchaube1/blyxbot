// soviet — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_soviet(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 02959406
    if sense == 1 {
        return "adjective\tof or relating to or characteristic of the former Soviet Union or its people\t\tSoviet leaders";
    }
    ""
}
