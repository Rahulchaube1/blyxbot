// student — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_student(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10665698
    if sense == 1 {
        return "noun\ta learner who is enrolled in an educational institution\tpupil, educatee\t";
    }
    // noun 10557854
    if sense == 2 {
        return "noun\ta learned person (especially in the humanities); someone who by long study has gained mastery in one or more disciplines\tscholar, scholarly person, bookman\t";
    }
    ""
}
