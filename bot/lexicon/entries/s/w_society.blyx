// society — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_society(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07966140
    if sense == 1 {
        return "noun\tan extended social group having a distinctive cultural and economic organization\t\t";
    }
    // noun 08227214
    if sense == 2 {
        return "noun\ta formal association of people with similar interests\tclub, social club, guild, gild, lodge, order\tthey formed a small lunch society";
    }
    ""
}
