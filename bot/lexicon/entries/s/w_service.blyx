// service — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_service(sense: i64) -> str {
    if sense == 0 { return "8"; }
    // noun 00577525
    if sense == 1 {
        return "noun\twork done by one person or group that benefits another\t\tbudget separately for goods and services";
    }
    // noun 01209576
    if sense == 2 {
        return "noun\tan act of help or assistance\t\the did them a service";
    }
    // noun 01032040
    if sense == 3 {
        return "noun\tthe act of public worship following prescribed rules\treligious service, divine service\tthe Sunday service";
    }
    // noun 08186047
    if sense == 4 {
        return "noun\ta company or agency that performs a public service; subject to government regulation\t\t";
    }
    // noun 00584891
    if sense == 5 {
        return "noun\temployment in or work for another\t\the retired after 30 years of service";
    }
    // verb 02541251
    if sense == 6 {
        return "verb\tbe used by; as of a utility\tserve\t";
    }
    // noun 08198137
    if sense == 7 {
        return "noun\ta force that is a branch of the armed forces\tmilitary service, armed service\t";
    }
    // verb 00456937
    if sense == 8 {
        return "verb\tmake fit for use\t\tservice my truck";
    }
    ""
}
