// specialist — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_specialist(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10631941
    if sense == 1 {
        return "noun\tan expert who is devoted to one occupation or branch of learning\tspecializer, specialiser\t";
    }
    // noun 10632576
    if sense == 2 {
        return "noun\tpractices one branch of medicine\tmedical specialist\t";
    }
    ""
}
