// shadow — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_shadow(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 13984944
    if sense == 1 {
        return "noun\tshade within clear boundaries\t\t";
    }
    // noun 08646306
    if sense == 2 {
        return "noun\tan unilluminated area\tdarkness, dark\t";
    }
    // noun 05897553
    if sense == 3 {
        return "noun\tsomething existing in perception only\tapparition, phantom, phantasm, phantasma, fantasm\t";
    }
    // verb 02001461
    if sense == 4 {
        return "verb\tfollow, usually without the person's knowledge\t\tThe police are shadowing her";
    }
    // noun 07522418
    if sense == 5 {
        return "noun\ta premonition of something adverse\t\ta shadow over his happiness";
    }
    // noun 06646628
    if sense == 6 {
        return "noun\tan indication that something has been present\ttrace, vestige, tincture\t";
    }
    // noun 05155349
    if sense == 7 {
        return "noun\trefuge from danger or observation\t\the felt secure in his father's shadow";
    }
    ""
}
