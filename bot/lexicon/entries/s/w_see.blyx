// see — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_see(sense: i64) -> str {
    if sense == 0 { return "18"; }
    // verb 02129289
    if sense == 1 {
        return "verb\tperceive by sight or have the power to perceive by sight\t\tYou have to be a good observer to see all the details";
    }
    // verb 00591115
    if sense == 2 {
        return "verb\tperceive (an idea or situation) mentally\tunderstand, realize, realise\tNow I see!";
    }
    // verb 02128873
    if sense == 3 {
        return "verb\tperceive or be contemporaneous with\twitness, find\tYou'll see a lot of cheating in this school";
    }
    // verb 01635432
    if sense == 4 {
        return "verb\timagine; conceive of; see in one's mind\tvisualize, visualise, envision, project, fancy, figure, picture, image\tI can't see him on horseback!";
    }
    // verb 00690614
    if sense == 5 {
        return "verb\tdeem to be\tconsider, reckon, view, regard\tI don't see the situation quite as negatively as you do";
    }
    // verb 00598954
    if sense == 6 {
        return "verb\tget to know or become aware of, usually accidentally\tlearn, hear, get word, get wind, pick up, find out, get a line, discover\tI see that you have been promoted";
    }
    // verb 02150948
    if sense == 7 {
        return "verb\tsee or watch\twatch, view, catch, take in\tsee a movie";
    }
    // verb 02023107
    if sense == 8 {
        return "verb\tcome together\tmeet, run into, encounter, run across, come across\tI'll probably see you at the meeting";
    }
    // verb 00920336
    if sense == 9 {
        return "verb\tfind out, learn, or determine with certainty, usually by making an inquiry or other effort\tdetermine, check, find out, ascertain, watch, learn\tI want to see whether she speaks French";
    }
    // verb 00662589
    if sense == 10 {
        return "verb\tbe careful or certain to do something; make certain of something\tcheck, insure, see to it, ensure, control, ascertain, assure\tSee that the curtains are closed";
    }
    // verb 02488304
    if sense == 11 {
        return "verb\tgo to see for professional or business reasons\t\tYou should see a lawyer";
    }
    // verb 02488488
    if sense == 12 {
        return "verb\tgo to see for a social visit\t\tI went to see my friend Mary the other day";
    }
    // verb 02493030
    if sense == 13 {
        return "verb\tgo to see a place, as for entertainment\tvisit\tWe went to see the Eiffel Tower in the morning";
    }
    // verb 02549581
    if sense == 14 {
        return "verb\ttake charge of or deal with\tattend, take care, look\tCould you see about lunch?";
    }
    // verb 01470670
    if sense == 15 {
        return "verb\treceive as a specified guest\t\tthe doctor will see you now";
    }
    // verb 02486232
    if sense == 16 {
        return "verb\tdate regularly; have a steady relationship with\tgo steady, go out, date\tDid you know that she is seeing an older man?";
    }
    // verb 02129709
    if sense == 17 {
        return "verb\tsee and understand, have a good eye\t\tThe artist must first learn to see";
    }
    // verb 00703708
    if sense == 18 {
        return "verb\tdeliberate or decide\t\tSee whether you can come tomorrow";
    }
    ""
}
