// services — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_services(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 00585174
    if sense == 1 {
        return "noun\tperformance of duties or provision of space and equipment helpful to others\t\tthe mayor tried to maintain city services";
    }
    ""
}
