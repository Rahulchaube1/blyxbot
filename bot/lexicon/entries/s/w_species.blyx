// species — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_species(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 08110373
    if sense == 1 {
        return "noun\t(biology) taxonomic group whose members can interbreed\t\t";
    }
    // noun 05844881
    if sense == 2 {
        return "noun\ta specific kind of something\t\ta species of molecule";
    }
    ""
}
