// safe — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_safe(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // adj 02057829
    if sense == 1 {
        return "adjective\tfree from danger or the risk of harm\t\ta safe trip";
    }
    // noun 04125021
    if sense == 2 {
        return "noun\tstrongbox where valuables can be safely kept\t\t";
    }
    // adj 00066933
    if sense == 3 {
        return "adjective\t(of an undertaking) secure from risk\t\t";
    }
    ""
}
