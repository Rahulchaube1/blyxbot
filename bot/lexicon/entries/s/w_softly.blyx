// softly — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_softly(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // adv 00070166
    if sense == 1 {
        return "adverb\twith low volume\tquietly\tspeak softly but carry a big stick";
    }
    // adv 00503945
    if sense == 2 {
        return "adverb\tin a manner that is pleasing to the senses\t\tshe smiled softly";
    }
    // adv 00180279
    if sense == 3 {
        return "adverb\twith little weight or force\tlightly, gently\t";
    }
    ""
}
