// symbol — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_symbol(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 06806469
    if sense == 1 {
        return "noun\tan arbitrary sign (written or printed) that has acquired a conventional significance\t\t";
    }
    // noun 05765415
    if sense == 2 {
        return "noun\tsomething visible that by association or convention represents something else that is invisible\tsymbolization, symbolisation, symbolic representation\tthe eagle is a symbol of the United States";
    }
    ""
}
