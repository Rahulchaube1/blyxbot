// steps — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_steps(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 04298171
    if sense == 1 {
        return "noun\ta flight of stairs or a flight of steps\tstairs\t";
    }
    // noun 09445566
    if sense == 2 {
        return "noun\tthe course along which a person has walked or is walking in\t\tI followed in his steps";
    }
    ""
}
