// self — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_self(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 05675601
    if sense == 1 {
        return "noun\tyour consciousness of your own identity\tego\t";
    }
    // noun 09604981
    if sense == 2 {
        return "noun\ta person considered as a unique individual\t\tone's own self";
    }
    // adj 02794670
    if sense == 3 {
        return "adjective\t(used as a combining form) relating to--of or by or to or from or for--the self\t\tself-knowledge";
    }
    ""
}
