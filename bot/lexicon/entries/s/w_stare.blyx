// stare — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_stare(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // verb 02132745
    if sense == 1 {
        return "verb\tlook at with fixed eyes\tgaze\tThe students stared at the teacher with amazement";
    }
    // noun 00878456
    if sense == 2 {
        return "noun\ta fixed look with eyes open wide\t\t";
    }
    // verb 00033406
    if sense == 3 {
        return "verb\tfixate one's eyes\t\tThe ancestor in the painting is staring down menacingly";
    }
    ""
}
