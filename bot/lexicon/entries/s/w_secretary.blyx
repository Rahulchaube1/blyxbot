// secretary — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_secretary(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10570019
    if sense == 1 {
        return "noun\ta person who is head of an administrative department of government\t\t";
    }
    // noun 10569744
    if sense == 2 {
        return "noun\tan assistant who handles correspondence and clerical work for a boss or an organization\tsecretarial assistant\t";
    }
    ""
}
