// soil — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_soil(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 14498096
    if sense == 1 {
        return "noun\tthe state of being covered with unclean things\tdirt, filth, grime, stain, grease, grunge\t";
    }
    // noun 14844693
    if sense == 2 {
        return "noun\tthe part of the earth's surface consisting of humus and disintegrated rock\tdirt\t";
    }
    // noun 09335240
    if sense == 3 {
        return "noun\tmaterial in the top layer of the surface of the earth in which plants can grow (especially with reference to its quality or use)\tland, ground\tgood agricultural soil";
    }
    // verb 01534147
    if sense == 4 {
        return "verb\tmake soiled, filthy, or dirty\tdirty, begrime, grime, colly, bemire\tdon't soil your clothes when you play outside!";
    }
    ""
}
