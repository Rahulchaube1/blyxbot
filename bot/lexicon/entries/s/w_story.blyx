// story — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_story(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 07221094
    if sense == 1 {
        return "noun\ta message that tells the particulars of an act or occurrence or course of events; presented in writing or drama or cinema or as a radio or television program\tnarrative, narration, tale\tDisney's stories entertain adults as well as children";
    }
    // noun 06369829
    if sense == 2 {
        return "noun\ta piece of fiction that narrates a chain of related events\t\the writes stories for the magazines";
    }
    // noun 03365991
    if sense == 3 {
        return "noun\ta structure consisting of a room or set of rooms at a single position along a vertical scale\tfloor, level, storey\t";
    }
    // noun 06514093
    if sense == 4 {
        return "noun\ta record or narrative description of past events\thistory, account, chronicle\tthe story of exposure to lead";
    }
    // noun 06681551
    if sense == 5 {
        return "noun\ta short account of the news\treport, news report, account, write up\tthe story was on the 11 o'clock news";
    }
    // noun 06757057
    if sense == 6 {
        return "noun\ta trivial lie\tfib, tale, tarradiddle, taradiddle\thow can I stop my child from telling stories?";
    }
    ""
}
