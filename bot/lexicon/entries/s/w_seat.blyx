// seat — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_seat(sense: i64) -> str {
    if sense == 0 { return "8"; }
    // noun 08647616
    if sense == 1 {
        return "noun\ta space reserved for sitting (as in a theater or on a train or airplane)\tplace\the booked their seats in advance";
    }
    // verb 01543998
    if sense == 2 {
        return "verb\tshow to a seat; assign a seat for\tsit, sit down\tThe host seated me next to Mrs. Smith";
    }
    // noun 05559256
    if sense == 3 {
        return "noun\tthe fleshy part of the human body that you sit on\tbuttocks, nates, arse, butt, backside, bum, buns, can, fundament, hindquarters, hind end, keister, posterior, prat, rear, rear end, rump, stern, tail, tail end, tooshie, tush, bottom, behind, derriere, fanny, ass\t";
    }
    // noun 04161981
    if sense == 4 {
        return "noun\tfurniture that is designed for sitting on\t\tthere were not enough seats for all the guests";
    }
    // noun 04161358
    if sense == 5 {
        return "noun\tany support where you can sit (especially the part of a chair or bench etc. on which you sit)\t\the dusted off the seat before sitting down";
    }
    // verb 02701962
    if sense == 6 {
        return "verb\tbe able to seat\t\tThe theater seats 2,000";
    }
    // verb 02384275
    if sense == 7 {
        return "verb\tplace ceremoniously or formally in an office or position\tinduct, invest\t";
    }
    // noun 08647945
    if sense == 8 {
        return "noun\ta center of authority (as a city from which authority is exercised)\t\t";
    }
    ""
}
