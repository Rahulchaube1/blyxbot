// shot — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_shot(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 00122661
    if sense == 1 {
        return "noun\tthe act of firing a projectile\tshooting\t";
    }
    // noun 04205759
    if sense == 2 {
        return "noun\ta solid missile discharged from a firearm\tpellet\tthe shot buzzed past his ear";
    }
    // noun 00565302
    if sense == 3 {
        return "noun\t(sports) the act of swinging or striking at a ball with a club or racket or bat or cue or hand\tstroke\ta good shot requires good balance and tempo";
    }
    // noun 14485673
    if sense == 4 {
        return "noun\ta chance to do something\tcrack\the wanted a shot at the champion";
    }
    // noun 10593115
    if sense == 5 {
        return "noun\ta person who shoots (usually with respect to their ability to shoot)\tshooter\the is a crack shot";
    }
    // noun 06614729
    if sense == 6 {
        return "noun\ta consecutive series of pictures that constitutes a unit of action in a film\tscene\t";
    }
    // noun 00697365
    if sense == 7 {
        return "noun\tthe act of putting a liquid into the body by means of a syringe\tinjection\tthe nurse gave him a flu shot";
    }
    ""
}
