// state — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_state(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 08654360
    if sense == 1 {
        return "noun\tthe territory occupied by one of the constituent administrative districts of a nation\tprovince\this state is in the deep south";
    }
    // verb 01009240
    if sense == 2 {
        return "verb\texpress in words\tsay, tell\tstate your opinion";
    }
    // noun 00024720
    if sense == 3 {
        return "noun\tthe way something is with respect to its main attributes\t\tthe current state of knowledge";
    }
    // noun 08178547
    if sense == 4 {
        return "noun\tthe group of people comprising the government of a sovereign state\t\tthe state has lowered its income tax";
    }
    // noun 08168978
    if sense == 5 {
        return "noun\ta politically organized body of people under a single government\tnation, country, land, commonwealth, res publica, body politic\tthe state has elected a new president";
    }
    // verb 00878136
    if sense == 6 {
        return "verb\tput before\tsubmit, put forward, posit\t";
    }
    // verb 01061481
    if sense == 7 {
        return "verb\tindicate through a symbol, formula, etc.\texpress\t";
    }
    ""
}
