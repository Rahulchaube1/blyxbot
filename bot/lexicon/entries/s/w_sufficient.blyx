// sufficient — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_sufficient(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 02335828
    if sense == 1 {
        return "adjective\tof a quantity that can fulfill a need or requirement but without being abundant\t\tsufficient food";
    }
    ""
}
