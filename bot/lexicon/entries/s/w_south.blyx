// south — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_south(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 09050730
    if sense == 1 {
        return "noun\tthe region of the United States lying to the south of the Mason-Dixon line\t\t";
    }
    // adj 01602330
    if sense == 2 {
        return "adjective\tsituated in or facing or moving toward or coming from the south\t\tthe south entrance";
    }
    // adv 00243938
    if sense == 3 {
        return "adverb\tin a southern direction\tto the south, in the south\twe moved south";
    }
    // noun 09050244
    if sense == 4 {
        return "noun\tthe southern states that seceded from the United States in 1861\tConfederacy, Confederate States, Confederate States of America, Dixie, Dixieland\t";
    }
    // noun 13833375
    if sense == 5 {
        return "noun\tthe cardinal compass point that is at 180 degrees\tdue south, southward, S\t";
    }
    // noun 08561583
    if sense == 6 {
        return "noun\ta location in the southern part of a country, region, or city\t\t";
    }
    ""
}
