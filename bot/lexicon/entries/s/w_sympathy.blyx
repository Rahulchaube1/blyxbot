// sympathy — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_sympathy(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 06199142
    if sense == 1 {
        return "noun\tan inclination to support or be loyal to or to agree with an opinion\tunderstanding\this sympathies were always with the underdog";
    }
    // noun 07553301
    if sense == 2 {
        return "noun\tsharing the feelings of others (especially feelings of sorrow or anguish)\tfellow feeling\t";
    }
    // noun 13811900
    if sense == 3 {
        return "noun\ta relation of affinity or harmony between people; whatever affects one correspondingly affects the other\t\tthe two of them were in close sympathy";
    }
    ""
}
