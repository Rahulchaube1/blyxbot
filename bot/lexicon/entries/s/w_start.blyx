// start — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_start(sense: i64) -> str {
    if sense == 0 { return "16"; }
    // verb 00345761
    if sense == 1 {
        return "verb\ttake the first step or steps in carrying out an action\tget down, begin, get, start out, set about, set out, commence\tWho will start?";
    }
    // verb 00348746
    if sense == 2 {
        return "verb\tset in motion, cause to start\tbegin, lead off, commence\tThe U.S. started a war in the Middle East";
    }
    // verb 02014165
    if sense == 3 {
        return "verb\tleave\tdepart, part, start out, set forth, set off, set out, take off\t";
    }
    // verb 02608347
    if sense == 4 {
        return "verb\thave a beginning, in a temporal, spatial, or evaluative sense\tbegin\tPrices for these homes start at $250,000";
    }
    // verb 01628449
    if sense == 5 {
        return "verb\tbring into being\toriginate, initiate\tStart a foundation";
    }
    // noun 07325190
    if sense == 6 {
        return "noun\tthe beginning of anything\t\tit was off to a good start";
    }
    // verb 01650610
    if sense == 7 {
        return "verb\tget off the ground\tstart up, embark on, commence\tWho started this company?";
    }
    // verb 01910373
    if sense == 8 {
        return "verb\tmove or jump suddenly, as if in surprise or alarm\tstartle, jump\t";
    }
    // verb 01857717
    if sense == 9 {
        return "verb\tget going or set in motion\tstart up\tWe simply could not start the engine";
    }
    // noun 15265518
    if sense == 10 {
        return "noun\tthe time at which something is supposed to begin\tbeginning, commencement, first, outset, get-go, kickoff, starting time, showtime, offset\tthey got an early start";
    }
    // verb 01864230
    if sense == 11 {
        return "verb\tbegin or set in motion\tgo, get going\tI start at eight in the morning";
    }
    // noun 00241699
    if sense == 12 {
        return "noun\ta turn to be a starter (in a game at the beginning)\tstarting\the got his start because one of the regular pitchers was in the hospital";
    }
    // verb 02379528
    if sense == 13 {
        return "verb\tbegin work or acting in a certain capacity, office or job\ttake up\tstart a new job";
    }
    // noun 00867357
    if sense == 14 {
        return "noun\ta sudden involuntary movement\tstartle, jump\the awoke with a start";
    }
    // noun 00235435
    if sense == 15 {
        return "noun\tthe act of starting something\tbeginning, commencement\t";
    }
    // verb 01075164
    if sense == 16 {
        return "verb\tplay in the starting lineup\t\t";
    }
    ""
}
