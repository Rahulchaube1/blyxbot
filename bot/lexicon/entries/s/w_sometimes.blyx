// sometimes — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_sometimes(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00021878
    if sense == 1 {
        return "adverb\ton certain occasions or in certain cases but not always\t\tsometimes she wished she were back in England";
    }
    ""
}
