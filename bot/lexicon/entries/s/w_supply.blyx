// supply — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_supply(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 02327200
    if sense == 1 {
        return "verb\tgive something useful or necessary to\tprovide, render, furnish\t";
    }
    // noun 13777344
    if sense == 2 {
        return "noun\tan amount of something available for use\t\t";
    }
    // verb 02479323
    if sense == 3 {
        return "verb\tcirculate or distribute or equip with\tissue\tsupply blankets for the beds";
    }
    // noun 13563522
    if sense == 4 {
        return "noun\toffering goods and services for sale\t\t";
    }
    // verb 01182709
    if sense == 5 {
        return "verb\tgive what is desired or needed, especially support, food or sustenance\tprovide, ply, cater\t";
    }
    // noun 01057200
    if sense == 6 {
        return "noun\tthe activity of supplying or providing something\tprovision, supplying\t";
    }
    // verb 01027174
    if sense == 7 {
        return "verb\tstate or say further\tadd, append\t`It doesn't matter,' he supplied";
    }
    ""
}
