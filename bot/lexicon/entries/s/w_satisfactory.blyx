// satisfactory — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_satisfactory(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 02080577
    if sense == 1 {
        return "adjective\tgiving satisfaction\t\tsatisfactory living conditions";
    }
    // adj 01124768
    if sense == 2 {
        return "adjective\tmeeting requirements\tacceptable\tthe step makes a satisfactory seat";
    }
    ""
}
