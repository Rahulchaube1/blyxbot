// some — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_some(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // adj 02267308
    if sense == 1 {
        return "adjective\tquantifier; used with either mass nouns or plural count nouns to indicate an unspecified number or quantity\t\thave some milk";
    }
    // adj 01554063
    if sense == 2 {
        return "adjective\trelatively much but unspecified in amount or extent\t\twe talked for some time";
    }
    // adj 01552634
    if sense == 3 {
        return "adjective\trelatively many but unspecified in number\t\tthey were here for some weeks";
    }
    // adv 00007015
    if sense == 4 {
        return "adverb\t(of quantities) imprecise but fairly close to correct\tapproximately, about, close to, just about, roughly, more or less, around, or so\tsome forty people came";
    }
    ""
}
