// smile — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_smile(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00028565
    if sense == 1 {
        return "verb\tchange one's facial expression by spreading the lips, often to signal pleasure\t\t";
    }
    // noun 06878071
    if sense == 2 {
        return "noun\ta facial expression characterized by turning up the corners of the mouth; usually shows pleasure or amusement\tsmiling, grin, grinning\t";
    }
    ""
}
