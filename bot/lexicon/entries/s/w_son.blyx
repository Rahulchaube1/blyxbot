// son — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_son(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10624074
    if sense == 1 {
        return "noun\ta male human offspring\tboy\ttheir son became a famous judge";
    }
    // noun 09537144
    if sense == 2 {
        return "noun\tthe divine word of God; the second person in the Trinity (incarnate in Jesus)\tWord, Logos\t";
    }
    ""
}
