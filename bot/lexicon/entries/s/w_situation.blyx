// situation — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_situation(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 13927383
    if sense == 1 {
        return "noun\tthe general state of things; the combination of circumstances at a given time\tstate of affairs\tthe present international situation is dangerous";
    }
    // noun 13925752
    if sense == 2 {
        return "noun\ta condition or position in which you find yourself\tposition\tthe unpleasant situation (or position) of having to choose between two evils";
    }
    ""
}
