// secret — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_secret(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // adj 02090069
    if sense == 1 {
        return "adjective\tnot open or public; kept private or not revealed\t\ta secret formula";
    }
    // noun 06673142
    if sense == 2 {
        return "noun\tsomething that should remain hidden from others (especially information that is not to be passed on)\t\tthe combination to the safe was a secret";
    }
    // adj 01706465
    if sense == 3 {
        return "adjective\tconducted with or marked by hidden aims or methods\tclandestine, cloak-and-dagger, hole-and-corner, hugger-mugger, hush-hush, surreptitious, undercover, underground\tsecret missions";
    }
    // adj 00028984
    if sense == 4 {
        return "adjective\tnot openly made known\tunavowed\ta secret marriage";
    }
    // adj 01707404
    if sense == 5 {
        return "adjective\tcommunicated covertly\t\ttheir secret signal was a wink";
    }
    // adj 00952181
    if sense == 6 {
        return "adjective\tnot expressed\tprivate\tsecret (or private) thoughts";
    }
    ""
}
