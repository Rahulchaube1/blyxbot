// seriously — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_seriously(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00165018
    if sense == 1 {
        return "adverb\tin a serious manner\tearnestly, in earnest\ta play dealing seriously with the question of divorce";
    }
    // adv 00015953
    if sense == 2 {
        return "adverb\tto a severe or serious degree\tbadly, severely, gravely\twas seriously ill";
    }
    ""
}
