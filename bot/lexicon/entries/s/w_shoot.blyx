// shoot — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_shoot(sense: i64) -> str {
    if sense == 0 { return "9"; }
    // verb 01137138
    if sense == 1 {
        return "verb\thit with a missile from a weapon\thit, pip\t";
    }
    // verb 02484570
    if sense == 2 {
        return "verb\tkill by firing a missile\tpip\t";
    }
    // verb 01134781
    if sense == 3 {
        return "verb\tfire a shot\tblast\t";
    }
    // verb 01002740
    if sense == 4 {
        return "verb\tmake a film or photograph of something\tfilm, take\tshoot a movie";
    }
    // verb 02096047
    if sense == 5 {
        return "verb\tsend forth suddenly, intensely, swiftly\t\tshoot a glance";
    }
    // verb 02061495
    if sense == 6 {
        return "verb\trun or move very quickly or hastily\tdart, dash, scoot, scud, flash\t";
    }
    // verb 02055267
    if sense == 7 {
        return "verb\tmove quickly and violently\ttear, shoot down, charge, buck\t";
    }
    // verb 01597286
    if sense == 8 {
        return "verb\tthrow or propel in a specific direction or towards a specific objective\t\tshoot craps";
    }
    // verb 01003249
    if sense == 9 {
        return "verb\trecord on photographic film\tphotograph, snap\t";
    }
    ""
}
