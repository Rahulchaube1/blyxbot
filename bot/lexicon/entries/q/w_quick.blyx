// quick — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_quick(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // adj 00979366
    if sense == 1 {
        return "adjective\taccomplished rapidly and without delay\tspeedy\twas quick to make friends";
    }
    // adv 00105603
    if sense == 2 {
        return "adverb\twith little or no delay\tpromptly, quickly\tcome here, quick!";
    }
    // adj 01270486
    if sense == 3 {
        return "adjective\thurried and brief\tflying, fast\ta quick inspection";
    }
    // adj 00032733
    if sense == 4 {
        return "adjective\tmoving quickly and lightly\tagile, nimble, spry\tquick of foot";
    }
    // adj 01335903
    if sense == 5 {
        return "adjective\tapprehending and responding with speed and sensitivity\tready\ta quick mind";
    }
    // adj 00978754
    if sense == 6 {
        return "adjective\tperformed with little or no delay\timmediate, prompt, straightaway\twas quick to respond";
    }
    // adj 00919018
    if sense == 7 {
        return "adjective\teasily aroused or excited\twarm\ta quick temper";
    }
    ""
}
