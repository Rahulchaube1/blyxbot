// quickly — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_quickly(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00085811
    if sense == 1 {
        return "adverb\twith rapid movements\trapidly, speedily, chop-chop, apace\the works quickly";
    }
    // adv 00105603
    if sense == 2 {
        return "adverb\twith little or no delay\tpromptly, quick\t";
    }
    ""
}
