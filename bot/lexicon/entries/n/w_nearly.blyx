// nearly — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_nearly(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00073033
    if sense == 1 {
        return "adverb\t(of actions or states) slightly short of or not quite accomplished; all but\tabout, almost, most, near, nigh, virtually, well-nigh\the nearly fainted";
    }
    ""
}
