// neglect — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_neglect(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 00614999
    if sense == 1 {
        return "verb\tleave undone or leave out\tpretermit, omit, drop, miss, leave out, overlook, overleap\t";
    }
    // verb 02529284
    if sense == 2 {
        return "verb\tfail to do something; leave something undone\tfail\t";
    }
    // verb 00616153
    if sense == 3 {
        return "verb\tfail to attend to\t\the neglects his children";
    }
    // verb 00616857
    if sense == 4 {
        return "verb\tgive little or no attention to\tignore, disregard\t";
    }
    // noun 05706629
    if sense == 5 {
        return "noun\tlack of attention and due care\tdisregard\t";
    }
    // noun 14423428
    if sense == 6 {
        return "noun\tthe state of something that has been unused and neglected\tdisuse\tthe house was in a terrible state of neglect";
    }
    // noun 00418615
    if sense == 7 {
        return "noun\twillful lack of care and attention\tdisregard\t";
    }
    ""
}
