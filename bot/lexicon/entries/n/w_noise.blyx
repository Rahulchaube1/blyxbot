// noise — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_noise(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07387509
    if sense == 1 {
        return "noun\tsound of any kind (especially unintelligible or dissonant sound)\t\the enjoyed the street noises";
    }
    // noun 05720248
    if sense == 2 {
        return "noun\tthe auditory experience of sound that lacks musical quality; sound that is a disagreeable auditory experience\tdissonance, racket\tmodern music is just noise to me";
    }
    ""
}
