// nothing — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_nothing(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 13740168
    if sense == 1 {
        return "noun\ta quantity of no importance\tnil, nix, nada, null, aught, cipher, cypher, goose egg, naught, zero, zilch, zip, zippo\tit looked like nothing I had ever seen before";
    }
    ""
}
