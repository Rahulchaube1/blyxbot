// no more — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_no_more(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00031515
    if sense == 1 {
        return "adverb\tnot now\tno longer\tshe is no more";
    }
    // adv 00050681
    if sense == 2 {
        return "adverb\treferring to the degree to which a certain quality is present\tno\t";
    }
    ""
}
