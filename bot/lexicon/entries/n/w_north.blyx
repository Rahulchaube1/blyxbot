// north — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_north(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 09052652
    if sense == 1 {
        return "noun\tthe region of the United States lying to the north of the Mason-Dixon line\t\t";
    }
    // adv 00244043
    if sense == 2 {
        return "adverb\tin a northern direction\tnortherly, northwards, northward\tthey earn more up north";
    }
    // adj 01600333
    if sense == 3 {
        return "adjective\tsituated in or facing or moving toward or coming from the north\t\tartists like north light";
    }
    // noun 09052314
    if sense == 4 {
        return "noun\tthe United States (especially the northern states during the American Civil War)\tUnion\tthe North's superior resources turned the scale";
    }
    // noun 13831176
    if sense == 5 {
        return "noun\tthe cardinal compass point that is at 0 or 360 degrees\tdue north, northward, N\t";
    }
    // noun 08561081
    if sense == 6 {
        return "noun\ta location in the northern part of a country, region, or city\t\t";
    }
    ""
}
