// method — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_method(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 05660268
    if sense == 1 {
        return "noun\ta way of doing something, especially a systematic way; implies an orderly logical arrangement (usually in steps)\t\t";
    }
    ""
}
