// many — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_many(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 01551633
    if sense == 1 {
        return "adjective\ta quantifier that can be used with count nouns and is often preceded by `as' or `too' or `so' or `that'; amounting to a large but indefinite number\t\tmany temptations";
    }
    ""
}
