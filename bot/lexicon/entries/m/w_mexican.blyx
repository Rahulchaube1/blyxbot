// mexican — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_mexican(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 09722658
    if sense == 1 {
        return "noun\ta native or inhabitant of Mexico\t\t";
    }
    // adj 03026902
    if sense == 2 {
        return "adjective\tof or relating to Mexico or its inhabitants\t\tMexican food is hot";
    }
    ""
}
