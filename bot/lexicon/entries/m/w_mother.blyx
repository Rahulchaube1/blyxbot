// mother — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_mother(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 10332385
    if sense == 1 {
        return "noun\ta woman who has given birth to a child (also used as a term of address to your mother)\tfemale parent\tthe mother of three children";
    }
    // verb 02550516
    if sense == 2 {
        return "verb\tcare for like a mother\tfuss, overprotect\t";
    }
    ""
}
