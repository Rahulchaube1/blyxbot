// mass — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_mass(sense: i64) -> str {
    if sense == 0 { return "8"; }
    // noun 05024254
    if sense == 1 {
        return "noun\tthe property of a body that causes it to have weight in a gravitational field\t\t";
    }
    // noun 13774404
    if sense == 2 {
        return "noun\t(often followed by `of') a large number or amount or extent\tbatch, deal, flock, good deal, great deal, hatful, heap, lot, mess, mickle, mint, mountain, muckle, passel, peck, pile, plenty, pot, quite a little, raft, sight, slew, spate, stack, tidy sum, wad\t";
    }
    // noun 07962124
    if sense == 3 {
        return "noun\tan ill-structured collection of similar things (objects or people)\t\t";
    }
    // noun 01042242
    if sense == 4 {
        return "noun\t(Roman Catholic Church and Protestant Churches) the celebration of the Eucharist\t\t";
    }
    // noun 09348055
    if sense == 5 {
        return "noun\ta body of matter without definite shape\t\ta huge ice mass";
    }
    // noun 08180190
    if sense == 6 {
        return "noun\tthe common people generally\tmultitude, masses, hoi polloi, people, the great unwashed\tseparate the warriors from the mass";
    }
    // noun 05099389
    if sense == 7 {
        return "noun\tthe property of something that is great in magnitude\tbulk, volume\the received a mass of correspondence";
    }
    // verb 02024168
    if sense == 8 {
        return "verb\tjoin together into a mass or collect or form a mass\t\tCrowds were massing outside the palace";
    }
    ""
}
