// milk — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_milk(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 07844042
    if sense == 1 {
        return "noun\ta white nutritious liquid secreted by mammals and used as food by human beings\t\t";
    }
    // verb 00194170
    if sense == 2 {
        return "verb\ttake milk from female mammals\t\tCows need to be milked every morning";
    }
    // noun 05399034
    if sense == 3 {
        return "noun\tproduced by mammary glands of female mammals for feeding their young\t\t";
    }
    // verb 01164906
    if sense == 4 {
        return "verb\texploit as much as possible\t\tI am milking this for all it's worth";
    }
    ""
}
