// motion — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_motion(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 06876309
    if sense == 1 {
        return "noun\tthe use of movements (especially of the hands) to communicate familiar or prearranged signals\tgesture\t";
    }
    // noun 07309781
    if sense == 2 {
        return "noun\ta natural event that involves a change in the position or location of something\tmovement\t";
    }
    // noun 00331950
    if sense == 3 {
        return "noun\ta change of position that does not entail a change of location\tmovement, move, motility\tthe reflex motion of his eyebrows revealed his surprise";
    }
    // noun 14004317
    if sense == 4 {
        return "noun\ta state of change\t\tthey were in a state of steady motion";
    }
    // noun 07163593
    if sense == 5 {
        return "noun\ta formal proposal for action made to a deliberative assembly for discussion and vote\tquestion\the made a motion to adjourn";
    }
    // noun 00279835
    if sense == 6 {
        return "noun\tthe act of changing location from one place to another\tmovement, move\tpolice controlled the motion of the crowd";
    }
    // verb 00992041
    if sense == 7 {
        return "verb\tshow, express or direct through movement\tgesticulate, gesture\t";
    }
    ""
}
