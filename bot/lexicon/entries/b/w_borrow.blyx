// borrow — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_borrow(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02324026
    if sense == 1 {
        return "verb\tget temporarily\t\tMay I borrow your lawn mower?";
    }
    // verb 02346724
    if sense == 2 {
        return "verb\ttake up and practice as one's own\tadopt, take over, take up\t";
    }
    ""
}
