// below — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_below(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // adv 00080039
    if sense == 1 {
        return "adverb\tin or to a place that is lower\tat a lower place, to a lower place, beneath\t";
    }
    // adv 00079866
    if sense == 2 {
        return "adverb\tat a later place\t\tsee below";
    }
    // adv 00258282
    if sense == 3 {
        return "adverb\t(in writing) see below\tinfra\t";
    }
    // adv 00094396
    if sense == 4 {
        return "adverb\ton a floor below\tdownstairs, down the stairs, on a lower floor\t";
    }
    ""
}
