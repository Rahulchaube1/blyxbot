// bedroom — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_bedroom(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 02821627
    if sense == 1 {
        return "noun\ta room used primarily for sleeping\tsleeping room, sleeping accommodation, chamber, bedchamber\t";
    }
    ""
}
