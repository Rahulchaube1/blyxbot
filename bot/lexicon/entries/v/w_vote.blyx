// vote — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_vote(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // verb 02461314
    if sense == 1 {
        return "verb\texpress one's preference for a candidate or for a measure or resolution; cast a vote\t\tHe voted for the motion";
    }
    // noun 00183505
    if sense == 2 {
        return "noun\ta choice that is made by counting the number of people in favor of each alternative\tballot, voting, balloting\tthere were only 17 votes in favor of the motion";
    }
    // verb 02462580
    if sense == 3 {
        return "verb\texpress one's choice or preference by vote\t\tvote the Democratic ticket";
    }
    // noun 00182213
    if sense == 4 {
        return "noun\tthe opinion of a group as determined by voting\t\tthey put the question to a vote";
    }
    // noun 05186306
    if sense == 5 {
        return "noun\ta legal right guaranteed by the 15th amendment to the US Constitution; guaranteed to women by the 19th amendment\tright to vote, suffrage\tAmerican women got the vote in 1920";
    }
    // verb 02462386
    if sense == 6 {
        return "verb\texpress a choice or opinion\t\tI vote that we all go home";
    }
    ""
}
