// vision — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_vision(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // noun 05768252
    if sense == 1 {
        return "noun\ta vivid mental image\t\the had a vision of his own death";
    }
    // noun 05654362
    if sense == 2 {
        return "noun\tthe ability to see; the visual faculty\tsight, visual sense, visual modality\t";
    }
    // noun 05713524
    if sense == 3 {
        return "noun\tthe perceptual experience of seeing\tvisual sensation\tthe runners emerged from the trees into his clear vision";
    }
    // noun 05625465
    if sense == 4 {
        return "noun\tthe formation of a mental image of something that is not perceived as real and is not present to the senses\timagination, imaginativeness\t";
    }
    // noun 07288485
    if sense == 5 {
        return "noun\ta religious or mystical experience of a supernatural appearance\t\the had a vision of the Virgin Mary";
    }
    ""
}
