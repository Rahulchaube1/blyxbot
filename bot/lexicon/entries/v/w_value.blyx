// value — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_value(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 05856388
    if sense == 1 {
        return "noun\ta numerical quantity measured or assigned or computed\t\tthe value assigned was 16 milliseconds";
    }
    // noun 05138488
    if sense == 2 {
        return "noun\tthe quality (positive or negative) that renders something desirable or valuable\t\tthe Shakespearean Shylock is of dubious value in the modern world";
    }
    // noun 13413493
    if sense == 3 {
        return "noun\tthe amount (of money or goods or services) that is considered to be a fair equivalent for something else\teconomic value\the tried to estimate the value of the produce at normal prices";
    }
    // noun 04979425
    if sense == 4 {
        return "noun\trelative darkness or lightness of a color\t\tI establish the colors and principal values by organizing the painting into three values--dark, medium...and light";
    }
    // verb 00695226
    if sense == 5 {
        return "verb\tfix or determine the value of; assign a value to\t\tvalue the jewelry and art work in the estate";
    }
    // verb 02256109
    if sense == 6 {
        return "verb\thold dear\tprize, treasure, appreciate\t";
    }
    // verb 00694068
    if sense == 7 {
        return "verb\tregard highly; think much of\trespect, esteem, prize, prise\t";
    }
    ""
}
