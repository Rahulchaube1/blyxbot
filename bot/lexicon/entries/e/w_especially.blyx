// especially — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_especially(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adv 00084223
    if sense == 1 {
        return "adverb\tto a distinctly greater extent or degree than is common\tparticularly, peculiarly, specially\tan especially (or specially) cautious approach to the danger";
    }
    ""
}
