// excitement — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_excitement(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 07528212
    if sense == 1 {
        return "noun\tthe feeling of lively and cheerful joy\texhilaration\the could hardly conceal his excitement when she agreed";
    }
    // noun 14037011
    if sense == 2 {
        return "noun\tthe state of being emotionally aroused and worked up\texcitation, inflammation, fervor, fervour\this face was flushed with excitement and his hands trembled";
    }
    // noun 01260867
    if sense == 3 {
        return "noun\tsomething that agitates and arouses\texcitation\the looked forward to the excitements of the day";
    }
    // noun 00554300
    if sense == 4 {
        return "noun\tdisturbance usually in protest\tagitation, turmoil, upheaval, hullabaloo\t";
    }
    ""
}
