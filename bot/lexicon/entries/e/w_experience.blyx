// experience — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_experience(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 05758059
    if sense == 1 {
        return "noun\tthe accumulation of knowledge or skill that results from direct participation in events or activities\t\ta man of experience";
    }
    // noun 05984584
    if sense == 2 {
        return "noun\tthe content of direct observation or participation in an event\t\the had a religious experience";
    }
    // noun 07285403
    if sense == 3 {
        return "noun\tan event as apprehended\t\ta surprising experience";
    }
    // verb 02110220
    if sense == 4 {
        return "verb\tgo or live through\tsee, go through\t";
    }
    // verb 00596644
    if sense == 5 {
        return "verb\thave firsthand knowledge of states, situations, emotions, or sensations\tknow, live\t";
    }
    // verb 02108026
    if sense == 6 {
        return "verb\tgo through (mental or physical states or experiences)\treceive, have, get\texperience vertigo";
    }
    // verb 01771535
    if sense == 7 {
        return "verb\tundergo an emotional sensation or be in a particular state of mind\tfeel\t";
    }
    ""
}
