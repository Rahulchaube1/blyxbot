// edge — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_edge(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 08565701
    if sense == 1 {
        return "noun\tthe boundary of a surface\tborder\t";
    }
    // noun 13903079
    if sense == 2 {
        return "noun\ta line determining the limits of an area\tboundary, bound\t";
    }
    // noun 03264136
    if sense == 3 {
        return "noun\ta sharp side formed by the intersection of two surfaces of an object\t\the rounded the edges of the box";
    }
    // verb 02072501
    if sense == 4 {
        return "verb\tadvance slowly, as if by inches\tinch\tHe edged towards the car";
    }
    // noun 05171978
    if sense == 5 {
        return "noun\tthe attribute of urgency in tone of voice\tsharpness\this voice had an edge to it";
    }
    // noun 05158857
    if sense == 6 {
        return "noun\ta slight competitive advantage\t\the had an edge on the competition";
    }
    // noun 03264542
    if sense == 7 {
        return "noun\tthe outside limit of an object or area or surface; a place farthest away from the center of something\t\tthe edge of the leaf is wavy";
    }
    ""
}
