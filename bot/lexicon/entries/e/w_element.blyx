// element — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_element(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 05868954
    if sense == 1 {
        return "noun\tan abstract part of something\tcomponent, constituent, factor, ingredient\tthe grammatical elements of a sentence";
    }
    // noun 03081021
    if sense == 2 {
        return "noun\tan artifact that is one of the individual parts of which a composite entity is made up; especially a part that can be separated from or attached to a system\tcomponent, constituent\ta component or constituent element of a system";
    }
    // noun 14622893
    if sense == 3 {
        return "noun\tany of the more than 100 known substances (of which 92 occur naturally) that cannot be separated into simpler substances and that singly or in combination constitute all matter\tchemical element\t";
    }
    // noun 08568579
    if sense == 4 {
        return "noun\tthe most favorable environment for a plant or animal\t\twater is the element of fishes";
    }
    ""
}
