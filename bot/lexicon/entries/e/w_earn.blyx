// earn — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_earn(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02289295
    if sense == 1 {
        return "verb\tearn on some commercial or business transaction; earn as salary or wages\tgain, take in, clear, make, realize, realise, pull in, bring in\tShe earns a lot in her new job";
    }
    // verb 02290196
    if sense == 2 {
        return "verb\tacquire or deserve by one's efforts or actions\tgarner\t";
    }
    ""
}
