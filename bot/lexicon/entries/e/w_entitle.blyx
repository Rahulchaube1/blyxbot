// entitle — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_entitle(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02447370
    if sense == 1 {
        return "verb\tgive the right to\t\tThe Freedom of Information Act entitles you to request your FBI file";
    }
    // verb 01029500
    if sense == 2 {
        return "verb\tgive a title to\ttitle\t";
    }
    ""
}
