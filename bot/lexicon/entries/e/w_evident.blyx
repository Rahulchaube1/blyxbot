// evident — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_evident(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 01618376
    if sense == 1 {
        return "adjective\tclearly revealed to the mind or the senses or judgment\tapparent, manifest, patent, plain, unmistakable\tevident hostility";
    }
    // adj 01287486
    if sense == 2 {
        return "adjective\tcapable of being seen or noticed\tdiscernible, observable\ta clearly evident erasure in the manuscript";
    }
    ""
}
