// exist — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_exist(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02603699
    if sense == 1 {
        return "verb\thave an existence, be extant\tbe\t";
    }
    // verb 02616713
    if sense == 2 {
        return "verb\tsupport oneself\tsurvive, live, subsist\the could barely exist on such a low wage";
    }
    ""
}
