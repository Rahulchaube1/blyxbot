// entirely — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_entirely(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00008007
    if sense == 1 {
        return "adverb\tto a complete degree or to the full or entire extent (`whole' is often used informally for `wholly')\twholly, completely, totally, all, altogether, whole\tentirely satisfied with the meal";
    }
    // adv 00008600
    if sense == 2 {
        return "adverb\twithout any others being included or involved\texclusively, solely, alone, only\twas entirely to blame";
    }
    ""
}
