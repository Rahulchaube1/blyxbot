// error — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_error(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // noun 00070965
    if sense == 1 {
        return "noun\ta wrong action attributable to bad judgment or ignorance or inattention\tmistake, fault\tshe was quick to point out my errors";
    }
    // noun 04802629
    if sense == 2 {
        return "noun\tinadvertent incorrectness\terroneousness\t";
    }
    // noun 05895465
    if sense == 3 {
        return "noun\ta misconception resulting from incorrect information\terroneous belief\t";
    }
    // noun 00072068
    if sense == 4 {
        return "noun\t(baseball) a failure of a defensive player to make an out when normal play would have sufficed\tmisplay\t";
    }
    // noun 04853765
    if sense == 5 {
        return "noun\tdeparture from what is ethically acceptable\twrongdoing\t";
    }
    ""
}
