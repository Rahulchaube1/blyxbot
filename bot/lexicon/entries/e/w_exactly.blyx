// exactly — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_exactly(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00158309
    if sense == 1 {
        return "adverb\tindicating exactness or preciseness\tprecisely, just\the was doing precisely (or exactly) what she had told him to do";
    }
    // adv 00368663
    if sense == 2 {
        return "adverb\tjust as it should be\tprecisely, on the nose, on the dot, on the button\t";
    }
    ""
}
