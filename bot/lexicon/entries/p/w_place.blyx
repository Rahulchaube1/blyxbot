// place — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_place(sense: i64) -> str {
    if sense == 0 { return "27"; }
    // verb 01494310
    if sense == 1 {
        return "verb\tput into a certain place or abstract location\tput, set, pose, position, lay\tPlace emphasis on a certain point";
    }
    // noun 08664443
    if sense == 2 {
        return "noun\ta point located with respect to surface features of some region\ttopographic point, spot\tthis is a nice place for a picnic";
    }
    // noun 08513718
    if sense == 3 {
        return "noun\tany area set aside for a particular purpose\tproperty\twho owns this place?";
    }
    // noun 05611822
    if sense == 4 {
        return "noun\tan abstract mental location\t\the has a special place in my thoughts";
    }
    // noun 08642037
    if sense == 5 {
        return "noun\ta general vicinity\t\tHe comes from a place near Chicago";
    }
    // verb 02392762
    if sense == 6 {
        return "verb\tplace somebody in a particular situation or location\t\the was placed on probation";
    }
    // noun 00721431
    if sense == 7 {
        return "noun\tthe post or function properly or customarily occupied or served by another\tstead, position, lieu\ttook his place";
    }
    // noun 13926786
    if sense == 8 {
        return "noun\ta particular situation\tshoes\tIf you were in my place what would you do?";
    }
    // verb 00658052
    if sense == 9 {
        return "verb\tassign a rank or rating to\trate, rank, range, order, grade\t";
    }
    // noun 08559508
    if sense == 10 {
        return "noun\twhere you live at a particular time\thome\tyour place or mine?";
    }
    // noun 00586262
    if sense == 11 {
        return "noun\ta job in an organization\tposition, post, berth, office, spot, billet, situation\t";
    }
    // verb 02333689
    if sense == 12 {
        return "verb\tassign a location to\tlocate, site\t";
    }
    // verb 00745970
    if sense == 13 {
        return "verb\tto arrange for\t\tplace a phone call";
    }
    // noun 08621598
    if sense == 14 {
        return "noun\tthe particular portion of space occupied by something\tposition\the put the lamp back in its place";
    }
    // verb 00659776
    if sense == 15 {
        return "verb\ttake a place in a competition; often followed by an ordinal\tcome in, come out\t";
    }
    // noun 13947645
    if sense == 16 {
        return "noun\tproper or designated social situation\tstation\the overstepped his place";
    }
    // noun 08647616
    if sense == 17 {
        return "noun\ta space reserved for sitting (as in a theater or on a train or airplane)\tseat\the sat in someone else's place";
    }
    // noun 06401107
    if sense == 18 {
        return "noun\tthe passage that is being read\t\the lost his place on the page";
    }
    // verb 01150559
    if sense == 19 {
        return "verb\tintend (something) to move towards a certain goal\ttarget, aim, direct, point\t";
    }
    // verb 00618878
    if sense == 20 {
        return "verb\trecognize as being; establish the identity of someone or something\tidentify\t";
    }
    // noun 13947867
    if sense == 21 {
        return "noun\tproper or appropriate position or location\t\ta woman's place is no longer in the kitchen";
    }
    // noun 08619795
    if sense == 22 {
        return "noun\ta public square with room for pedestrians\tplaza, piazza\tGrosvenor Place";
    }
    // noun 06483454
    if sense == 23 {
        return "noun\tan item on a list or in a sequence\tposition\tin the second place";
    }
    // noun 06389553
    if sense == 24 {
        return "noun\ta blank area\tspace, blank space\t";
    }
    // verb 02537960
    if sense == 25 {
        return "verb\tassign to (a job or a home)\t\t";
    }
    // verb 01711749
    if sense == 26 {
        return "verb\tlocate\tset, localize, localise\t";
    }
    // verb 00673448
    if sense == 27 {
        return "verb\testimate\tput, set\t";
    }
    ""
}
