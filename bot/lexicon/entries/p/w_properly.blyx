// properly — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_properly(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adv 00196203
    if sense == 1 {
        return "adverb\tin the right manner\tdecently, decent, in good order, right, the right way\tplease do your job properly!";
    }
    // adv 00505450
    if sense == 2 {
        return "adverb\twith reason or justice\tby rights\t";
    }
    ""
}
