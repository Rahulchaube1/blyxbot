// primary — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_primary(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // adj 01852174
    if sense == 1 {
        return "adjective\tof first rank or importance or value; direct and immediate rather than secondary\t\tprimary goals";
    }
    // adj 00699521
    if sense == 2 {
        return "adjective\tnot derived from or reducible to something else; basic\t\ta primary instinct";
    }
    // adj 01277426
    if sense == 3 {
        return "adjective\tmost important element\tchief, main, principal, master\tpolicemen were primary targets";
    }
    // noun 00182571
    if sense == 4 {
        return "noun\ta preliminary election where delegates or nominees are chosen\tprimary election\t";
    }
    // noun 02469080
    if sense == 5 {
        return "noun\tone of the main flight feathers projecting along the outer edge of a bird's wing\tprimary feather, primary quill\t";
    }
    ""
}
