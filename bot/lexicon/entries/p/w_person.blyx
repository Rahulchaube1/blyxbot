// person — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_person(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 00007846
    if sense == 1 {
        return "noun\ta human being\tindividual, someone, somebody, mortal, soul\tthere was too much for one person to do";
    }
    // noun 05217688
    if sense == 2 {
        return "noun\ta human body (usually including the clothing)\t\ta weapon was hidden on his person";
    }
    ""
}
