// process — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_process(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // noun 01023820
    if sense == 1 {
        return "noun\ta particular course of action intended to achieve a result\tprocedure\tit was a process of trial and error";
    }
    // noun 05701363
    if sense == 2 {
        return "noun\t(psychology) the performance of some composite cognitive activity; an operation that affects mental contents\tcognitive process, mental process, operation, cognitive operation\tthe process of thinking";
    }
    // verb 00515154
    if sense == 3 {
        return "verb\tsubject to a process or treatment, with the aim of readying for some purpose, improving, or remedying a condition\ttreat\tprocess cheese";
    }
    // verb 02438535
    if sense == 4 {
        return "verb\tdeal with in a routine way\t\tprocess a loan";
    }
    // verb 00638837
    if sense == 5 {
        return "verb\tperform mathematical and logical operations on (data) according to programmed instructions in order to obtain the required information\t\tThe results of the elections were still being processed when he gave his acceptance speech";
    }
    ""
}
