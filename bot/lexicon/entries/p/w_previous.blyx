// previous — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_previous(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 00127137
    if sense == 1 {
        return "adjective\tjust preceding something else in time or order\told\tthe previous owner";
    }
    // adj 01729819
    if sense == 2 {
        return "adjective\t(used especially of persons) of the immediate past\tformer, late\tthe previous occupant of the White House";
    }
    ""
}
