// procedure — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_procedure(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 01023820
    if sense == 1 {
        return "noun\ta particular course of action intended to achieve a result\tprocess\tthe procedure of obtaining a driver's license";
    }
    // noun 00577068
    if sense == 2 {
        return "noun\ta process or series of acts especially of a practical or mechanical nature involved in a particular form of work\toperation\t";
    }
    ""
}
