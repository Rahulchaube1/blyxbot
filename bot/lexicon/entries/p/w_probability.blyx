// probability — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_probability(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 05091770
    if sense == 1 {
        return "noun\ta measure of how likely it is that some event will occur; a number expressing the ratio of favorable cases to the whole number of cases possible\tchance\tthe probability that an unbiased coin will fall with the head up is 0.5";
    }
    // noun 04756172
    if sense == 2 {
        return "noun\tthe quality of being probable; a probable event or the most probable event\t\tfor a while mutiny seemed a probability";
    }
    ""
}
