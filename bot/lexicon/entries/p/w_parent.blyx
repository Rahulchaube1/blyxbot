// parent — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_parent(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 10399491
    if sense == 1 {
        return "noun\ta father or mother; one who begets or one who gives birth to or nurtures and raises a child; a relative who plays the role of guardian\t\t";
    }
    ""
}
