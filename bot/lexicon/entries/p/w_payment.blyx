// payment — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_payment(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 13278375
    if sense == 1 {
        return "noun\ta sum of money paid or a claim discharged\t\t";
    }
    // noun 01120448
    if sense == 2 {
        return "noun\tthe act of paying money\tdefrayal, defrayment\t";
    }
    ""
}
