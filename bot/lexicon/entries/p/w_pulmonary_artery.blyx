// pulmonary artery — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_pulmonary_artery(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 05353819
    if sense == 1 {
        return "noun\tone of two arteries (branches of the pulmonary trunk) that carry venous blood from the heart to the lungs\tarteria pulmonalis\t";
    }
    ""
}
