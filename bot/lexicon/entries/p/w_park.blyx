// park — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_park(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // noun 08615149
    if sense == 1 {
        return "noun\ta large area of land preserved in its natural state as public property\tparkland\tthere are laws that protect the wildlife in this park";
    }
    // verb 01493380
    if sense == 2 {
        return "verb\tplace temporarily\t\tpark the car in the yard";
    }
    // noun 08615374
    if sense == 3 {
        return "noun\ta piece of open land for recreational use in an urban area\tcommons, common, green\tthey went for a walk in the park";
    }
    // verb 01934427
    if sense == 4 {
        return "verb\tmaneuver a vehicle into a parking space\t\tPark the car in front of the library";
    }
    // noun 02782778
    if sense == 5 {
        return "noun\ta facility in which ball games are played (especially baseball games)\tballpark\t";
    }
    ""
}
