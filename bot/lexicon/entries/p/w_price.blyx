// price — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_price(sense: i64) -> str {
    if sense == 0 { return "6"; }
    // noun 05145118
    if sense == 1 {
        return "noun\tthe property of having material worth (often indicated by the amount of money something would bring if sold)\tmonetary value, cost\the puts a high price on his services";
    }
    // noun 13303315
    if sense == 2 {
        return "noun\tthe amount of money needed to purchase something\tterms, damage\tthe price of gasoline";
    }
    // verb 02351010
    if sense == 3 {
        return "verb\tdetermine the price of\t\tThe grocer priced his wares high";
    }
    // noun 05163807
    if sense == 4 {
        return "noun\tvalue measured by what must be given or done or undergone to obtain something\tcost, toll\tthe price of success is hard work";
    }
    // noun 05141683
    if sense == 5 {
        return "noun\tthe high value or worth of something\t\ther price is far above rubies";
    }
    // noun 07167041
    if sense == 6 {
        return "noun\ta monetary reward for helping to catch a criminal\t\tthe cattle thief has a price on his head";
    }
    ""
}
