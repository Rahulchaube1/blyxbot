// politics — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_politics(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 13840719
    if sense == 1 {
        return "noun\tsocial relations involving intrigue to gain authority or power\tpolitical relation\toffice politics is often counterproductive";
    }
    // noun 06148148
    if sense == 2 {
        return "noun\tthe study of government of states and other political units\tpolitical science, government\t";
    }
    // noun 00611972
    if sense == 3 {
        return "noun\tthe profession devoted to governing and to political affairs\t\t";
    }
    // noun 06149192
    if sense == 4 {
        return "noun\tthe opinion you hold with respect to political questions\tpolitical sympathies\t";
    }
    ""
}
