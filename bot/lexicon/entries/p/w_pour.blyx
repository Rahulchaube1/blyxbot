// pour — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_pour(sense: i64) -> str {
    if sense == 0 { return "5"; }
    // verb 02069551
    if sense == 1 {
        return "verb\tcause to run\t\tpour water over the floor";
    }
    // verb 02028366
    if sense == 2 {
        return "verb\tmove in large numbers\tswarm, stream, teem, pullulate\tpeople were pouring out of the theater";
    }
    // verb 02070296
    if sense == 3 {
        return "verb\tpour out\tdecant, pour out\t";
    }
    // verb 02069248
    if sense == 4 {
        return "verb\tflow in a spurt\t\tWater poured all over the floor";
    }
    // verb 02355806
    if sense == 5 {
        return "verb\tsupply in large amounts or quantities\t\tWe poured money into the education of our children";
    }
    ""
}
