// protect — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_protect(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 01128193
    if sense == 1 {
        return "verb\tshield from danger, injury, destruction, or damage\t\tWeatherbeater protects your roof from the rain";
    }
    // verb 01129710
    if sense == 2 {
        return "verb\tuse tariffs to favor domestic industry\t\t";
    }
    ""
}
