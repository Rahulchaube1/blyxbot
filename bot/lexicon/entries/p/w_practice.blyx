// practice — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_practice(sense: i64) -> str {
    if sense == 0 { return "9"; }
    // noun 00410247
    if sense == 1 {
        return "noun\ta customary way of operation or behavior\tpattern\tit is their practice to give annual raises";
    }
    // verb 02568672
    if sense == 2 {
        return "verb\tcarry out or practice; as of jobs and professions\tpractise, exercise, do\tpractice law";
    }
    // verb 00606093
    if sense == 3 {
        return "verb\tlearn by repetition\tdrill, exercise, practise\tPianists practice scales";
    }
    // noun 00894552
    if sense == 4 {
        return "noun\tsystematic training by multiple repetitions\texercise, drill, practice session, recitation\tpractice makes perfect";
    }
    // verb 01723224
    if sense == 5 {
        return "verb\tengage in a rehearsal (of)\trehearse, practise\t";
    }
    // noun 00411048
    if sense == 6 {
        return "noun\ttranslating an idea into action\tpraxis\ta hard theory to put into practice";
    }
    // noun 00631378
    if sense == 7 {
        return "noun\tthe exercise of a profession\t\tthe practice of the law";
    }
    // verb 02561332
    if sense == 8 {
        return "verb\tavail oneself to\tapply, use\tpractice a religion";
    }
    // noun 05667196
    if sense == 9 {
        return "noun\tknowledge of how something is usually done\t\tit is not the local practice to wear shorts to dinner";
    }
    ""
}
