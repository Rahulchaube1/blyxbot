// persuade — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_persuade(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02586121
    if sense == 1 {
        return "verb\twin approval or support for\tcarry, sway\t";
    }
    // verb 00766418
    if sense == 2 {
        return "verb\tcause somebody to adopt a certain position, belief, or course of action; twist somebody's arm\t\tYou can't persuade me to buy this ugly vase!";
    }
    ""
}
