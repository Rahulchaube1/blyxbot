// percent — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_percent(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // noun 13817526
    if sense == 1 {
        return "noun\ta proportion in relation to a whole (which is usually the amount per hundred)\tpercentage, per centum, pct\t";
    }
    ""
}
