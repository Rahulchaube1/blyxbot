// post — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_post(sense: i64) -> str {
    if sense == 0 { return "9"; }
    // noun 08624385
    if sense == 1 {
        return "noun\tthe position where someone (as a guard or sentry) stands or is assigned to stand\tstation\ta soldier manned the entrance post";
    }
    // noun 03763403
    if sense == 2 {
        return "noun\tmilitary installation at which a body of troops is stationed\tmilitary post\tthis military post provides an important source of income for the town nearby";
    }
    // noun 00586262
    if sense == 3 {
        return "noun\ta job in an organization\tposition, berth, office, spot, billet, place, situation\the occupied a post in the treasury";
    }
    // verb 01591621
    if sense == 4 {
        return "verb\taffix in a public place or for public notice\t\tpost a warning";
    }
    // verb 00991683
    if sense == 5 {
        return "verb\tpublicize with, or as if with, a poster\t\tI'll post the news on the bulletin board";
    }
    // noun 03988170
    if sense == 6 {
        return "noun\tan upright consisting of a piece of timber or metal fixed firmly in an upright position\t\the set a row of posts in the ground and strung barbwire between them";
    }
    // verb 02385634
    if sense == 7 {
        return "verb\tassign to a post; put into a post\t\tThe newspaper posted him in Timbuktu";
    }
    // verb 01088923
    if sense == 8 {
        return "verb\tassign to a station\tstation, send, place\t";
    }
    // verb 00999715
    if sense == 9 {
        return "verb\tdisplay, as of records in sports games\t\t";
    }
    ""
}
