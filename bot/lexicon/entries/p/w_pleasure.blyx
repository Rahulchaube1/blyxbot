// pleasure — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_pleasure(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 07490713
    if sense == 1 {
        return "noun\ta fundamental feeling that is hard to define but that people desire to experience\tpleasance\the was tingling with pleasure";
    }
    // noun 05829782
    if sense == 2 {
        return "noun\tsomething or someone that provides a source of happiness\tjoy, delight\tthe pleasure of his company";
    }
    ""
}
