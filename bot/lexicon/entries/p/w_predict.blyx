// predict — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_predict(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00917772
    if sense == 1 {
        return "verb\tmake a prediction about; tell in advance\tforetell, prognosticate, call, forebode, anticipate, promise\t";
    }
    // verb 00871942
    if sense == 2 {
        return "verb\tindicate by signs\tbode, portend, auspicate, prognosticate, omen, presage, betoken, foreshadow, augur, foretell, prefigure, forecast\t";
    }
    ""
}
