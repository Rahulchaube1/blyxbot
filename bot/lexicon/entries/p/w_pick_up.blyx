    }
    // verb 02305586
    if sense == 4 {
        return "verb\tgather or collect\tcollect, gather up, call for\tThey pick up our trash twice a week";
    }
    // verb 00598954
    if sense == 5 {
        return "verb\tget to know or become aware of, usually accidentally\tlearn, hear, get word, get wind, find out, get a line, discover, see\t";
    }
    // verb 02355410
    if sense == 6 {
        return "verb\tget in addition, as an increase\t\t";
    }
    // verb 01215137
    if sense == 7 {
