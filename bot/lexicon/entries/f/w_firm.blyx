// firm — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_firm(sense: i64) -> str {
    if sense == 0 { return "10"; }
    // noun 08059870
    if sense == 1 {
        return "noun\tthe members of a business organization that owns or operates one or more establishments\thouse, business firm\t";
    }
    // adj 01990653
    if sense == 2 {
        return "adjective\tmarked by firm determination or resolution; not shakable\tsteadfast, steady, stiff, unbendable, unfaltering, unshakable, unwavering\tfirm convictions";
    }
    // adj 01151740
    if sense == 3 {
        return "adjective\tnot soft or yielding to pressure\tsolid\ta firm mattress";
    }
    // adj 00842199
    if sense == 4 {
        return "adjective\tstrong and sure\tstrong\ta firm grasp";
    }
    // adj 02130272
    if sense == 5 {
        return "adjective\tnot subject to revision or change\t\ta firm contract";
    }
    // adj 02302366
    if sense == 6 {
        return "adjective\t(of especially a person's physical features) not shaking or trembling\t\this voice was firm and confident";
    }
    // adj 02291336
    if sense == 7 {
        return "adjective\tnot liable to fluctuate or especially to fall\tsteady, unfluctuating\tstocks are still firm";
    }
    // adj 02094388
    if sense == 8 {
        return "adjective\tsecurely established\t\tholds a firm position as the country's leading poet";
    }
    // adj 01171076
    if sense == 9 {
        return "adjective\tpossessing the tone and resiliency of healthy tissue\t\tfirm muscles";
    }
    // adv 00050817
    if sense == 10 {
        return "adverb\twith resolute determination\tfirmly, steadfastly, unwaveringly\tyou must stand firm";
    }
    ""
}
