// former — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_former(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // adj 01047301
    if sense == 1 {
        return "adjective\treferring to the first of two things or persons mentioned (or the earlier one or ones of several)\t\tthe novel was made into a film in 1943 and again in 1967; I prefer the former version to the latter one";
    }
    // adj 01729566
    if sense == 2 {
        return "adjective\tbelonging to some prior time\terstwhile, old, onetime, one-time, quondam, sometime\tour former glory";
    }
    // adj 01729819
    if sense == 3 {
        return "adjective\t(used especially of persons) of the immediate past\tlate, previous\tthe former president";
    }
    ""
}
