// famous — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_famous(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 01375831
    if sense == 1 {
        return "adjective\twidely known and esteemed\tcelebrated, famed, far-famed, illustrious, notable, noted, renowned\ta famous actor";
    }
    ""
}
