// fluid — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_fluid(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 14939900
    if sense == 1 {
        return "noun\ta substance that is fluid at room temperature and pressure\t\t";
    }
    // noun 14939445
    if sense == 2 {
        return "noun\tcontinuous amorphous matter that tends to flow and to conform to the outline of its container: a liquid or a gas\t\t";
    }
    // adj 00345494
    if sense == 3 {
        return "adjective\tsubject to change; variable\tunstable\ta fluid situation fraught with uncertainty";
    }
    ""
}
