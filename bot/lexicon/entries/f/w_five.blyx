// five — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_five(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // adj 02186750
    if sense == 1 {
        return "adjective\tbeing one more than four\t5, v\t";
    }
    // noun 13744521
    if sense == 2 {
        return "noun\tthe cardinal number that is the sum of four and one\t5, V, cinque, quint, quintet, fivesome, quintuplet, pentad, fin, Phoebe, Little Phoebe\t";
    }
    ""
}
