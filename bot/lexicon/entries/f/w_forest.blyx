// forest — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_forest(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 08438533
    if sense == 1 {
        return "noun\tthe trees and other plants in a large densely wooded area\twood, woods\t";
    }
    // noun 09284015
    if sense == 2 {
        return "noun\tland that is covered with trees and shrubs\twoodland, timberland, timber\t";
    }
    ""
}
