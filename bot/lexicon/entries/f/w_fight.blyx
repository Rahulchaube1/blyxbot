// fight — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_fight(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 01090335
    if sense == 1 {
        return "verb\tbe engaged in a fight; carry on a fight\tcontend, struggle\tSiblings are always fighting";
    }
    // verb 01091427
    if sense == 2 {
        return "verb\tfight against or resist strongly\toppose, fight back, fight down, defend\tDon't fight it!";
    }
    // noun 00953559
    if sense == 3 {
        return "noun\ta hostile meeting of opposing military forces in the course of a war\tbattle, conflict, engagement\t";
    }
    // noun 01170962
    if sense == 4 {
        return "noun\tthe act of fighting; any contest or struggle\tfighting, combat, scrap\ta fight broke out at the hockey game";
    }
    // verb 02407338
    if sense == 5 {
        return "verb\tmake a strenuous or labored effort\tstruggle\t";
    }
    // verb 02589576
    if sense == 6 {
        return "verb\texert oneself continuously, vigorously, or obtrusively to gain an end or engage in a crusade for a certain cause or person; be an advocate for\tcrusade, press, campaign, push, agitate\t";
    }
    // noun 04837425
    if sense == 7 {
        return "noun\tan aggressive willingness to compete\tcompetitiveness\tthe team was full of fight";
    }
    ""
}
