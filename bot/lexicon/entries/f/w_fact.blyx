// fact — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_fact(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 05817396
    if sense == 1 {
        return "noun\ta piece of information about circumstances that exist or events that have occurred\t\tfirst you must collect all the facts of the case";
    }
    // noun 06636259
    if sense == 2 {
        return "noun\ta statement or assertion of verified information about something that is the case or has happened\t\the supported his argument with an impressive array of facts";
    }
    // noun 13955874
    if sense == 3 {
        return "noun\tan event known to have happened or something known to have existed\t\tyour fears have no basis in fact";
    }
    // noun 05889896
    if sense == 4 {
        return "noun\ta concept whose truth can be proved\t\tscientific hypotheses are not facts";
    }
    ""
}
