// finance — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_finance(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02217266
    if sense == 1 {
        return "verb\tobtain or provide money for\t\tCan we finance the addition to our home?";
    }
    // noun 01098698
    if sense == 2 {
        return "noun\tthe commercial activity of providing funds and capital\t\t";
    }
    ""
}
