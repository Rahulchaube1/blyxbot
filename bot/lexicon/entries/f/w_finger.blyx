// finger — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_finger(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // noun 05566504
    if sense == 1 {
        return "noun\tany of the terminal members of the hand (sometimes excepting the thumb)\t\ther fingers were long and thin";
    }
    // verb 01209953
    if sense == 2 {
        return "verb\tfeel or handle with the fingers\tthumb\tfinger the binding of the book";
    }
    // verb 01209678
    if sense == 3 {
        return "verb\texamine by touch\tfeel\tThe customer fingered the sweater";
    }
    ""
}
