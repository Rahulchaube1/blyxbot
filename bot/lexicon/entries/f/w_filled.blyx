// filled — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_filled(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 01084644
    if sense == 1 {
        return "adjective\t(usually followed by `with' or used as a combining form) generously supplied with\t\ttheirs was a house filled with laughter";
    }
    ""
}
