    }
    // verb 00151689
    if sense == 14 {
        return "verb\tdecrease in size, extent, or range\tdecrease, diminish, lessen\t";
    }
    // noun 09265620
    if sense == 15 {
        return "noun\ta downward slope or bend\tdescent, declivity, decline, declination, declension, downslope\t";
