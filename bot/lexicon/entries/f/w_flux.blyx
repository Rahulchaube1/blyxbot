// flux — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_flux(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // noun 15278132
    if sense == 1 {
        return "noun\tthe rate of flow of energy or particles across a given surface\t\t";
    }
    // noun 07407970
    if sense == 2 {
        return "noun\ta flow or discharge\tfluxion\t";
    }
    ""
}
