// laugh — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_laugh(sense: i64) -> str {
    if sense == 0 { return "3"; }
    // verb 00031820
    if sense == 1 {
        return "verb\tproduce laughter\texpress joy, express mirth\t";
    }
    // noun 07127006
    if sense == 2 {
        return "noun\tthe sound of laughing\tlaughter\t";
    }
    // noun 06878404
    if sense == 3 {
        return "noun\ta facial expression characteristic of a person laughing\t\this face wrinkled in a silent laugh of derision";
    }
    ""
}
