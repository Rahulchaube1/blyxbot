// lock — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_lock(sense: i64) -> str {
    if sense == 0 { return "10"; }
    // verb 01348174
    if sense == 1 {
        return "verb\tfasten with a lock\t\tlock the bike to the fence";
    }
    // verb 01510827
    if sense == 2 {
        return "verb\tkeep engaged\tengage, mesh, operate\t";
    }
    // noun 03682487
    if sense == 3 {
        return "noun\ta fastener fitted to a door or drawer to keep it firmly closed\t\t";
    }
    // verb 00219775
    if sense == 4 {
        return "verb\tbecome rigid or immoveable\t\tThe therapist noticed that the patient's knees tended to lock in this exercise";
    }
    // noun 05257737
    if sense == 5 {
        return "noun\ta strand or cluster of hair\tcurl, ringlet, whorl\t";
    }
    // verb 01606736
    if sense == 6 {
        return "verb\thold in a locking position\tinterlock, interlace\tHe locked his hands around her neck";
    }
    // verb 01606018
    if sense == 7 {
        return "verb\tbecome engaged or intermeshed with one another\tinterlock\tThey were locked in embrace";
    }
    // noun 03683341
    if sense == 8 {
        return "noun\ta mechanism that detonates the charge of a gun\t\t";
    }
    // verb 01810320
    if sense == 9 {
        return "verb\thold fast (in a certain state)\t\tHe was locked in a laughing fit";
    }
    // verb 01347678
    if sense == 10 {
        return "verb\tplace in a place where something cannot be removed or someone cannot escape\tlock in, lock away, put away, shut up, shut away, lock up\tThe parents locked her daughter up for the weekend";
    }
    ""
}
