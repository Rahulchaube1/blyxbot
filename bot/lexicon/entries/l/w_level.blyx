// level — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_level(sense: i64) -> str {
    if sense == 0 { return "13"; }
    // noun 05093890
    if sense == 1 {
        return "noun\ta position on a scale of intensity or amount or quality\tdegree, grade\ta high level of care is required";
    }
    // noun 14428160
    if sense == 2 {
        return "noun\ta relative position or degree of value in a graded group\tgrade, tier\t";
    }
    // noun 13939892
    if sense == 3 {
        return "noun\ta specific identifiable position in a continuum or series or especially in a process\tdegree, stage, point\t";
    }
    // noun 05131902
    if sense == 4 {
        return "noun\theight above ground\t\tthe water reached ankle level";
    }
    // verb 01152896
    if sense == 5 {
        return "verb\taim at\t\tlevel criticism or charges at somebody";
    }
    // adj 00910101
    if sense == 6 {
        return "adjective\thaving a surface without slope, tilt in which no part is higher or lower than another\tflat, plane\tacres of level farmland";
    }
    // noun 03658858
    if sense == 7 {
        return "noun\tindicator that establishes the horizontal when a bubble is centered in a tube of liquid\tspirit level\t";
    }
    // noun 03536348
    if sense == 8 {
        return "noun\ta flat surface at right angles to a plumb line\thorizontal surface\tpark the car on the level";
    }
    // verb 01661804
    if sense == 9 {
        return "verb\ttear down so as to make flat with the ground\traze, rase, dismantle, tear down, take down, pull down\tThe building was levelled";
    }
    // verb 01307142
    if sense == 10 {
        return "verb\tmake level or straight\tflush, even out, even\tlevel the ground";
    }
    // adj 02302537
    if sense == 11 {
        return "adjective\tnot showing abrupt variations\tunwavering\tspoke in a level voice";
    }
    // adj 01233104
    if sense == 12 {
        return "adjective\tbeing on a precise horizontal plane\t\ta billiard table must be level";
    }
    // adj 00911091
    if sense == 13 {
        return "adjective\toriented at right angles to the plumb\t\tthe picture is level";
    }
    ""
}
