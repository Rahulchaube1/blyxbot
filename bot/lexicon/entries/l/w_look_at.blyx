// look at — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_look_at(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 00734054
    if sense == 1 {
        return "verb\ttake into consideration for exemplifying purposes\tconsider, take, deal\t";
    }
    // verb 02130300
    if sense == 2 {
        return "verb\tlook at carefully; study mentally\tview, consider\t";
    }
    ""
}
