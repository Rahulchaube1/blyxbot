// love — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_love(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // verb 01775164
    if sense == 1 {
        return "verb\thave a great affection or liking for\t\tI love French food";
    }
    // noun 07543288
    if sense == 2 {
        return "noun\ta strong positive emotion of regard and affection\t\this love for his work";
    }
    // verb 01828736
    if sense == 3 {
        return "verb\tget pleasure from\tenjoy\tI love cooking";
    }
    // verb 01775535
    if sense == 4 {
        return "verb\tbe enamored or in love with\t\tShe loves her husband deeply";
    }
    // noun 05813229
    if sense == 5 {
        return "noun\tany object of warm affection or devotion\tpassion\tthe theater was her first love";
    }
    // noun 09849598
    if sense == 6 {
        return "noun\ta beloved person; used as terms of endearment\tbeloved, dear, dearest, honey\t";
    }
    // noun 07488340
    if sense == 7 {
        return "noun\ta deep feeling of sexual desire and attraction\tsexual love, erotic love\ttheir love left them indifferent to their surroundings";
    }
    ""
}
