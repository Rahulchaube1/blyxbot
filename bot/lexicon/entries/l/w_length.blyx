// length — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_length(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 05129201
    if sense == 1 {
        return "noun\tthe linear extent in space from one end to the other; the longest dimension of something that is fixed in place\t\tthe length of the table was 5 feet";
    }
    // noun 05051249
    if sense == 2 {
        return "noun\tcontinuance in time\tduration\the complained about the length of time required";
    }
    // noun 05133107
    if sense == 3 {
        return "noun\tthe property of being the extent of something from beginning to end\t\tthe editor limited the length of my article to 500 words";
    }
    // noun 05129565
    if sense == 4 {
        return "noun\tsize of the gap between two places\tdistance\the determined the length of the shortest line segment joining the two points";
    }
    ""
}
