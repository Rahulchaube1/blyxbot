// law — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_law(sense: i64) -> str {
    if sense == 0 { return "7"; }
    // noun 08441203
    if sense == 1 {
        return "noun\tthe collection of rules imposed by authority\tjurisprudence\tcivilization presupposes respect for the law";
    }
    // noun 06532330
    if sense == 2 {
        return "noun\tlegal document setting forth rules governing a particular kind of activity\t\tthere is a law against kidnapping";
    }
    // noun 05870916
    if sense == 3 {
        return "noun\ta rule or body of rules of conduct inherent in human nature and essential to or binding upon human society\tnatural law\t";
    }
    // noun 05872982
    if sense == 4 {
        return "noun\ta generalization that describes recurring facts or events in nature\tlaw of nature\tthe laws of thermodynamics";
    }
    // noun 06161718
    if sense == 5 {
        return "noun\tthe branch of philosophy concerned with the law and the principles that lead courts to make the decisions they do\tjurisprudence, legal philosophy\t";
    }
    // noun 00611143
    if sense == 6 {
        return "noun\tthe learned profession that is mastered by graduate study in a law school and that is responsible for the judicial system\tpractice of law\the studied law at Yale";
    }
    // noun 08209687
    if sense == 7 {
        return "noun\tthe force of policemen and officers\tpolice, police force, constabulary\tthe law came looking for him";
    }
    ""
}
