// like — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_like(sense: i64) -> str {
    if sense == 0 { return "8"; }
    // verb 01824736
    if sense == 1 {
        return "verb\tprefer or wish to do something\twish, care\tWould you like to come along to the movies?";
    }
    // verb 01777210
    if sense == 2 {
        return "verb\tfind enjoyable or agreeable\t\tI like jogging";
    }
    // adj 01409581
    if sense == 3 {
        return "adjective\tresembling or similar; having the same or some of the same characteristics; often used in combination\tsimilar\tsuits of like design";
    }
    // verb 01776952
    if sense == 4 {
        return "verb\tbe fond of\t\tI like my nephews";
    }
    // verb 00691665
    if sense == 5 {
        return "verb\tfeel about or towards; consider, evaluate, or regard\t\tHow did you like the President's speech last night?";
    }
    // verb 01825962
    if sense == 6 {
        return "verb\twant to have\t\tI'd like a beer now!";
    }
    // adj 01411065
    if sense == 7 {
        return "adjective\tequal in amount or value\tsame\tlike amounts";
    }
    // adj 01410606
    if sense == 8 {
        return "adjective\thaving the same or similar characteristics\talike, similar\t";
    }
    ""
}
