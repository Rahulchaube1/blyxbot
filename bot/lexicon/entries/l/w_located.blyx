// located — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_located(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // adj 02126430
    if sense == 1 {
        return "adjective\tsituated in a particular spot or position\tplaced, set, situated\tvaluable centrally located urban land";
    }
    ""
}
