// go into — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_go_into(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 02016523
    if sense == 1 {
        return "verb\tto come or go into\tenter, come in, get into, get in, go in, move into\t";
    }
    // verb 02736259
    if sense == 2 {
        return "verb\tbe used or required for\t\t";
    }
    ""
}
