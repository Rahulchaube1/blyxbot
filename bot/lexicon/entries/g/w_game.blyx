// game — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_game(sense: i64) -> str {
    if sense == 0 { return "4"; }
    // noun 00455599
    if sense == 1 {
        return "noun\ta contest with rules to determine a winner\t\tyou need four people to play this game";
    }
    // noun 00456199
    if sense == 2 {
        return "noun\ta single play of a sport or other contest\t\tthe game lasted two hours";
    }
    // noun 00430606
    if sense == 3 {
        return "noun\tan amusement or pastime\t\tthey played word games";
    }
    // noun 02152991
    if sense == 4 {
        return "noun\tanimal hunted for food or sport\t\t";
    }
    ""
}
