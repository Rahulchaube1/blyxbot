// go — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_go(sense: i64) -> str {
    if sense == 0 { return "21"; }
    // verb 01835496
    if sense == 1 {
        return "verb\tchange location; move, travel, or proceed, also metaphorically\ttravel, move, locomote\tHow fast does your new car go?";
    }
    // verb 02372605
    if sense == 2 {
        return "verb\tfollow a procedure or take a course\tproceed, move\tWe should go farther in this matter";
    }
    // verb 01848718
    if sense == 3 {
        return "verb\tmove away from a place into another direction\tgo away, depart\tGo away before I start to cry";
    }
    // verb 00149583
    if sense == 4 {
        return "verb\tenter or assume a certain state or condition\tbecome, get\tGet going!";
    }
    // verb 02653862
    if sense == 5 {
        return "verb\tbe awarded; be allotted\t\tThe first prize goes to Mary";
    }
    // verb 02721284
    if sense == 6 {
        return "verb\thave a particular form\trun\tas the saying goes...";
    }
    // verb 02685951
    if sense == 7 {
        return "verb\tstretch out over a distance, space, time, or scope; run or extend between two points or beyond a certain point\trun, pass, lead, extend\tHis knowledge doesn't go very far";
