// go to — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_go_to(sense: i64) -> str {
    if sense == 0 { return "1"; }
    // verb 02612762
    if sense == 1 {
        return "verb\tbe present at (meetings, church services, university), etc.\tattend\tdid you go to the meeting?";
    }
    ""
}
