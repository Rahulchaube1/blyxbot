// grasp — WordNet 3.0. See licenses/WordNet-3.0.txt.
pub fn w_grasp(sense: i64) -> str {
    if sense == 0 { return "2"; }
    // verb 01216004
    if sense == 1 {
        return "verb\thold firmly\thold on\t";
    }
    // verb 00588221
    if sense == 2 {
        return "verb\tget the meaning of something\tgrok, get the picture, comprehend, savvy, dig, compass, apprehend\t";
    }
    ""
}
