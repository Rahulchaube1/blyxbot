pub fn lookup_c(term: str, sense: i64) -> str {
    if term <= "career" { return through_w_career(term, sense); }
    if term <= "certain" { return through_w_certain(term, sense); }
    if term <= "chicken" { return through_w_chicken(term, sense); }
    if term <= "clean" { return through_w_clean(term, sense); }
    if term <= "cold" { return through_w_cold(term, sense); }
    if term <= "command" { return through_w_command(term, sense); }
    if term <= "competition" { return through_w_competition(term, sense); }
    if term <= "concern" { return through_w_concern(term, sense); }
    if term <= "connect" { return through_w_connect(term, sense); }
    if term <= "continually" { return through_w_continually(term, sense); }
    if term <= "corner" { return through_w_corner(term, sense); }
    if term <= "create" { return through_w_create(term, sense); }
    through_w_cut(term, sense)
}

pub fn words_c() -> str {
    "c|calculate|call|call for|calm|camera|camp|campaign|candidate|capable|capacity|capital|captain|car|care|career|careful|carefully|carry|carry out|case|cast|catch|category|catholic|cattle|cause|cease|cell|center|century|certain|certainly|chain|chair|challenge|chance|change|chapter|character|characteristic|charge|check|cheek|chemical|chest|chicago|chicken|chief|child|chlorine|choice|choose|christ|christian|church|circle|circumstance|cite|citizen|city|claim|class|clean|clear|clearly|climb|close|closed|closely|clothes|cloud|club|clutch|cm|coach|coast|coat|coffee|cold|collapse|collect|college|colonel|color|colored|column|combat|combine|come|come in|come out|come to|come up|comedy|command|comment|commercial|commission|commit|common|communication|communism|communist|community|companion|company|compare|comparison|compel|compete|competition|complain|complement|complete|completely|complex|component|compose|composer|compute|comrade|concede|conceive|concentrate|concentration|concept|concern|concerned|conclude|conclusion|concrete|condemn|condition|conduct|confidence|confirm|conflict|confront|confusion|congregation|congress|conjugate|connect|connection|consciousness|consequence|consider|considerable|consideration|constant|constitute|construct|construction|consult|contact|contain|contemplate|content|continually|continue|continuous|contract|contrast|contribute|contribution|control|conversation|convert|conviction|cook|cool|cooperate|cop|copy|corner|corporation|corpse|correct|cost|count|country|county|couple|course|court|cover|cow|crack|crash|crawl|create|credit|crime|critical|cross|crowd|cry|cultural|culture|cup|cure|curious|current|curse|curve|customer|cut"
