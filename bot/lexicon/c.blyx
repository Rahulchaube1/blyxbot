fn through_w_career(term: str, sense: i64) -> str {
    if term == "c" { return w_c(sense); }
    if term == "calculate" { return w_calculate(sense); }
    if term == "call" { return w_call(sense); }
    if term == "call for" { return w_call_for(sense); }
    if term == "calm" { return w_calm(sense); }
    if term == "camera" { return w_camera(sense); }
    if term == "camp" { return w_camp(sense); }
    if term == "campaign" { return w_campaign(sense); }
    if term == "candidate" { return w_candidate(sense); }
    if term == "capable" { return w_capable(sense); }
    if term == "capacity" { return w_capacity(sense); }
    if term == "capital" { return w_capital(sense); }
    if term == "captain" { return w_captain(sense); }
    if term == "car" { return w_car(sense); }
    if term == "care" { return w_care(sense); }
    if term == "career" { return w_career(sense); }
    ""
}

