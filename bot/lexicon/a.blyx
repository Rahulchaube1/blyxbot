fn through_w_accord(term: str, sense: i64) -> str {
    if term == "a bit" { return w_a_bit(sense); }
    if term == "a couple of" { return w_a_couple_of(sense); }
    if term == "a few" { return w_a_few(sense); }
    if term == "a little" { return w_a_little(sense); }
    if term == "abandon" { return w_abandon(sense); }
    if term == "ability" { return w_ability(sense); }
    if term == "able" { return w_able(sense); }
    if term == "about" { return w_about(sense); }
    if term == "above" { return w_above(sense); }
    if term == "absence" { return w_absence(sense); }
    if term == "absorb" { return w_absorb(sense); }
    if term == "academic" { return w_academic(sense); }
    if term == "accept" { return w_accept(sense); }
    if term == "accompany" { return w_accompany(sense); }
    if term == "accomplish" { return w_accomplish(sense); }
    if term == "accord" { return w_accord(sense); }
    ""
}

