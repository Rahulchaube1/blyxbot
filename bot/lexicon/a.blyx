pub fn lookup_a(term: str, sense: i64) -> str {
    if term <= "accord" { return through_w_accord(term, sense); }
    if term <= "adequate" { return through_w_adequate(term, sense); }
    if term <= "agency" { return through_w_agency(term, sense); }
    if term <= "along" { return through_w_along(term, sense); }
    if term <= "another" { return through_w_another(term, sense); }
    if term <= "appoint" { return through_w_appoint(term, sense); }
    if term <= "arrange" { return through_w_arrange(term, sense); }
    if term <= "assign" { return through_w_assign(term, sense); }
    if term <= "attain" { return through_w_attain(term, sense); }
    through_w_away(term, sense)
}

